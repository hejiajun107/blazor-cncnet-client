<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
	<UseAppHost>true</UseAppHost>
</PropertyGroup>

	<ItemGroup>
		<Content Update="wwwroot/**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="InfiniLore.InfiniFrame" Version="0.60.0" />
	  <PackageReference Include="InfiniLore.InfiniFrame.Blazor" Version="0.60.0" />
	  <PackageReference Include="InfiniLore.InfiniFrame.BlazorWebView" Version="0.60.0" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="5.0.0" />
		<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CnCNetClient.Core\CnCNetClient.Core.csproj" />
		<ProjectReference Include="..\CnCNetClient.Tools\CnCNetClient.Tools.csproj" />
		<ProjectReference Include="..\CnCNetClient.Integration\CnCNetClient.Integration.csproj" />
		<ProjectReference Include="..\CnCNetClient.Domain\CnCNetClient.Domain.csproj" />
		<ProjectReference Include="..\CnCNetClient.Online\CnCNetClient.Online.csproj" />
		<ProjectReference Include="..\CnCNetClient.Updater\CnCNetClient.Updater.csproj" />
	</ItemGroup>
</Project>
