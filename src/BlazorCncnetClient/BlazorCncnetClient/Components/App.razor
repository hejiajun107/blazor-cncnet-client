@using System.Threading
@using BlazorCncnetClient.Components.Layouts
@using BlazorCncnetClient.Components.Pages
@using BlazorCncnetClient.Components.Shared
@inject InfiniFrameDispatcher Dispatcher
@inject GlobalExceptionHandler GlobalErrors
@inject GameLogCollector GameLogs
@inject PluginCatalog Plugins

@* F4 插件机制：AdditionalAssemblies 让插件程序集内的 @page 路由自动被发现
   （路由冲突在 PluginCatalog.DetectRouteConflicts 中告警）。 *@
<Router AppAssembly="@typeof(Program).Assembly"
        AdditionalAssemblies="@Plugins.PageAssemblies"
        NotFoundPage="@typeof(PageNotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
    </Found>
</Router>

@* 启动闪屏（M5 2.3 LoadingScreen）：内容取自 ClientDefinitions.ini [LoadingScreen]，
   可由插件轻量覆盖内容（SetLoadingScreenContent）或整体替换组件（ReplaceSlot "layout.splash"）。 *@
<ReplaceableComponent Key="layout.splash" />

@code {
    protected override void OnInitialized()
    {
        // 捕获 UI 线程同步上下文（Blazor 渲染线程），供 IDispatcher 调度回 UI。
        Dispatcher.Initialize(SynchronizationContext.Current ?? throw new InvalidOperationException(
            UiText.T("Startup.UiDispatcherMissing",
                "No SynchronizationContext found on the UI thread. InfiniFrameDispatcher requires it at startup.")));

        // 2.8 全局异常兜底：注入 DisplayErrorAction（MessageBox 呈现）并订阅进程级未处理异常。
        GlobalErrors.Subscribe();
    }
}
