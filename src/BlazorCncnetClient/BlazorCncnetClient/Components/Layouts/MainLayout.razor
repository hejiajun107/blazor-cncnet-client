@inherits LayoutComponentBase
@implements IDisposable
@using CnCNetClient.Core
@inject IJSRuntime JS
@inject IThemeProvider ThemeProvider
@inject NavigationManager Nav
@inject ConnectionMonitor Mon
@inject ReplaceableComponentService Replacer
@inject PluginAssetInjector PluginAssets
@inject ITranslationService TranslationSvc
@inject UiSoundService UiSound

<!-- HUD 顶栏（全局，TopBar 通用组件，spec §5.3；状态灯/文本由 ConnectionMonitor 驱动，M3.10）。
     主题切换已移至设置页（Settings.razor），此处仅保留版本/帧率读数 -->
<TopBar StatusClass="@Mon.StatusClass" StatusText="@Mon.StateText">
    <span class="hud-build">BUILD <b>0.3.0</b></span>
    <span class="hud-fps">FPS <b data-fps="1">—</b></span>
</TopBar>

<!-- 背景层（全局共享）：星粒 / 极光 / 网格 / 扫描线 / 暗角 -->
<canvas id="bg-canvas"></canvas>
<div class="aurora"></div>
<div class="grid"></div>
<div class="scan"></div>
<div class="vig"></div>

<div class="shell">
    <!-- 页面切换过渡：@key 随路由变化强制重放 fade-slide（动效 tokens，spec §5.5） -->
    <div class="page-anim" @key="Nav.Uri">
        @Body
    </div>
</div>

<!-- 全局游戏邀请条（第六轮补缺，原版 ChoiceNotificationBox 邀请场景；任意页面可弹） -->
<InvitationToast />

<!-- 底栏（全局；SYSTEM STATUS 反映连接状态，M3.10）——F2 可替换槽位 layout.footer（默认 FooterBar） -->
<ReplaceableComponent Key="layout.footer" />

<!-- Toast（全局） -->
<div class="toast" id="toast">@T("Layout.Toast", "Notice")</div>

<!-- 全局弹窗（spec §5.3 MessageBox，MessageBoxService 驱动） -->
<MessageBox />

<!-- 登录浮窗（M3.1 spec §5.3.1，LoginService 驱动） -->
<LoginModal />

<!-- 附加功能窗（M4.7 ExtrasWindow：地图编辑器/更新日志/鸣谢/关于，ExtrasService 驱动） -->
<ExtrasWindow />

@code {
    /// <summary>文案查表（Resx / 原版 Translation.ini），缺失时用英文原文兜底。</summary>
    private static string T(string key, string fallback) => UiText.T(key, fallback);

    /// <summary>带参数的文案（占位符 {0}…）。</summary>
    private static string F(string key, string fallback, params object[] args)
        => string.Format(UiText.T(key, fallback), args);

    protected override void OnInitialized()
    {
        // 主题切换后刷新切换控件高亮态
        ThemeProvider.ThemeChanged += OnThemeChanged;
        // 连接状态（M3.10 D2.7）：状态灯/底栏刷新 + 断线/重连 Toast
        Mon.StateChanged += OnMonStateChanged;
        Mon.Notification += OnMonNotification;
        TranslationSvc.LanguageChanged += OnLanguageChanged;
        // 主菜单音乐跟随路由：离开游戏房间恢复，进入游戏房间按 StopMusicOnMenu 停止
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 主题系统：加载持久化主题并应用（M2.5）
            await ThemeProvider.InitializeAsync();
            // 主菜单音乐（原版 [General] MainMenuTheme，贯穿客户端各页面播放）
            await SyncMenuMusicAsync();
            // 界面音效（原版 XNAUI 按钮/复选框/下拉框 + 房间/大厅事件音效）
            try
            {
                await UiSound.InitializeAsync();
            }
            catch
            {
                // WebView 未就绪时音效初始化失败不影响页面渲染
            }
            // F4 插件资源（style/script）：首帧注入 WebView（幂等）
            await PluginAssets.InjectAllAsync();
            // 星粒背景动效（尊重 prefers-reduced-motion，内部处理）
            await JS.InvokeVoidAsync("cncnet.initStars", "bg-canvas");
        }
    }

    private void OnThemeChanged(ThemeInfo theme) => InvokeAsync(() =>
    {
        // 主题换肤同时换主菜单音乐（各主题目录可有各自的 [General] MainMenuTheme）
        _ = SyncMenuMusicAsync();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(
        () => _ = SyncMenuMusicAsync());

    /// <summary>
    /// 主菜单音乐同步（原版 PlayMainMenuMusic / StopMusicOnMenu 语义）：
    /// 音乐贯穿客户端各页面（主菜单、设置、统计等）循环播放，仅在游戏房间
    /// （/online/game、/lan/game）且 StopMusicOnMenu 开启时停止。
    /// 已关闭主菜单音乐或主题未配置音频时不播放。
    /// </summary>
    private async Task SyncMenuMusicAsync()
    {
        try
        {
            if (!UserINISettings.Instance.PlayMainMenuMusic.Value
                || (IsGameRoomRoute() && UserINISettings.Instance.StopMusicOnMenu.Value))
            {
                await JS.InvokeVoidAsync("cncnet.stopMenuMusic", 300);
                return;
            }

            string? url = ThemeProvider.Current.MusicUrl;
            if (string.IsNullOrEmpty(url))
                return;

            double volume = UserINISettings.Instance.SoundVolume.Value;
            await JS.InvokeVoidAsync("cncnet.playMenuMusic", url, Math.Clamp(volume, 0.0, 1.0));
        }
        catch
        {
            // 布局初始化的 JS 调用失败（如 WebView 未就绪）不阻塞页面渲染
        }
    }

    /// <summary>当前路由是否处于游戏房间（联机房间 / LAN 房间 / 遭遇战设置）。</summary>
    private bool IsGameRoomRoute()
    {
        string path = Nav.Uri;
        int cut = path.IndexOfAny(['?', '#']);
        if (cut >= 0)
            path = path[..cut];
        return path.EndsWith("/online/game", StringComparison.OrdinalIgnoreCase)
            || path.EndsWith("/lan/game", StringComparison.OrdinalIgnoreCase)
            || path.EndsWith("/skirmish", StringComparison.OrdinalIgnoreCase);
    }

    private void OnMonStateChanged() => InvokeAsync(StateHasChanged);

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void OnMonNotification(ConnectionNotification notification)
    {
        // 断线原因（ConnectionLost）并入 Toast，便于定位
        var (text, kind) = notification.Kind switch
        {
            ConnectionNotificationKind.Connected => (T("Layout.Connected", "Connected to CnCNet"), ""),
            ConnectionNotificationKind.Reconnected => (T("Layout.Reconnected", "Reconnected to CnCNet"), ""),
            ConnectionNotificationKind.Disconnected => (T("Layout.Disconnected", "Disconnected from CnCNet"), "err"),
            ConnectionNotificationKind.ConnectionLost =>
                (F("Layout.ConnectionLost", "Connection lost, reconnecting… ({0})", notification.Message), "err"),
            ConnectionNotificationKind.Failed => (T("Layout.Failed", "Failed to connect to CnCNet"), "warn"),
            _ => ("", "")
        };
        if (text.Length > 0)
            _ = JS.InvokeVoidAsync("cncnet.toast", text, kind);
    }

    public void Dispose()
    {
        ThemeProvider.ThemeChanged -= OnThemeChanged;
        Mon.StateChanged -= OnMonStateChanged;
        Mon.Notification -= OnMonNotification;
        TranslationSvc.LanguageChanged -= OnLanguageChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
