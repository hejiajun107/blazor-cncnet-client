@page "/campaign"
@implements IDisposable
@using CnCNetClient.Core
@using CnCNetClient.Domain
@inject CampaignService Svc
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IThemeProvider ThemeProvider
@inject MessageBoxService MessageBox
@inject CampaignLaunchService GameLauncher
@inject DiscordPresenceService Discord
@inject ITranslationService TranslationSvc

@if (!Svc.IsActive)
{
    <div class="game-empty page-anim">
        <div class="ge-box pop-in">
            <div class="ge-title">CAMPAIGN</div>
            <div class="ge-sub">@T("Campaign.Loading", "Loading campaign missions…")</div>
            <button class="mb-btn primary" @onclick="BackToMenu">@T("Common.BackToMenu", "Back to main menu")</button>
        </div>
    </div>
}
else
{
    <div class="groom page-anim">
        <header class="groom-top item-in">
            <div class="gt-left">
                <span class="gt-badge host">@T("MainMenu.campaign", "Campaign")<span class="en">CAMPAIGN</span></span>
                <div class="gt-tbox">
                    <span class="gt-title">@T("Campaign.SelectMission", "Mission selection")</span>
                    <span class="gt-en">@F("Campaign.HeaderMeta", "SINGLEPLAYER · {0} missions · Difficulty {1}", Svc.Missions.Count, CampaignService.GetDifficultyName(Svc.Difficulty))</span>
                </div>
            </div>
            <div class="gt-right">
                <span class="gt-player">@ProgramConstants.PLAYERNAME</span>
                <button class="mb-btn" @onclick="BackToMenu">@T("Common.BackToMenu", "Back to main menu")</button>
            </div>
        </header>

        <div class="groom-grid camp-grid">
            <!-- 左列：任务列表（参考原版 lbCampaignList：header 不可选，任务可选，EMPTY 空行） -->
            <section class="gl-panel camp-list item-in" style="animation-delay:50ms">
                <header class="gl-ph">
                    <span>@T("Campaign.MissionList", "Mission list") <em>MISSIONS</em></span>
                </header>
                @if (Svc.TagSelectorEnabled)
                {
                    <!-- r9-2：标签筛选（原版 CampaignTagSelector：单选标签过滤；「全部」清除筛选） -->
                    <div class="camp-tags">
                        <button type="button" class="ct-btn @(Svc.ActiveTag is null ? "on" : "")"
                                @onclick="() => Svc.SetTagFilter(null)">@T("Campaign.AllTags", "All")</button>
                        @foreach (var t in Svc.AvailableTags)
                        {
                            <button type="button" class="ct-btn @(string.Equals(Svc.ActiveTag, t, StringComparison.OrdinalIgnoreCase) ? "on" : "")"
                                    @onclick="() => Svc.SetTagFilter(t)">@t</button>
                        }
                    </div>
                }
                <div class="gl-body">
                    @if (Svc.Missions.Count == 0)
                    {
                        <div class="camp-empty">@T("Campaign.NoMissions", "No missions found (Battle.ini / BattleFS.ini missing)")</div>
                    }
                    else
                    {
                        @foreach (var m in Svc.Missions)
                        {
                            @if (string.IsNullOrEmpty(m.Scenario))
                            {
                                <div class="camp-item header">@m.GUIName</div>
                            }
                            else
                            {
                                <button type="button"
                                        class="camp-item @(m == Svc.SelectedMission ? "on" : "")"
                                        disabled="@(!m.Enabled)"
                                        @onclick="() => Svc.SelectMission(m)">
                                    <span class="ci-chip" style="background:@SideColor(m.Side)"></span>
                                    <span class="ci-txt">@m.GUIName</span>
                                    @if (m.RequiredAddon)
                                    {
                                        <span class="ci-tag">FS</span>
                                    }
                                </button>
                            }
                        }
                    }
                </div>
            </section>

            <!-- 右上：任务描述（参考原版 tbMissionDescription） -->
            <section class="gl-panel camp-desc item-in" style="animation-delay:100ms">
                <header class="gl-ph">
                    <span>@T("Campaign.MissionDescription", "Mission description") <em>MISSION DESCRIPTION</em></span>
                </header>
                <div class="gl-body camp-desc-body">
                    @if (Selected is null)
                    {
                        <div class="camp-empty">@T("Campaign.SelectHint", "Select a mission on the left to view its description")</div>
                    }
                    else
                    {
                        <div class="cd-title">@Selected.GUIName</div>
                        <div class="cd-meta">
                            <span class="cm-chip" style="background:@SideColor(Selected.Side)">@SideName(Selected)</span>
                            @if (Selected.RequiredAddon)
                            {
                                <span class="ci-tag">@T("Campaign.FirestormAddon", "Firestorm expansion")</span>
                            }
                            @if (Selected.IsCustomMission)
                            {
                                <span class="ci-tag">@T("Campaign.CustomMission", "Custom mission")</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(Selected.GUIDescription))
                        {
                            <div class="cd-desc">@Selected.GUIDescription</div>
                        }
                    }
                </div>
            </section>

            <!-- 右下：难度 + 启动（参考原版 trbDifficultySelector / btnLaunch / btnCancel） -->
            <section class="gl-panel camp-launch item-in" style="animation-delay:150ms">
                <header class="gl-ph">
                    <span>@T("Campaign.Difficulty", "Difficulty") <em>DIFFICULTY LEVEL</em></span>
                </header>
                <div class="gl-body">
                    <div class="diff-seg">
                        @for (int d = CampaignService.MinDifficulty; d <= CampaignService.MaxDifficulty; d++)
                        {
                            <button type="button" class="diff-btn @(Svc.Difficulty == d ? "on" : "")"
                                    @onclick="() => Svc.SetDifficulty(d)">
                                @CampaignService.GetDifficultyName(d)
                            </button>
                        }
                    </div>
                    <div class="diff-hint">
                        <span>@T("Campaign.PlayerDifficulty", "Player difficulty") <b>@CampaignService.GetDifficultyName(Svc.Difficulty)</b></span>
                        <span>@T("Campaign.ComputerDifficulty", "Computer difficulty") <b>@CampaignService.GetDifficultyName(CampaignService.GetComputerDifficulty(Svc.Difficulty))</b></span>
                    </div>
                    <div class="cfg-actions">
                        <button class="mb-btn danger" @onclick="BackToMenu">@T("Lobby.Cancel", "Cancel")<span class="en">CANCEL</span></button>
                        <button class="mb-btn primary start-btn" disabled="@(!CanLaunch)" @onclick="OnStartGame">
                            @T("Campaign.Launch", "Launch mission")<span class="en">LAUNCH</span>
                        </button>
                    </div>
                </div>
            </section>
        </div>
    </div>
}

@code {
    /// <summary>文案查表（Resx / 原版 Translation.ini），缺失时用英文原文兜底。</summary>
    private static string T(string key, string fallback) => UiText.T(key, fallback);

    /// <summary>带参数的文案（占位符 {0}…）。</summary>
    private static string F(string key, string fallback, params object[] args)
        => string.Format(UiText.T(key, fallback), args);

    private Mission? Selected => Svc.SelectedMission;

    /// <summary>启动按钮可用性：已选任务且配置了地图且未禁用（原版 btnLaunch.AllowClick 条件）。</summary>
    private bool CanLaunch =>
        Selected is not null
        && !string.IsNullOrEmpty(Selected.Scenario)
        && Selected.Enabled;

    protected override void OnInitialized()
    {
        Svc.Changed += OnChanged;
        ThemeProvider.ThemeChanged += OnThemeChanged;
        Svc.CheaterDetected += OnCheaterDetected;
        TranslationSvc.LanguageChanged += OnLanguageChanged;
        Svc.Initialize();
    }

    private void OnChanged()
    {
        // r9-4：Discord 呈现同步（原版 CampaignSelector 在选择任务/难度时推送）
        if (Selected is not null)
        {
            Discord.Campaign(
                mission: Selected.GUIName,
                difficulty: CampaignService.GetDifficultyName(Svc.Difficulty),
                side: "GDI"
            );
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged(ThemeInfo theme) => _ = InvokeAsync(StateHasChanged);

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>作弊检测命中：弹窗确认后放行启动（原版 CheaterWindow.YesClicked 语义）。</summary>
    private void OnCheaterDetected(Mission mission)
    {
        _ = InvokeAsync(async () =>
        {
            var confirm = await MessageBox.ShowAsync(T("Campaign.CheaterTitle", "File modification detected"),
                F("Campaign.CheaterBody", "Modified game files were detected (possible cheating or corrupted files).\n\nContinue launching this mission?\n{0}", mission.GUIName),
                MessageBoxButtons.YesNo, MessageBoxKind.Warn);
            if (!confirm)
                return;
            try
            {
                Svc.StartGame(ignoreCheater: true);
            }
            catch (Exception ex)
            {
                _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
            }
        });
    }

    private async Task OnStartGame()
    {
        try
        {
            Svc.StartGame();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
    }

    private async Task BackToMenu()
    {
        var confirm = await MessageBox.ShowAsync(T("Common.BackToMenu", "Back to main menu"),
            T("Campaign.LeaveBody", "Returning will discard the current unstarted campaign setup. Return?"),
            MessageBoxButtons.YesNo, MessageBoxKind.Confirm);
        if (!confirm)
            return;
        Nav.NavigateTo("/menu");
    }

    // ── 工具 ──

    /// <summary>阵营显示名：优先任务配置的 SideName（如 GDI / Nod），否则回退全局阵营表。</summary>
    private static string SideName(Mission m)
    {
        if (!string.IsNullOrEmpty(m.IconPath))
            return m.IconPath;
        var sides = ClientConfiguration.Instance.Sides.Split(',', StringSplitOptions.RemoveEmptyEntries);
        return m.Side >= 0 && m.Side < sides.Length ? sides[m.Side] : $"Side {m.Side}";
    }

    /// <summary>阵营标识色（TS 四阵营色板；未知阵营回退青色）。</summary>
    private static string SideColor(int side) => side switch
    {
        0 => "rgb(80,190,255)",  // GDI 蓝青
        1 => "rgb(255,95,80)",   // Nod 红
        2 => "rgb(120,220,120)", // Allies 绿
        3 => "rgb(255,200,80)",  // Soviet 黄
        _ => "rgb(160,220,255)"
    };

    public void Dispose()
    {
        Svc.Changed -= OnChanged;
        ThemeProvider.ThemeChanged -= OnThemeChanged;
        Svc.CheaterDetected -= OnCheaterDetected;
        TranslationSvc.LanguageChanged -= OnLanguageChanged;
    }
}
