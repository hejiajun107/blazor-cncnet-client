@page "/campaign/loading"
@implements IDisposable
@using System.Threading
@using CnCNetClient.Core
@using CnCNetClient.Domain
@inject CampaignService Svc
@inject NavigationManager Nav
@inject MessageBoxService MessageBox
@inject ITranslationService TranslationSvc

@if (!Svc.IsActive)
{
    <div class="game-empty page-anim">
        <div class="ge-box pop-in">
            <div class="ge-title">CAMPAIGN LOADING</div>
            <div class="ge-sub">@T("Loading.NoActiveCampaign", "No campaign in progress")</div>
            <button class="mb-btn primary" @onclick="BackToCampaign">@T("Loading.BackToCampaign", "Back to Campaign")</button>
        </div>
    </div>
}
else
{
    <div class="gload page-anim">
        <div class="gload-center pop-in">
            <!-- 雷达式加载环（与在线/局域网/遭遇战加载页同款） -->
            <div class="gload-radar">
                <div class="radar-ring r1"></div>
                <div class="radar-ring r2"></div>
                <div class="radar-ring r3"></div>
                <div class="radar-sweep"></div>
                <div class="radar-core">
                    <span class="rc-en">CAMPAIGN</span>
                    <span class="rc-cn">@T("Loading.RadarCampaign", "Campaign")</span>
                </div>
            </div>

            <div class="gload-title">CAMPAIGN LOADING</div>
            <div class="gload-sub">@T("Loading.SubCampaign", "Campaign loading · Please wait")</div>

            <div class="gload-info">
                <div class="gi-row"><span>@T("Loading.Mission", "Mission")</span><b>@(Svc.SelectedMission?.GUIName ?? "—")</b></div>
                <div class="gi-row"><span>@T("Loading.Difficulty", "Difficulty")</span><b>@CampaignService.GetDifficultyName(Svc.Difficulty)</b></div>
                <div class="gi-row"><span>@T("Skirmish.Side", "Side")</span><b>@(SideName)</b></div>
            </div>

            <div class="gload-status">
                <span class="gs-dot"></span>
                @T("Loading.ProcessStarted", "Game process started, window minimized · ")@T("Loading.ReturnCampaign", "You will return to the Campaign page after the mission (running ")<b>@ElapsedSeconds</b>@T("Loading.SecondsSuffix", "s)")
            </div>

            <div class="gload-actions">
                <button class="mb-btn" @onclick="BackToCampaign">@T("Loading.BackToCampaign", "Back to Campaign")</button>
            </div>
        </div>
    </div>
}

@code {
    private Timer? _timer;
    private int _elapsedSeconds;

    private int ElapsedSeconds => _elapsedSeconds;

    private static string T(string key, string fallback) => UiText.T(key, fallback);

    private string SideName
    {
        get
        {
            var m = Svc.SelectedMission;
            if (m is null)
                return "—";
            if (!string.IsNullOrEmpty(m.IconPath))
                return m.IconPath;
            var sides = ClientConfiguration.Instance.Sides.Split(',', StringSplitOptions.RemoveEmptyEntries);
            return m.Side >= 0 && m.Side < sides.Length ? sides[m.Side] : $"Side {m.Side}";
        }
    }

    protected override void OnInitialized()
    {
        // 任务进行中计时显示；每秒刷新一次
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            _elapsedSeconds++;
            StateHasChanged();
        }), null, 1000, 1000);

        TranslationSvc.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task BackToCampaign()
    {
        var confirm = await MessageBox.ShowAsync(T("Loading.BackToCampaign", "Back to Campaign"),
            T("Loading.LeaveCampaignBody", "A mission is still in progress. Returning will interrupt the current flow. Continue?"),
            MessageBoxButtons.YesNo, MessageBoxKind.Confirm);
        if (!confirm)
            return;
        Nav.NavigateTo("/campaign");
    }

    public void Dispose()
    {
        TranslationSvc.LanguageChanged -= OnLanguageChanged;
        _timer?.Dispose();
        _timer = null;
    }
}
