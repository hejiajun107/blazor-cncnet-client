    private bool IsSelfSpectator => IsSpectatorSide(Self.Side);

    /// <summary>指定阵营索引是否为观战（索引 == 真实阵营数量，同 Room.SpectatorSideIndex）。</summary>
    private bool IsSpectatorSide(int side) => GameRoomService.IsSpectatorSide(side, Room.SideCount);

