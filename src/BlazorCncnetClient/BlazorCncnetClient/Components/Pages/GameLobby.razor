                <button type="button" class="ctx-item warn" @onclick="OnRoomBan">
                    封禁<span class="en">BAN</span></button>
            }
        </div>
    }

    <!-- 隧道选择窗口（原版 TunnelSelectionWindow：名称/负载/延迟列表，点击即选） -->
    @if (_tunnelOpen)
    {
        <div class="ctx-backdrop" @onclick="CloseTunnelDialog"></div>
        <div class="cr-panel tunnel-panel pop-in">
            <div class="cr-head">
                <span>选择隧道服务器</span>
                <span class="cr-en">SELECT TUNNEL</span>
                <button type="button" class="gop-close" @onclick="CloseTunnelDialog" title="关闭">✕</button>
            </div>
            <div class="tunnel-list">
                @for (int i = 0; i < Room.Tunnels.Count; i++)
                {
                    var t = Room.Tunnels[i];
                    var sel = Room.CurrentTunnel is not null
                        && string.Equals(t.Address, Room.CurrentTunnel.Address, StringComparison.OrdinalIgnoreCase)
                        && t.Port == Room.CurrentTunnel.Port;
                    <button type="button" class="tunnel-item @(sel ? "sel" : "")" @onclick="() => OnTunnelPick(t)">
                        <span class="t-flag">@t.CountryCode</span>
                        <span class="t-name">@(t.Official ? "◈ " : t.Recommended ? "◇ " : "")@t.Name</span>
                        <span class="t-meta">@t.Clients/@t.MaxClients</span>
                        <span class="t-ping">@(t.PingInMs > -1 ? t.PingInMs + "ms" : "—")</span>
                    </button>
                }
                @if (Room.Tunnels.Count == 0)
                {
                    <div class="tunnel-empty">隧道列表加载中，请稍候…</div>
                }
            </div>
            <div class="cr-actions">
                <button type="button" class="mb-btn primary" @onclick="CloseTunnelDialog">
                    确定<span class="en">OK</span>
                </button>
            </div>
        </div>
    }

    <!-- 邀请玩家对话框（第六轮补缺：房主/成员邀请大厅在线玩家加入本局，原版 GlobalContextMenu「Invite」） -->
    @if (_inviteOpen)
    {
        <div class="ctx-backdrop" @onclick="CloseInviteDialog"></div>
        <div class="cr-panel invite-panel pop-in">
            <div class="cr-head">
                <span>邀请玩家加入游戏</span>
                <span class="cr-en">INVITE PLAYER</span>
                <button type="button" class="gop-close" @onclick="CloseInviteDialog" title="关闭">✕</button>
            </div>
            <div class="invite-list">
                @foreach (var u in InviteCandidates)
                {
                    <button type="button" class="invite-item" @onclick="() => OnInviteUser(u)">
                        <span class="i-name">@u.Name</span>
                        <span class="i-go">邀请 ›</span>
                    </button>
                }
                @if (InviteCandidates.Count() == 0)
                {
                    <div class="invite-empty">没有可邀请的在线玩家（已排除房间内成员与你自己）。</div>
                }
            </div>
            <div class="cr-actions">
                <button type="button" class="mb-btn primary" @onclick="CloseInviteDialog">
                    关闭<span class="en">CLOSE</span>
                </button>
            </div>
        </div>
    }

    <!-- 游戏选项预设对话框（原版 LoadOrSaveGameOptionPresetWindow；仅房主可存/取） -->
    <GameOptionPresetDialog Options="Room.GameOptions"
                            Visible="@_presetOpen"
                            OnClose="ClosePresetDialog"
                            OnPresetApplied="OnPresetApplied" />
}

@code {
    private const int MAX_VISIBLE_MESSAGES = 300;

