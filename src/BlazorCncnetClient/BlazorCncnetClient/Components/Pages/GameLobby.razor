@page "/online/game"
@implements IDisposable
@using CnCNetClient.Core
@using CnCNetClient.Online
@using CnCNetClient.Domain.Multiplayer
@using CnCNetClient.Domain.Multiplayer.CnCNet
@using SixLabors.ImageSharp.PixelFormats
@inject GameRoomService Room
@inject GameRoomNavigation NavData
@inject MapLoader MapLoader
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IThemeProvider ThemeProvider
@inject MessageBoxService MessageBox
@inject GameLaunchService GameLauncher
@inject LobbyService LobbySvc
@inject DiscordPresenceService Discord

@if (!Room.IsInGameRoom)
{
    <div class="game-empty page-anim">
        <div class="ge-box pop-in">
            <div class="ge-title">GAME ROOM</div>
            <div class="ge-sub">尚未进入任何游戏房间</div>
            <button class="mb-btn primary" @onclick="BackToLobby">返回大厅</button>
        </div>
    </div>
}
else
{
    <div class="groom page-anim">
        <header class="groom-top item-in">
            <div class="gt-left">
                <span class="gt-badge @(Room.IsHost ? "host" : "")">@(Room.IsHost ? "房主" : "加入")<span class="en">@(Room.IsHost ? "HOST" : "JOIN")</span></span>
                <div class="gt-tbox">
                    <span class="gt-title">@Room.RoomName</span>
                    <span class="gt-en">@(Room.GameChannel?.ChannelName ?? "—") · @(Room.IsCustomPassword ? "密码房" : "公开房")</span>
                </div>
            </div>
            <div class="gt-right">
                <span class="gt-player">@ProgramConstants.PLAYERNAME</span>
                <button type="button" class="mb-btn" @onclick="OpenInviteDialog">邀请玩家<span class="en">INVITE</span></button>
                <button class="mb-btn danger" @onclick="OnLeave">离开房间</button>
            </div>
        </header>

        @if (Room.IsJoined && Room.IsHost)
        {
            <!-- 隧道工具条（原版 btnChangeTunnel：房主手动选择隧道服务器） -->
            <div class="tunnel-bar item-in">
                <span class="tb-label">隧道 <em>TUNNEL</em></span>
                <span class="tb-value">
                    @if (Room.CurrentTunnel is not null)
                    {
                        <b>@Room.CurrentTunnel.Name</b>
                        <em>@Room.CurrentTunnel.CountryCode · @Room.CurrentTunnel.Clients/@Room.CurrentTunnel.MaxClients · @(Room.CurrentTunnel.PingInMs > -1 ? Room.CurrentTunnel.PingInMs + "ms" : "—")</em>
                    }
                    else
                    {
                        <b class="dim">自动选择中…</b>
                    }
                </span>
                <button type="button" class="mb-btn" @onclick="OpenTunnelDialog">
                    更换隧道<span class="en">CHANGE</span>
                </button>
            </div>
        }
        @if (Room.IsJoined && Room.TunnelErrorMode)
        {
            <div class="groom-warn item-in">⚠ 房主选择了无效的隧道服务器，本局游戏无法进行</div>
        }

        @if (!Room.IsJoined)
        {
            <div class="groom-joining">
                <div class="gj-spinner"></div>
                <span>正在加入房间频道…</span>
            </div>
        }
        else
        {
            <div class="groom-grid">
                <section class="gl-panel gl-slots item-in" style="animation-delay:50ms">
                    <header class="gl-ph">
                        <span>玩家 <em>@Room.Players.Count/@Room.MaxPlayers</em></span>
                        <span class="gl-lock" title="房间锁定状态">
                            @(Room.Locked ? "◉ 已锁定" : "○ 公开")
                        </span>
                    </header>
                    <div class="gl-body">
                        @for (int i = 0; i < GameRoomService.MaxTotalSlots; i++)
                        {
                            var slotPlayer = i < Room.Players.Count ? Room.Players.ElementAt(i) : null;
                            var aiPlayer = slotPlayer is null && i - Room.Players.Count < Room.AIPlayers.Count
                                ? Room.AIPlayers[i - Room.Players.Count] : null;
                            var empty = slotPlayer is null && aiPlayer is null && i < Room.MaxPlayers;
                            var unavailable = slotPlayer is null && aiPlayer is null && !empty;
                            <div class="slot @(slotPlayer is not null ? (slotPlayer.IsSelf ? "self" : "") : aiPlayer is not null ? "ai" : unavailable ? "empty unavailable" : "empty")"
                                 @oncontextmenu="slotPlayer is not null ? (e => OpenPlayerMenu(slotPlayer, e)) : null"
                                 @oncontextmenu:preventDefault="true"
                                 title="@(slotPlayer is not null ? "右键打开玩家菜单" : null)">
                                <span class="slot-idx">@(i + 1)</span>
                                @if (slotPlayer is not null)
                                {
                                    <span class="slot-color" style="background:@ToCss(GetColor(slotPlayer.Color))"></span>
                                    <div class="slot-info">
                                        <span class="slot-name">
                                            @slotPlayer.Name
                                            @if (slotPlayer.IsHost)
                                            {
                                                <em class="slot-host">HOST</em>
                                            }
                                            @if (IsSpectatorSide(slotPlayer.Side))
                                            {
                                                <em class="slot-spec">SPECTATOR</em>
                                            }
                                        </span>
                                        <span class="slot-meta">
                                            @GetSideName(slotPlayer.Side)@(IsSpectatorSide(slotPlayer.Side) ? "" : " · 出生" + slotPlayer.Start)@(slotPlayer.Team > 0 ? " · 队" + slotPlayer.Team : "")
                                        </span>
                                    </div>
                                    <span class="slot-ready @(slotPlayer.Ready ? "on" : "")">@(slotPlayer.Ready ? "READY" : "…")</span>
                                }
                                else if (aiPlayer is not null)
                                {
                                    <span class="slot-color ai-color" style="background:@ToCss(GetColor(aiPlayer.ColorId))"></span>
                                    @if (Room.IsHost)
                                    {
                                        <div class="slot-info ai-editor">
                                            <span class="slot-name">
                                                @aiPlayer.Name
                                                <em class="slot-ai">AI</em>
                                            </span>
                                            <div class="ai-cfg-row">
                                                <select class="gl-select ai-select" title="AI 难度"
                                                        value="@aiPlayer.AILevel" @onchange="(e) => OnAILevelChange(aiPlayer, e)">
                                                    @for (int l = 0; l < AiLevels.Length; l++)
                                                    {
                                                        <option value="@l">@AiLevels[l]</option>
                                                    }
                                                </select>
                                                <select class="gl-select ai-select" title="AI 阵营"
                                                        value="@aiPlayer.SideId" @onchange="(e) => OnAISideChange(aiPlayer, e)">
                                                    @for (int s = 0; s < Sides.Length; s++)
                                                    {
                                                        <option value="@s">@Sides[s]</option>
                                                    }
                                                </select>
                                                <select class="gl-select ai-select" title="AI 出生点"
                                                        value="@aiPlayer.StartingLocation"
                                                        disabled="@Room.StartLocationSelectionDisabled"
                                                        @onchange="(e) => OnAIStartChange(aiPlayer, e)">
                                                    @for (int st = 0; st <= GameRoomService.MaxTotalSlots; st++)
                                                    {
                                                        <option value="@st">@(st == 0 ? "随机" : st.ToString())</option>
                                                    }
                                                </select>
                                                <select class="gl-select ai-select" title="AI 队伍"
                                                        value="@aiPlayer.TeamId" @onchange="(e) => OnAITeamChange(aiPlayer, e)">
                                                    @for (int t = 0; t <= 4; t++)
                                                    {
                                                        <option value="@t">@(t == 0 ? "无" : t.ToString())</option>
                                                    }
                                                </select>
                                                <button type="button" class="ai-remove" title="移除 AI" @onclick="() => OnAIRemove(aiPlayer)">✕</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="slot-info">
                                            <span class="slot-name">
                                                @aiPlayer.Name
                                                <em class="slot-ai">AI</em>
                                            </span>
                                            <span class="slot-meta">
                                                @GetSideName(aiPlayer.SideId) · 出生@(aiPlayer.StartingLocation)@(aiPlayer.TeamId > 0 ? " · 队" + aiPlayer.TeamId : "")
                                            </span>
                                        </div>
                                    }
                                }
                                else if (unavailable)
                                {
                                    <span class="slot-empty-text unavailable">超出人数上限</span>
                                }
                                else
                                {
                                    @if (Room.IsHost)
                                    {
                                        <span class="slot-empty-text">等待玩家加入…</span>
                                        <button type="button" class="ai-add" @onclick="OnAIAdd">＋ AI</button>
                                    }
                                    else
                                    {
                                        <span class="slot-empty-text">等待玩家加入…</span>
                                    }
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="gl-panel gl-config item-in" style="animation-delay:100ms">
                    <header class="gl-ph">
                        <span>地图与规则 <em>MAP & RULES</em></span>
                    </header>
                    <div class="gl-body">
                        <div class="cfg-map">
                            <div class="cfg-map-preview">
                                <MapThumbnail MapHash="Room.SelectedMap?.Map.SHA1" MapName="Room.SelectedMap?.Map.UntranslatedName" CssClass="cfg-thumb" />
                                @if (Room.SelectedMap is null)
                                {
                                    <div class="cfg-map-none">@(Room.IsHost ? "请选择地图" : "等待主机选择地图…")</div>
                                }
                                else
                                {
                                    <div class="spawn-layer">
                                        @foreach (var sp in SpawnPoints)
                                        {
                                            var spStyle = $"left:{sp.X * 100:0.##}%;top:{sp.Y * 100:0.##}%";
                                            var spCls = sp.IsSelf ? "self" : sp.OccupantName is null ? "free" : "taken";
                                            <button type="button"
                                                    class="spawn-dot @spCls"
                                                    style="@spStyle"
                                                    title="@(sp.OccupantName is null ? $"出生点 {sp.Index}" : $"出生点 {sp.Index} · {sp.OccupantName}")"
                                                    disabled="@Room.StartLocationSelectionDisabled"
                                                    @onclick="() => OnSpawnClick(sp.Index)">
                                                <span class="spawn-num">@sp.Index</span>
                                                @if (sp.OccupantName is not null)
                                                {
                                                    <span class="spawn-owner" style="background:@ToCss(GetColor(sp.ColorIndex))"></span>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            @if (Room.IsHost)
                            {
                                <select class="gl-select" value="@SelectedMapIndex" @onchange="OnMapChange">
                                    <option value="-1">— 选择地图 —</option>
                                    @foreach (var group in MapGroups)
                                    {
                                        <optgroup label="@group.Key">
                                            @for (int i = 0; i < group.Items.Count; i++)
                                            {
                                                var opt = group.Items[i];
                                                <option value="@opt.Index">@(opt.Value.IsFavorite ? "★ " : "")@opt.Display</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <!-- 地图工具条（原版 tbMapSearch / btnShowFavoriteMaps / btnMapSortAlphabetically / btnPickRandomMap） -->
                                <div class="map-tools">
                                    <input class="gl-input map-search" placeholder="搜索地图…" value="@_mapSearch" @oninput="OnMapSearchInput" />
                                    <button type="button" class="mt-btn @(_favOnly ? "on" : "")" title="仅显示收藏地图" @onclick="OnToggleFavOnly">
                                        ★<span class="en">FAV</span>
                                    </button>
                                    <button type="button" class="mt-btn @(_sortMode != 0 ? "on" : "")" title="按名称排序" @onclick="OnCycleSort">
                                        <span class="en">@SortModeLabel</span>
                                    </button>
                                    <button type="button" class="mt-btn" title="随机选择地图" @onclick="OnPickRandomMap">
                                        <span class="en">RND</span>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="cfg-map-name">@(Room.SelectedMap is not null ? Room.SelectedMap.ToUIString() : "—")</div>
                            }

                            <div class="map-info">
                                <div class="mi-row"><span>游戏</span><b>@LocalGameName</b></div>
                                <div class="mi-row"><span>版本</span><b>@ProgramConstants.GAME_VERSION</b></div>
                                <div class="mi-row"><span>房主</span><b>@Room.HostName</b></div>
                                <div class="mi-row"><span>人数</span><b>@Room.Players.Count / @Room.MaxPlayers</b></div>
                                <div class="mi-row"><span>技能</span><b>@SkillLevelName</b></div>
                                @if (Room.SelectedMap is not null)
                                {
                                    <div class="mi-divider"></div>
                                    <div class="mi-row"><span>地图</span><b>@Room.SelectedMap.Map.Name</b></div>
                                    <div class="mi-row"><span>作者</span><b>@Room.SelectedMap.Map.Author</b></div>
                                    <div class="mi-row"><span>尺寸</span><b>@Room.SelectedMap.Map.GetSizeString()</b></div>
                                    <div class="mi-row"><span>模式</span><b>@Room.SelectedMap.GameMode.UIName</b></div>
                                    @if (!string.IsNullOrEmpty(Room.SelectedMap.Map.Briefing))
                                    {
                                        <div class="mi-briefing">@Room.SelectedMap.Map.Briefing</div>
                                    }
                                }
                            </div>
                        </div>

                        @if (!Room.IsHost && Room.MissingMapSHA1 is not null)
                        {
                            <div class="map-dl md-@DownloadStateCss">
                                <div class="md-title">
                                    主机选择了本机未安装的地图
                                    <em>@Room.MissingMapName</em>
                                </div>
                                <div class="md-sub">@DownloadStateText</div>
                                @if (Room.DownloadState == MapDownloadState.Prompt ||
                                    Room.DownloadState == MapDownloadState.Failed)
                                {
                                    <button class="mb-btn primary md-btn" @onclick="OnDownloadMissingMap">
                                        下载地图<span class="en">DOWNLOAD</span>
                                    </button>
                                }
                            </div>
                        }

                        @if (Room.IsHost)
                        {
                            <div class="cfg-rules">
                                <div class="cfg-row">
                                    <label>房间名</label>
                                    <input class="gl-input" maxlength="40" value="@_roomNameDraft" @oninput="OnRoomNameInput" @onchange="CommitRoomName" />
                                </div>
                                <div class="cfg-row">
                                    <label>最大人数</label>
                                    <select class="gl-select" value="@Room.MaxPlayers" @onchange="OnMaxPlayersChange">
                                        @for (int p = 2; p <= 8; p++)
                                        {
                                            <option value="@p">@p 人</option>
                                        }
                                    </select>
                                    <label>技能</label>
                                    <select class="gl-select" value="@Room.SkillLevel" @onchange="OnSkillChange">
                                        @for (int s = 0; s < SkillLevels.Length; s++)
                                        {
                                            <option value="@s">@SkillLevels[s]</option>
                                        }
                                    </select>
                                </div>
                                <div class="cfg-row">
                                    <label>房间密码</label>
                                    <input class="gl-input" type="password" maxlength="32"
                                           placeholder="@(Room.IsCustomPassword ? "已设置密码（输入新密码修改，清空并回车移除）" : "留空 = 公开房")"
                                           value="@_passwordDraft" @oninput="OnPasswordInput" @onchange="CommitRoomPassword" />
                                </div>
                                <div class="cfg-row">
                                    <button class="mb-btn @(Room.Locked ? "danger" : "")" @onclick="OnToggleLock">
                                        @(Room.Locked ? "解除锁定" : "锁定房间")
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="cfg-self">
                            <div class="cfg-self-title">我的配置 <em>SELF</em>
                                @if (IsSelfSpectator)
                                {
                                    <span class="self-spec">● 观战中（不参与对局）</span>
                                }
                            </div>
                            <div class="cfg-row">
                                <label>阵营</label>
                                <select class="gl-select" value="@Self.Side" @onchange="OnSideChange">
                                    @for (int s = 0; s < Sides.Length; s++)
                                    {
                                        <option value="@s">@Sides[s]</option>
                                    }
                                    <option value="@Sides.Length">观战</option>
                                </select>
                                <label>出生点</label>
                                <select class="gl-select" value="@Self.Start" @onchange="OnStartChange"
                                        disabled="@(IsSelfSpectator || Room.StartLocationSelectionDisabled)">
                                    @for (int st = 1; st <= Room.MaxPlayers; st++)
                                    {
                                        <option value="@st">@st</option>
                                    }
                                </select>
                                <label>队伍</label>
                                <select class="gl-select" value="@Self.Team" @onchange="OnTeamChange">
                                    @for (int t = 0; t <= 4; t++)
                                    {
                                        <option value="@t">@(t == 0 ? "无" : t.ToString())</option>
                                    }
                                </select>
                            </div>
                            <div class="cfg-row">
                                <label>颜色</label>
                                <div class="cfg-colors">
                                    @foreach (var c in _colors)
                                    {
                                        <button type="button" class="swatch @(c.Index == Self.Color ? "on" : "")"
                                                style="background:@ToCss(c.Color)" title="@c.Name"
                                                @onclick="() => SetColor(c.Index)"></button>
                                    }
                                </div>
                            </div>
                            <div class="cfg-actions">
                                <button class="mb-btn @(Self.Ready ? "primary" : "") ready-btn" @onclick="OnToggleReady">
                                    @(Self.Ready ? "已就绪" : "准备就绪")<span class="en">READY</span>
                                </button>
                                @if (Room.IsHost)
                                {
                                    <button class="mb-btn primary start-btn" disabled="@(Room.SelectedMap is null)" @onclick="OnStartGame">
                                        开始游戏<span class="en">START</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="cfg-options">
                            <div class="cfg-self-title">游戏选项 <em>GAME OPTIONS</em>
                                <span class="self-spec">@(Room.IsHost ? "房主可改，将同步给全员" : "由房主设置，同步显示")</span>
                                @if (Room.IsHost)
                                {
                                    <button type="button" class="mb-btn go-preset-btn" @onclick="OpenPresetDialog">
                                        预设<span class="en">PRESET</span>
                                    </button>
                                }
                            </div>
                            <div class="go-grid">
                                @foreach (var opt in CheckBoxOptions)
                                {
                                    <label class="gl-check go-check">
                                        <input type="checkbox" checked="@opt.Checked" disabled="@(!Room.IsHost)"
                                               @onchange="(e) => OnCheckBoxOptionChange(opt, e)" />
                                        <span>@opt.DisplayName</span>
                                    </label>
                                }
                            </div>
                            @foreach (var dd in DropDownOptions)
                            {
                                <div class="go-dd">
                                    <label>@dd.DisplayName</label>
                                    <select class="gl-select" value="@dd.SelectedIndex" disabled="@(!Room.IsHost)"
                                            @onchange="(e) => OnDropDownOptionChange(dd, e)">
                                        @for (int i = 0; i < dd.Items.Count; i++)
                                        {
                                            <option value="@i">@dd.Items[i]</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        <!-- 第八轮 r8-3：玩家附加选项（原版 PlayerExtraOptionsPanel；房主修改经 PEO 广播同步） -->
                        <div class="cfg-extra-options">
                            <div class="cfg-self-title">玩家附加选项 <em>EXTRA OPTIONS</em>
                                <span class="self-spec">@(Room.IsHost ? "房主可改，将同步给全员" : "由房主设置，同步显示")</span>
                            </div>
                            <div class="eo-grid">
                                <label class="gl-check eo-check">
                                    <input type="checkbox" checked="@Room.ExtraOptions.IsForceRandomSides"
                                           disabled="@(!Room.IsHost)" @onchange="OnForceRandomSidesChange" />
                                    <span>强制随机阵营</span>
                                </label>
                                <label class="gl-check eo-check">
                                    <input type="checkbox" checked="@Room.ExtraOptions.IsForceRandomColors"
                                           disabled="@(!Room.IsHost)" @onchange="OnForceRandomColorsChange" />
                                    <span>强制随机颜色</span>
                                </label>
                                <label class="gl-check eo-check">
                                    <input type="checkbox" checked="@Room.ExtraOptions.IsForceRandomStarts"
                                           disabled="@(!Room.IsHost)" @onchange="OnForceRandomStartsChange" />
                                    <span>强制随机出生点</span>
                                </label>
                                <label class="gl-check eo-check">
                                    <input type="checkbox" checked="@Room.ExtraOptions.IsForceNoTeams"
                                           disabled="@(!Room.IsHost || Room.ExtraOptions.IsUseTeamStartMappings)"
                                           @onchange="OnForceNoTeamsChange" />
                                    <span>强制无队伍</span>
                                </label>
                                <label class="gl-check eo-check">
                                    <input type="checkbox" checked="@Room.ExtraOptions.IsUseTeamStartMappings"
                                           disabled="@(!Room.IsHost || !Room.TeamStartMappingsAllowed)"
                                           @onchange="OnUseTeamStartMappingsChange" />
                                    <span>自动结盟</span>
                                </label>
                            </div>
                            @if (Room.ExtraOptions.IsUseTeamStartMappings)
                            {
                                <div class="eo-ally">
                                    <div class="eo-ally-head">
                                        <label>预设</label>
                                        <select class="gl-select eo-preset" value="0"
                                                disabled="@(!Room.IsHost || Room.TeamStartMappingPresets.Count == 0)"
                                                @onchange="OnAutoAllyPresetChange">
                                            <option value="0">自定义</option>
                                            @for (int p = 0; p < Room.TeamStartMappingPresets.Count; p++)
                                            {
                                                <option value="@(p + 1)">@Room.TeamStartMappingPresets[p].Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="eo-mappings">
                                        @for (int st = 1; st <= Room.MaxPlayers; st++)
                                        {
                                            var teamValue = GetExtraMappingTeam(st);
                                            <div class="eo-map-cell">
                                                <span class="eo-map-idx">@st</span>
                                                <select class="gl-select eo-map-sel" value="@teamValue"
                                                        disabled="@(!Room.IsHost || !Room.AllowedTeamStartMappingLocations.Contains(st))"
                                                        @onchange="(e) => OnExtraMappingChange(st, e)">
                                                    @foreach (var opt in ExtraMappingTeamOptions)
                                                    {
                                                        <option value="@opt.Value">@opt.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <section class="gl-panel gl-chat item-in" style="animation-delay:150ms">
                    <header class="gl-ph">
                        <span>房间聊天 <em>@(Room.GameChannel?.ChannelName ?? "—")</em></span>
                    </header>
                    <div class="chat-scroll">
                        @if (RoomMessages.Count == 0)
                        {
                            <div class="lb-empty">暂无房间消息</div>
                        }
                        else
                        {
                            @foreach (var m in RoomMessages)
                            {
                                <div class="chat-msg @(m.IsUser ? "user" : "sys")">
                                    @if (m.IsUser)
                                    {
                                        <span class="cm-time">@m.DateTime.ToString("HH:mm")</span>
                                        <span class="cm-name" style="color:@ToCss(m.Color)">@m.SenderName</span>
                                        <span class="cm-text"><ChatText Text="@m.Message" /></span>
                                    }
                                    else
                                    {
                                        <span class="cm-sys"><ChatText Text="@m.Message" /></span>
                                    }
                                </div>
                            }
                        }
                        <div @ref="_chatEnd"></div>
                    </div>
                    <div class="chat-input">
                        <input class="ci-field" maxlength="200" placeholder="房间消息，Enter 发送…"
                               value="@_draft" @oninput="OnDraftInput" @onkeydown="OnChatKeyDown" />
                        <button class="mb-btn primary ci-send" @onclick="OnSend">发送</button>
                    </div>
                </section>
            </div>
        }
