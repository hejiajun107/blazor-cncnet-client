    /// <summary>加载多人颜色，失败时回退默认 8 色（GameOptions.ini 缺失等边界）。</summary>
    private static List<ColorOption> LoadColorsSafe()
    {
        try
        {
            var colors = MultiplayerColor.LoadColors();
            return colors.Select(c => new ColorOption(c.Name, c.GameColorIndex, c.XnaColor)).ToList();
        }
        catch
        {
            // 回退默认色板
        }
        return new List<ColorOption>
        {
            new("红", 0, new Rgba32(255, 60, 60, 255)),
            new("蓝", 1, new Rgba32(70, 120, 255, 255)),
            new("青", 2, new Rgba32(80, 220, 255, 255)),
            new("绿", 3, new Rgba32(80, 220, 120, 255)),
            new("黄", 4, new Rgba32(255, 220, 80, 255)),
            new("橙", 5, new Rgba32(255, 150, 60, 255)),
            new("紫", 6, new Rgba32(190, 120, 255, 255)),
            new("粉", 7, new Rgba32(255, 130, 200, 255)),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
