    /// <summary>读取大厅传入的创建/加入请求并进入房间（scoped 请求用后即清）。</summary>
    private void EnterRoom()
    {
        try
        {
            if (NavData.PendingJoin is { } join)
            {
                Room.JoinGame(new LobbyGameItem(
                    join.RoomName, join.HostName, string.Empty, string.Empty, string.Empty,
                    Array.Empty<string>(), Math.Max(2, join.MaxPlayers),
                    join.Passworded, join.Locked, false, false, join.ChannelName,
                    ProgramConstants.GAME_VERSION, DateTime.Now),
                    join.Password);
                return;
            }
            if (NavData.PendingCreate is { } create)
            {
                Room.CreateGame(create.RoomName, create.MaxPlayers, create.Password);
                return;
            }
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
        finally
        {
            NavData.PendingJoin = null;
            NavData.PendingCreate = null;
        }
    }

    private void RefreshMaps()
    {
        IEnumerable<MapOption> query = MapLoader.GameModeMaps
            .Select((gmm, i) => new MapOption(gmm, i, gmm.GameMode.UIName, gmm.ToUIString()));

        // 工具条过滤/排序（原版 TbMapSearch_InputReceived / btnShowFavoriteMaps / btnMapSortAlphabetically）
        if (_favOnly)
            query = query.Where(o => o.Value.IsFavorite);
        if (!string.IsNullOrWhiteSpace(_mapSearch))
        {
            var kw = _mapSearch.Trim();
            query = query.Where(o =>
                o.Value.Map.Name.Contains(kw, StringComparison.OrdinalIgnoreCase) ||
                o.Value.Map.UntranslatedName.Contains(kw, StringComparison.OrdinalIgnoreCase));
        }
        if (_sortMode == 1)
            query = query.OrderBy(o => o.Display, StringComparer.OrdinalIgnoreCase);
        else if (_sortMode == 2)
            query = query.OrderByDescending(o => o.Display, StringComparer.OrdinalIgnoreCase);

        // 过滤/排序后重建索引：select 的 option value 与 SelectedMapIndex 均以列表内位置为准
        _mapOptions = query.Select((o, i) => o with { Index = i }).ToList();
        _mapGroups = _mapOptions.GroupBy(o => o.Mode)
            .Select(g => new MapGroup(g.Key, g.ToList()))
            .ToList();
    }

    private void OnMapLoadingComplete(object? sender, EventArgs e) =>
        _ = InvokeAsync(() =>
        {
            RefreshMaps();
            StateHasChanged();
        });

    private void OnChanged()
    {
        var count = Room.GameChannel?.Messages.Count ?? 0;
        _scrollToBottom = count != _lastMessageCount;
        _lastMessageCount = count;
        // r9-4：Discord 呈现同步（原版 CnCNetGameLobby 在玩家/设置变化时调用 UpdatePresence；
        // DiscordHandler.CurrentPresence setter 带相等检查，未变化时不会重复推送）
        UpdateDiscordPresence();
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>推送当前房间状态到 Discord（未加入房间时退化为默认呈现）。</summary>
    private void UpdateDiscordPresence()
    {
        if (!Room.IsJoined || Room.SelectedMap is null)
        {
            Discord.MainMenu();
            return;
        }

        Discord.Game(
            map: Room.SelectedMap.Map.UntranslatedName,
            mode: Room.SelectedMap.GameMode.UIName,
            type: "Online",
            state: "In Lobby",
            players: Room.Players.Count,
            maxPlayers: Room.MaxPlayers,
            side: GetSideName(Self.Side),
            roomName: Room.RoomName,
            isHost: Room.IsHost,
            isPassworded: Room.IsCustomPassword,
            isLocked: Room.Locked
        );
    }

