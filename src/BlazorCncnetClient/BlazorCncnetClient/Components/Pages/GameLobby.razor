            Room.SetAILevel(ai, v);
    }

    private void OnAISideChange(PlayerInfo ai, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
            Room.SetAIOption(ai, v, ai.ColorId, ai.StartingLocation, ai.TeamId);
    }

    private void OnAIStartChange(PlayerInfo ai, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
            Room.SetAIOption(ai, ai.SideId, ai.ColorId, v, ai.TeamId);
    }

    private void OnAITeamChange(PlayerInfo ai, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
            Room.SetAIOption(ai, ai.SideId, ai.ColorId, ai.StartingLocation, v);
    }

    private void ApplyOwnOptions(int side, int color, int start, int team)
    {
        try
        {
            Room.ChangeOwnOptions(side, color, start, team);
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
    }

    private void OnToggleReady()
    {
        try
        {
            Room.ToggleReady();
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
    }

    private void OnStartGame()
    {
        try
        {
            // START 广播 + GameStartRequested → GameLaunchService 生成配置、跳转加载页并启动游戏进程
            Room.StartGame();
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
    }

    // ── 2-4 游戏选项（复选/下拉；房主修改经 GO 同步，加入者只读展示） ──

    private List<GameSessionCheckBoxOption> CheckBoxOptions =>
        Room.GameOptions.OfType<GameSessionCheckBoxOption>().ToList();

    private List<GameSessionDropDownOption> DropDownOptions =>
        Room.GameOptions.OfType<GameSessionDropDownOption>().ToList();

    private void OnCheckBoxOptionChange(GameSessionCheckBoxOption opt, ChangeEventArgs e)
    {
        if (!Room.IsHost)
            return;
        if (bool.TryParse(e.Value?.ToString(), out bool v))
            Room.SetCheckBoxOption(opt, v);
    }

    private void OnDropDownOptionChange(GameSessionDropDownOption dd, ChangeEventArgs e)
    {
        if (!Room.IsHost)
            return;
        if (int.TryParse(e.Value?.ToString(), out int v))
            Room.SetDropDownOption(dd, v);
    }

    // ── 玩家附加选项（r8-3：原版 PlayerExtraOptionsPanel，房主修改经 PEO 广播） ──

    /// <summary>附加选项同步（本地修改 / 收到 PEO 广播）后刷新面板。</summary>
    private void OnExtraOptionsChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>自动结盟出生点下拉选项（x=阻挡 / -=无 / A..D=队伍，同原版 TeamStartMapping.TEAMS）。</summary>
    private static List<(string Value, string Label)> ExtraMappingTeamOptions => new()
    {
        (TeamStartMapping.NO_PLAYER, "阻挡"),
        (TeamStartMapping.NO_TEAM, "无队伍"),
        ("A", "A"),
        ("B", "B"),
        ("C", "C"),
        ("D", "D"),
    };

    /// <summary>读取指定出生点的自动结盟队伍（未配置回退“无队伍”）。</summary>
    private string GetExtraMappingTeam(int start)
    {
        var mapping = Room.ExtraOptions.TeamStartMappings.FirstOrDefault(m => m.Start == start);
        return mapping?.Team ?? TeamStartMapping.NO_TEAM;
    }

    private void OnForceRandomSidesChange(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool v))
            Room.SetForceRandomSides(v);
    }

    private void OnForceRandomColorsChange(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool v))
            Room.SetForceRandomColors(v);
    }

    private void OnForceRandomStartsChange(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool v))
            Room.SetForceRandomStarts(v);
    }

    private void OnForceNoTeamsChange(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool v))
            Room.SetForceNoTeams(v);
    }

    private void OnUseTeamStartMappingsChange(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool v))
            Room.SetUseTeamStartMappings(v);
    }

    /// <summary>应用选中的预设：下拉第 0 项为 Custom（自定义），其后依次为地图预设；应用后回到 Custom。</summary>
    private void OnAutoAllyPresetChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int v) || v <= 0)
            return;
        Room.ApplyTeamStartMappingPreset(v - 1);
    }

    private void OnExtraMappingChange(int start, ChangeEventArgs e)
    {
        Room.SetTeamStartMapping(start, e.Value?.ToString() ?? TeamStartMapping.NO_TEAM);
    }

    // ── 房间聊天 ──

    private void OnDraftInput(ChangeEventArgs e) => _draft = e.Value?.ToString() ?? string.Empty;

    private void OnChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            OnSend();
    }

    private void OnSend()
    {
        if (string.IsNullOrWhiteSpace(_draft))
            return;
        Room.SendRoomChat(_draft);
        _draft = string.Empty;
    }

    /// <summary>ESC：离开房间前确认（由 JS keydown 触发）。</summary>
    [JSInvokable]
    public Task OnLobbyEsc()
    {
        _ = OnLeave();
        return Task.CompletedTask;
    }

    private string GetSideName(int side) =>
        side >= 0 && side < Sides.Length ? Sides[side] : $"阵营{side}";

    private Rgba32 GetColor(int index) =>
        (_colors.FirstOrDefault(c => c.Index == index) ?? _colors.FirstOrDefault())?.Color
        ?? new Rgba32(160, 220, 255, 255);

    private static string ToCss(Rgba32 color) => $"rgb({color.R},{color.G},{color.B})";

    /// <summary>房主不活跃警告（原版 GameHostInactiveChecker 弹框"Are you still here?"，确认后重置计时）。
    /// 事件类型为 <see cref="Action"/>，故用 async void 订阅。</summary>
    private async void OnHostInactiveWarning()
    {
        if (!Room.IsHost || !Room.IsInGameRoom)
            return;
        var ok = await MessageBox.ShowAsync(
            "你还在吗？",
            "由于长时间无操作，你的游戏房间可能被关闭。",
            MessageBoxButtons.Ok, MessageBoxKind.Warn);
        if (ok)
            Room.ResetHostActivity();
    }

    /// <summary>页面级 mousemove/keydown 活动上报（app.js initHostActivityWatcher 节流回调）。</summary>
    [JSInvokable]
    public Task OnHostActivity()
    {
        Room.ResetHostActivity();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Room.Changed -= OnChanged;
        Room.HostInactiveWarningRequested -= OnHostInactiveWarning;
        Room.PlayerExtraOptionsChanged -= OnExtraOptionsChanged;
        ThemeProvider.ThemeChanged -= OnThemeChanged;
        MapLoader.MapLoadingComplete -= OnMapLoadingComplete;
        if (_dotNetRef is not null)
        {
            _ = JS.InvokeVoidAsync("cncnet.disposeLobbyKeyNav");
            _ = JS.InvokeVoidAsync("cncnet.disposeHostActivityWatcher");
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }

    private sealed record MapOption(GameModeMap Value, int Index, string Mode, string Display);
    private sealed record MapGroup(string Key, List<MapOption> Items);
    private sealed record ColorOption(string Name, int Index, Rgba32 Color);
}
