@page "/"
@implements IDisposable
@inject EnvironmentCheck Env
@inject GameFileSetupService GameFiles
@inject ILogger<Index> Logger
@inject NavigationManager Nav
@inject ITranslationService TranslationSvc

<div class="env-check">
    <h1>@T("Index.Title", "CNCNet Client")</h1>
    <p class="subtitle">@T("Index.Subtitle", "Startup environment check")</p>

    <div class="env-row"><span>@T("Index.StartupDirectory", "Startup directory")</span><code>@Env.StartupPath</code></div>
    <div class="env-row"><span>@T("Index.GameDirectory", "Game directory")</span><code>@(Env.GamePath ?? T("Index.NotFound", "Not found"))</code></div>
    <div class="env-row"><span>ClientDefinitions.ini</span><code>@(Env.ClientDefinitionsFound ? T("Index.Found", "Found") : T("Index.Missing", "Missing"))</code></div>
    <div class="env-row"><span>@T("Index.ClientConfig", "Client configuration")</span><code>@(Env.ConfigurationReady ? T("Index.Initialized", "Initialized") : T("Index.NotInitialized", "Not initialized"))</code></div>

    <div class="msg @(Env.IsReady ? "ok" : "warn")">@Env.Message</div>

    @* 游戏运行文件缺失引导（用户确认清单：gamemd.exe/核心 mix/Ares 链等）。
        已定位游戏目录但缺必要文件时，引导选择完整 YR 目录并提取，完成后复检。 *@
    @if (GameFiles.MissingFiles.Length > 0)
    {
        <div class="msg warn">
            <strong>@F("Index.MissingFilesTitle", "Missing game files ({0})", GameFiles.MissingFiles.Length)</strong><br />
            @T("Index.MissingFilesHint", "Select a complete Yuri's Revenge installation directory; the client will extract the missing files automatically:")
            <span class="missing">@string.Join(T("Index.ListSeparator", ", "), GameFiles.MissingFiles)</span>
            @if (!string.IsNullOrEmpty(GameFiles.LastMessage))
            {
                <br /><span class="detail">@GameFiles.LastMessage</span>
            }
        </div>
        <div class="actions">
            <button class="btn primary" disabled="@_busy" @onclick="ExtractGameFiles">
                @(_busy ? T("Index.Extracting", "Extracting…") : T("Index.PickDirectory", "Select Yuri's Revenge directory and extract"))
            </button>
            @if (GameFiles.IsGameReady)
            {
                <button class="btn" @onclick="GoMainMenu">@T("Index.EnterMainMenu", "Enter main menu")</button>
            }
        </div>
    }
    else
    {
        <div class="actions">
            @if (Env.IsReady)
            {
                <button class="btn primary" @onclick="GoMainMenu">@T("Index.EnterMainMenu", "Enter main menu")</button>
            }
            else
            {
                <button class="btn" @onclick="ReDetect">@T("Index.ReDetect", "Check again")</button>
            }
            <button class="btn" @onclick="PreviewMainMenu">@T("Index.PreviewMenu", "Preview main menu (dev)")</button>
        </div>
    }
</div>

@code {
    /// <summary>文案查表（Resx / 原版 Translation.ini），缺失时用英文原文兜底。</summary>
    private static string T(string key, string fallback) => UiText.T(key, fallback);

    /// <summary>带参数的文案（占位符 {0}…）。</summary>
    private static string F(string key, string fallback, params object[] args)
        => string.Format(UiText.T(key, fallback), args);

    private bool _busy;

    protected override void OnInitialized()
    {
        Logger.LogInformation("启动环境检测开始");
        Env.Detect();
        Logger.LogInformation("启动环境检测结束: {Ready} - {Message}", Env.IsReady, Env.Message);

        // 游戏运行文件检测（启动时即提示缺失，引导提取）。
        GameFiles.Detect();

        TranslationSvc.LanguageChanged += OnLanguageChanged;
    }

    private async Task ExtractGameFiles()
    {
        if (_busy)
            return;

        _busy = true;
        try
        {
            var (copied, skipped) = await GameFiles.PickAndExtractAsync();
            Logger.LogInformation("游戏文件提取完成: 拷贝 {Copied} 个, 跳过 {Skipped} 个, 仍缺 {Missing} 个",
                copied.Length, skipped.Length, GameFiles.MissingFiles.Length);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "游戏文件提取失败");
        }
        finally
        {
            _busy = false;
        }
    }

    private void ReDetect() => Env.Detect();

    private void GoMainMenu() => Nav.NavigateTo("/menu");

    // 开发期预览入口：无需游戏资源即可查看主菜单 UI。
    private void PreviewMainMenu() => Nav.NavigateTo("/menu");

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => TranslationSvc.LanguageChanged -= OnLanguageChanged;
}
