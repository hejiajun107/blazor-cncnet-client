@page "/lan/game"
@implements IDisposable
@using CnCNetClient.Core
@using CnCNetClient.Domain.LAN
@using CnCNetClient.Domain.Multiplayer
@using CnCNetClient.Domain.Multiplayer.LAN
@using CnCNetClient.Online
@using SixLabors.ImageSharp.PixelFormats
@inject LanGameRoomService Room
@inject LanGameNavigation NavData
@inject MapLoader MapLoader
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IThemeProvider ThemeProvider
@inject MessageBoxService MessageBox
@inject LanGameLaunchService GameLauncher
@inject ITranslationService TranslationSvc

@if (!Room.IsInGameRoom)
{
    <div class="game-empty page-anim">
        <div class="ge-box pop-in">
            <div class="ge-title">LAN GAME ROOM</div>
            <div class="ge-sub">@T("LanGame.NotInRoom", "Not in any LAN room yet")</div>
            <button class="mb-btn primary" @onclick="BackToLobby">@T("GameLobby.BackToLobby", "Back to lobby")</button>
        </div>
    </div>
}
else
{
    <div class="groom page-anim">
        <header class="groom-top item-in">
            <div class="gt-left">
                <span class="gt-badge @(Room.IsHost ? "host" : "")">@(Room.IsHost ? T("Lobby.Host", "Host") : T("Lobby.Join", "Join"))<span class="en">@(Room.IsHost ? "HOST" : "JOIN")</span></span>
                <div class="gt-tbox">
                    <span class="gt-title">@Room.RoomName</span>
                    <span class="gt-en">@(Room.HostName.Length > 0 ? F("LanGame.HostName", "Host {0}", Room.HostName) : "—") · LAN · TCP @(ProgramConstants.LAN_GAME_LOBBY_PORT)</span>
                </div>
            </div>
            <div class="gt-right">
                <span class="gt-player">@ProgramConstants.PLAYERNAME</span>
                <button class="mb-btn danger" @onclick="OnLeave">@T("GameLobby.LeaveRoom", "Leave room")</button>
            </div>
        </header>

        @if (!HasSelf)
        {
            <div class="groom-joining">
                <div class="gj-spinner"></div>
                <span>@T("LanGame.Joining", "Joining LAN room…")</span>
            </div>
        }
        else
        {
            <div class="groom-grid">
                <section class="gl-panel gl-slots item-in" style="animation-delay:50ms">
                    <header class="gl-ph">
                        <span>@T("Lobby.Players", "Players") <em>@Room.Players.Count/@Room.MaxPlayers</em></span>
                        <span class="gl-lock" title="@T("GameLobby.LockStatusTip", "Room lock status")">
                            @(Room.Locked ? T("GameLobby.Locked", "◉ Locked") : T("GameLobby.Unlocked", "○ Public"))
                        </span>
                    </header>
                    <div class="gl-body">
                        @for (int i = 0; i < Room.MaxPlayers; i++)
                        {
                            var slotPlayer = i < Room.Players.Count ? Room.Players.ElementAt(i) : null;
                            <div class="slot @(slotPlayer is null ? "empty" : IsSelf(slotPlayer) ? "self" : "")">
                                <span class="slot-idx">@(i + 1)</span>
                                @if (slotPlayer is null)
                                {
                                    <span class="slot-empty-text">@T("GameLobby.WaitingForPlayers", "Waiting for players…")</span>
                                }
                                else
                                {
                                    <span class="slot-color" style="background:@ToCss(GetColor(slotPlayer.ColorId))"></span>
                                    <div class="slot-info">
                                        <span class="slot-name">
                                            @slotPlayer.Name
                                            @if (i == 0)
                                            {
                                                <em class="slot-host">HOST</em>
                                            }
                                        </span>
                                        <span class="slot-meta">
                                            @GetSideName(slotPlayer.SideId)@F("GameLobby.StartSuffix", " · Start {0}", slotPlayer.StartingLocation)@(slotPlayer.TeamId > 0 ? F("GameLobby.TeamSuffix", " · Team {0}", slotPlayer.TeamId) : "")
                                        </span>
                                    </div>
                                    <span class="slot-ready @(slotPlayer.Ready ? "on" : "")">@(slotPlayer.Ready ? "READY" : "…")</span>
                                }
                            </div>
                        }
                    </div>
                </section>

                <section class="gl-panel gl-config item-in" style="animation-delay:100ms">
                    <header class="gl-ph">
                        <span>@T("GameLobby.MapAndRules", "Map & rules") <em>MAP & RULES</em></span>
                    </header>
                    <div class="gl-body">
                        <div class="cfg-map">
                            <div class="cfg-map-preview">
                                <MapThumbnail MapHash="@Room.SelectedMap?.Map.SHA1" MapName="@Room.SelectedMap?.Map.UntranslatedName" CssClass="cfg-thumb" />
                                @if (Room.SelectedMap is null)
                                {
                                    <div class="cfg-map-none">@(Room.IsHost ? T("Skirmish.SelectMap", "Please select a map") : T("GameLobby.WaitingHostMap", "Waiting for the host to pick a map…"))</div>
                                }
                                else
                                {
                                    <div class="spawn-layer">
                                        @foreach (var sp in SpawnPoints)
                                        {
                                            var spStyle = $"left:{sp.X * 100:0.##}%;top:{sp.Y * 100:0.##}%";
                                            var spCls = sp.IsSelf ? "self" : sp.OccupantName is null ? "free" : "taken";
                                            <button type="button"
                                                    class="spawn-dot @spCls"
                                                    style="@spStyle"
                                                    title="@(sp.OccupantName is null ? F("Skirmish.SpawnPoint", "Spawn {0}", sp.Index) : F("Skirmish.SpawnPointOwner", "Spawn {0} · {1}", sp.Index, sp.OccupantName))"
                                                    @onclick="() => OnSpawnClick(sp.Index)">
                                                <span class="spawn-num">@sp.Index</span>
                                                @if (sp.OccupantName is not null)
                                                {
                                                    <span class="spawn-owner"></span>
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            @if (Room.IsHost)
                            {
                                <!-- 游戏模式选择（原版 cmbGameMode：切换模式过滤地图列表） -->
                                <div class="map-mode">
                                    <span class="mm-label">@T("Skirmish.GameMode", "Game mode")</span>
                                    <select class="gl-select" value="@_selectedMode" @onchange="OnModeChange">
                                        @if (ModeOptions.Count == 0)
                                        {
                                            <option value="">@T("Common.Loading", "— Loading —")</option>
                                        }
                                        else
                                        {
                                            @foreach (var m in ModeOptions)
                                            {
                                                <option value="@m">@m</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <!-- 地图列表（原版 lbMapList：当前模式的地图直接呈现为可点选列表） -->
                                <div class="map-list">
                                    @if (_mapOptions.Count == 0)
                                    {
                                        <div class="map-list-empty">@(ModeOptions.Count == 0 ? T("Skirmish.MapsLoading", "— Loading maps —") : T("Skirmish.NoMatchingMaps", "— No matching maps —"))</div>
                                    }
                                    else
                                    {
                                        @for (int i = 0; i < _mapOptions.Count; i++)
                                        {
                                            var opt = _mapOptions[i];
                                            var idx = i; // for 循环变量为共享变量，须拷贝为局部变量供闭包捕获，否则点击时索引恒为 Count（越界）
                                            var isSel = idx == SelectedMapIndex;
                                            <div class="map-list-item @(isSel ? "sel" : "") @(opt.Value.IsFavorite ? "fav" : "")"
                                                 @onclick="() => SelectMap(idx)"
                                                 title="@opt.Display">
                                                <span class="ml-star">★</span>
                                                <span class="ml-name">@opt.Display</span>
                                                <span class="ml-meta">@(opt.Value.MinPlayers)–@(opt.Value.MaxPlayers)</span>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="cfg-map-name">@(Room.SelectedMap is not null ? Room.SelectedMap.ToUIString() : "—")</div>
                            }

                            <div class="map-info">
                                <div class="mi-row"><span>@T("Lobby.Game", "Game")</span><b>@LocalGameName</b></div>
                                <div class="mi-row"><span>@T("GameLobby.Version", "Version")</span><b>@ProgramConstants.GAME_VERSION</b></div>
                                <div class="mi-row"><span>@T("Lobby.Host", "Host")</span><b>@Room.HostName</b></div>
                                <div class="mi-row"><span>@T("GameLobby.PlayerCount", "Players")</span><b>@Room.Players.Count / @Room.MaxPlayers</b></div>
                                @if (Room.SelectedMap is not null)
                                {
                                    <div class="mi-divider"></div>
                                    <div class="mi-row"><span>@T("Lobby.Map", "Map")</span><b>@Room.SelectedMap.Map.Name</b></div>
                                    <div class="mi-row"><span>@T("Skirmish.Author", "Author")</span><b>@Room.SelectedMap.Map.Author</b></div>
                                    <div class="mi-row"><span>@T("Skirmish.Size", "Size")</span><b>@Room.SelectedMap.Map.GetSizeString()</b></div>
                                    <div class="mi-row"><span>@T("Lobby.Mode", "Mode")</span><b>@Room.SelectedMap.GameMode.UIName</b></div>
                                    @if (!string.IsNullOrEmpty(Room.SelectedMap.Map.Briefing))
                                    {
                                        <div class="mi-briefing">@Room.SelectedMap.Map.Briefing</div>
                                    }
                                }
                            </div>
                        </div>

                        @if (Room.IsHost)
                        {
                            <div class="cfg-rules">
                                <div class="cfg-row">
                                    <button class="mb-btn @(Room.Locked ? "danger" : "")" @onclick="OnToggleLock">
                                        @(Room.Locked ? T("GameLobby.UnlockRoom", "Unlock room") : T("GameLobby.LockRoom", "Lock room"))
                                    </button>
                                    <span class="cfg-hint">@T("LanGame.StartHint", "The room must be locked and all players ready to start")</span>
                                </div>
                            </div>
                        }

                        <div class="cfg-options">
                            <div class="cfg-self-title">@T("Skirmish.GameOptions", "Game options") <em>GAME OPTIONS</em>
                                <span class="self-spec">@(Room.IsHost ? T("GameLobby.HostCanChange", "Host can change; synced to everyone") : T("GameLobby.HostSets", "Set by the host; shown to everyone"))</span>
                            </div>
                            <div class="go-grid">
                                @foreach (var opt in CheckBoxOptions)
                                {
                                    <label class="gl-check go-check" title="@opt.ToolTip" data-option="@opt.Name">
                                        <input type="checkbox" checked="@opt.Checked" disabled="@(!Room.IsHost)"
                                               @onchange="(e) => OnCheckBoxOptionChange(opt, e)" />
                                        <span>@opt.DisplayName</span>
                                    </label>
                                }
                            </div>
                            @foreach (var dd in DropDownOptions)
                            {
                                <div class="go-dd" title="@dd.ToolTip" data-option="@dd.Name">
                                    <label>@dd.DisplayName</label>
                                    <select class="gl-select" value="@dd.SelectedIndex" disabled="@(!Room.IsHost)"
                                            @onchange="(e) => OnDropDownOptionChange(dd, e)">
                                        @for (int i = 0; i < dd.Items.Count; i++)
                                        {
                                            <option value="@i">@dd.Items[i]</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        <div class="cfg-self">
                            <div class="cfg-self-title">@T("GameLobby.MyConfig", "My setup") <em>SELF</em></div>
                            <div class="cfg-row">
                                <label>@T("GameLobby.Side", "Side")</label>
                                <select class="gl-select" value="@Self!.SideId" @onchange="OnSideChange">
                                    @for (int s = 0; s < Sides.Length; s++)
                                    {
                                        <option value="@s">@Sides[s]</option>
                                    }
                                </select>
                                <label>@T("GameLobby.Start", "Spawn")</label>
                                <select class="gl-select" value="@Self!.StartingLocation" @onchange="OnStartChange">
                                    @for (int st = 1; st <= Room.MaxPlayers; st++)
                                    {
                                        <option value="@st">@st</option>
                                    }
                                </select>
                                <label>@T("GameLobby.Team", "Team")</label>
                                <select class="gl-select" value="@Self!.TeamId" @onchange="OnTeamChange">
                                    @for (int t = 0; t <= 4; t++)
                                    {
                                        <option value="@t">@(t == 0 ? T("GameLobby.None", "None") : t.ToString())</option>
                                    }
                                </select>
                            </div>
                            <div class="cfg-row">
                                <label>@T("GameLobby.Color", "Color")</label>
                                <div class="cfg-colors">
                                    @foreach (var c in _colors)
                                    {
                                        <button type="button" class="swatch @(c.Index == Self!.ColorId ? "on" : "")"
                                                style="background:@ToCss(c.Color)" title="@c.Name"
                                                @onclick="() => SetColor(c.Index)"></button>
                                    }
                                </div>
                            </div>
                            <div class="cfg-actions">
                                <button class="mb-btn @(Self!.Ready ? "primary" : "") ready-btn" @onclick="OnToggleReady">
                                    @(Self!.Ready ? T("GameLobby.Ready", "Ready") : T("GameLobby.SetReady", "Set ready"))<span class="en">READY</span>
                                </button>
                                @if (Room.IsHost)
                                {
                                    <button class="mb-btn primary start-btn" disabled="@(Room.SelectedMap is null || !Room.Locked)" @onclick="OnStartGame">
                                        @T("Skirmish.StartGame", "Start game")<span class="en">START</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </section>

                <section class="gl-panel gl-chat item-in" style="animation-delay:150ms">
                    <header class="gl-ph">
                        <span>@T("GameLobby.RoomChat", "Room chat") <em>@F("Lobby.NPlayers", "{0} players", Room.Players.Count)</em></span>
                    </header>
                    <div class="chat-scroll">
                        @if (RoomMessages.Count == 0)
                        {
                            <div class="lb-empty">@T("GameLobby.NoRoomMessages", "No room messages yet")</div>
                        }
                        else
                        {
                            @foreach (var m in RoomMessages)
                            {
                                @if (m.SenderName is not null)
                                {
                                    <div class="chat-msg user">
                                        <span class="cm-time">@m.DateTime.ToString("HH:mm")</span>
                                        <span class="cm-name" style="color:@ToCss(m.Color)">@m.SenderName</span>
                                        <span class="cm-text"><ChatText Text="@m.Message" /></span>
                                    </div>
                                }
                                else
                                {
                                    <div class="chat-msg sys"><span class="cm-sys"><ChatText Text="@m.Message" /></span></div>
                                }
                            }
                        }
                        <div @ref="_chatEnd"></div>
                    </div>
                    <div class="chat-input">
                        <input class="ci-field" maxlength="200" placeholder="@T("GameLobby.ChatPlaceholder", "Room message, Enter to send…")"
                               value="@_draft" @oninput="OnDraftInput" @onkeydown="OnChatKeyDown" />
                        <button class="mb-btn primary ci-send" @onclick="OnSend">@T("Lobby.Send", "Send")</button>
                    </div>
                </section>
            </div>
        }
    </div>
}

@code {
    /// <summary>文案查表（Resx / 原版 Translation.ini），缺失时用英文原文兜底。</summary>
    private static string T(string key, string fallback) => UiText.T(key, fallback);

    /// <summary>带参数的文案（占位符 {0}…）。</summary>
    private static string F(string key, string fallback, params object[] args)
        => string.Format(UiText.T(key, fallback), args);

    private const int MAX_VISIBLE_MESSAGES = 300;

    private string _draft = string.Empty;
    private ElementReference _chatEnd;
    private bool _scrollToBottom;
    private int _lastMessageCount;
    private DotNetObjectReference<LanGame>? _dotNetRef;

    private List<ColorOption> _colors = new();
    private string[] _sides = Array.Empty<string>();
    private string[] Sides => _sides;

    private bool HasSelf => Self is not null;

    private LANPlayerInfo? Self =>
        Room.Players.FirstOrDefault(p => IsSelf(p));

    private bool IsSelf(LANPlayerInfo p)
        => string.Equals(p.Name, ProgramConstants.PLAYERNAME, StringComparison.OrdinalIgnoreCase);

    private List<ChatMessage> RoomMessages
    {
        get
        {
            var messages = Room.ChatMessages;
            if (messages.Count == 0)
                return [];
            return messages.Count > MAX_VISIBLE_MESSAGES
                ? messages.Skip(messages.Count - MAX_VISIBLE_MESSAGES).ToList()
                : messages.ToList();
        }
    }

    private List<MapOption> _mapOptions = new();

    /// <summary>游戏选项：复选框（按 LANGameLobby.ini 的 [GameOptionsPanel] 声明顺序）。</summary>
    private List<GameSessionCheckBoxOption> CheckBoxOptions =>
        Room.GameOptions.OfType<GameSessionCheckBoxOption>().ToList();

    /// <summary>游戏选项：下拉框（cmbCredits / cmbStartingUnits / cmbGameSpeedCapMultiplayer 等）。</summary>
    private List<GameSessionDropDownOption> DropDownOptions =>
        Room.GameOptions.OfType<GameSessionDropDownOption>().ToList();

    private void OnCheckBoxOptionChange(GameSessionCheckBoxOption opt, ChangeEventArgs e)
    {
        if (!Room.IsHost)
            return;
        if (bool.TryParse(e.Value?.ToString(), out bool v))
            Room.SetCheckBoxOption(opt, v);
    }

    private void OnDropDownOptionChange(GameSessionDropDownOption dd, ChangeEventArgs e)
    {
        if (!Room.IsHost)
            return;
        if (int.TryParse(e.Value?.ToString(), out int v))
            Room.SetDropDownOption(dd, v);
    }

    /// <summary>当前选择的游戏模式（原版 cmbGameMode，按 MapLoader.GameModes 的 INI 顺序）。</summary>
    private string _selectedMode = string.Empty;

    /// <summary>模式下拉选项（只列出有地图的模式）。</summary>
    private List<string> ModeOptions => MapLoader.GameModes
        .Where(gm => MapLoader.GameModeMaps.Any(gmm => gmm.GameMode.UIName == gm.UIName))
        .Select(gm => gm.UIName)
        .ToList();

    /// <summary>地图加载完成前模式为空；加载后默认选中第一个模式。</summary>
    private void EnsureSelectedMode()
    {
        if (_selectedMode.Length > 0 || ModeOptions.Count == 0)
            return;
        _selectedMode = ModeOptions[0];
    }

    private void OnModeChange(ChangeEventArgs e)
    {
        _selectedMode = e.Value?.ToString() ?? string.Empty;
        RefreshMaps();

        // 当前选中地图不属于新模式时，自动选新模式第一张图（原版 cmbGameMode 切换语义）
        if (Room.SelectedMap is not null
            && _selectedMode.Length > 0
            && Room.SelectedMap.GameMode.UIName != _selectedMode
            && _mapOptions.Count > 0)
        {
            try
            {
                Room.ChangeMap(_mapOptions[0].Value);
            }
            catch (Exception ex)
            {
                _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
            }
        }
    }

    private int SelectedMapIndex
    {
        get
        {
            if (Room.SelectedMap is null)
                return -1;
            for (int i = 0; i < _mapOptions.Count; i++)
            {
                if (_mapOptions[i].Value == Room.SelectedMap)
                    return i;
            }
            return -1;
        }
    }

    private List<SpawnPointState> SpawnPoints => Room.GetSpawnPointStates();

    private string LocalGameName => Room.LocalGame?.UIName ?? "—";

    protected override void OnInitialized()
    {
        _colors = LoadColorsSafe();
        _sides = ClientConfiguration.Instance.Sides.Split(',', StringSplitOptions.RemoveEmptyEntries);
        if (_sides.Length == 0)
            _sides = new[] { "GDI", "Nod", "Allies", "Soviet" };

        Room.Changed += OnChanged;
        ThemeProvider.ThemeChanged += OnThemeChanged;
        MapLoader.MapLoadingComplete += OnMapLoadingComplete;
        TranslationSvc.LanguageChanged += OnLanguageChanged;
        RefreshMaps();
        EnterRoom();
    }

    private static List<ColorOption> LoadColorsSafe()
    {
        try
        {
            var colors = MultiplayerColor.LoadColors();
            return colors.Select(c => new ColorOption(c.Name, c.GameColorIndex, c.XnaColor)).ToList();
        }
        catch
        {
            // 回退默认色板
        }
        return new List<ColorOption>
        {
            new(T("Skirmish.Color.Red", "Red"), 0, new Rgba32(255, 60, 60, 255)),
            new(T("Skirmish.Color.Blue", "Blue"), 1, new Rgba32(70, 120, 255, 255)),
            new(T("Skirmish.Color.Teal", "Teal"), 2, new Rgba32(80, 220, 255, 255)),
            new(T("Skirmish.Color.Green", "Green"), 3, new Rgba32(80, 220, 120, 255)),
            new(T("Skirmish.Color.Yellow", "Yellow"), 4, new Rgba32(255, 220, 80, 255)),
            new(T("Skirmish.Color.Orange", "Orange"), 5, new Rgba32(255, 150, 60, 255)),
            new(T("Skirmish.Color.Purple", "Purple"), 6, new Rgba32(190, 120, 255, 255)),
            new(T("Skirmish.Color.Pink", "Pink"), 7, new Rgba32(255, 130, 200, 255)),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("cncnet.initLobbyKeyNav", _dotNetRef);
        }
        else if (_scrollToBottom && _chatEnd.Id is not null)
        {
            _scrollToBottom = false;
            await JS.InvokeVoidAsync("cncnet.scrollToBottom", _chatEnd);
        }
    }

    /// <summary>读取 LAN 大厅传入的创建/加入请求并进入房间（用后即清）。</summary>
    private void EnterRoom()
    {
        try
        {
            if (NavData.PendingCreate is { Length: > 0 } roomName)
            {
                Room.CreateGame(roomName);
                return;
            }
            if (NavData.PendingJoin is { } join)
            {
                Room.JoinGame(join);
                return;
            }
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
        finally
        {
            NavData.PendingCreate = null;
            NavData.PendingJoin = null;
        }
    }

    private void RefreshMaps()
    {
        IEnumerable<MapOption> query = MapLoader.GameModeMaps
            .Select((gmm, i) => new MapOption(gmm, i, gmm.GameMode.UIName, gmm.ToUIString()));

        // 游戏模式过滤（原版 cmbGameMode：只显示当前模式的地图）
        EnsureSelectedMode();
        if (_selectedMode.Length > 0)
            query = query.Where(o => o.Mode == _selectedMode);

        _mapOptions = query.Select((o, i) => o with { Index = i }).ToList();
    }

    private void OnMapLoadingComplete(object? sender, EventArgs e) =>
        _ = InvokeAsync(() =>
        {
            RefreshMaps();
            StateHasChanged();
        });

    private void OnChanged()
    {
        var count = Room.ChatMessages.Count;
        _scrollToBottom = count != _lastMessageCount;
        _lastMessageCount = count;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged(ThemeInfo theme) => _ = InvokeAsync(StateHasChanged);

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    // ── 顶部操作 ──

    private async Task OnLeave()
    {
        var confirm = await MessageBox.ShowAsync(T("GameLobby.LeaveRoom", "Leave room"),
            T("LanGame.LeaveBody", "Leave the current LAN room?"), MessageBoxButtons.YesNo, MessageBoxKind.Confirm);
        if (!confirm)
            return;
        Room.LeaveGame();
        await JS.InvokeVoidAsync("cncnet.toast", T("GameLobby.Left", "Left the room"));
        Nav.NavigateTo("/lan/lobby");
    }

    private void BackToLobby() => Nav.NavigateTo("/lan/lobby");

    // ── 地图（房主） ──

    private void SelectMap(int index)
    {
        if (index < 0 || index >= _mapOptions.Count)
            return;
        Room.ChangeMap(_mapOptions[index].Value);
    }

    private void OnMapChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int index))
            return;
        SelectMap(index);
    }

    private void OnMapListItemClick(int index) => SelectMap(index);

    // ── 规则（房主） ──

    private void OnToggleLock() => Room.ToggleLock();

    // ── 我的配置 ──

    private void OnSideChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
            ApplyOwnOptions(v, Self!.ColorId, Self.StartingLocation, Self.TeamId);
    }

    private void OnStartChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
            ApplyOwnOptions(Self!.SideId, Self.ColorId, v, Self.TeamId);
    }

    private void OnTeamChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
            ApplyOwnOptions(Self!.SideId, Self.ColorId, Self.StartingLocation, v);
    }

    private void SetColor(int colorIndex) =>
        ApplyOwnOptions(Self!.SideId, colorIndex, Self.StartingLocation, Self.TeamId);

    private void OnSpawnClick(int index)
    {
        var sp = SpawnPoints.FirstOrDefault(s => s.Index == index);
        if (sp is null)
            return;
        if (sp.OccupantName is not null && !sp.IsSelf)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", F("Skirmish.SpawnOccupied", "Spawn {0} is already occupied by {1}", index, sp.OccupantName));
            return;
        }
        ApplyOwnOptions(Self!.SideId, Self.ColorId, index, Self.TeamId);
    }

    private void ApplyOwnOptions(int side, int color, int start, int team)
    {
        try
        {
            Room.ChangeOwnOptions(side, color, start, team);
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
    }

    private void OnToggleReady()
    {
        try
        {
            Room.ToggleReady();
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
    }

    private void OnStartGame()
    {
        try
        {
            Room.StartGame();
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
    }

    // ── 房间聊天 ──

    private void OnDraftInput(ChangeEventArgs e) => _draft = e.Value?.ToString() ?? string.Empty;

    private void OnChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            OnSend();
    }

    private void OnSend()
    {
        if (string.IsNullOrWhiteSpace(_draft))
            return;
        Room.SendRoomChat(_draft);
        _draft = string.Empty;
    }

    [JSInvokable]
    public Task OnLobbyEsc()
    {
        _ = OnLeave();
        return Task.CompletedTask;
    }

    private string GetSideName(int side) =>
        side >= 0 && side < Sides.Length ? Sides[side] : F("GameLobby.SideIndex", "Side {0}", side);

    private Rgba32 GetColor(int index) =>
        (_colors.FirstOrDefault(c => c.Index == index) ?? _colors.FirstOrDefault())?.Color
        ?? new Rgba32(160, 220, 255, 255);

    private static string ToCss(Rgba32 color) => $"rgb({color.R},{color.G},{color.B})";

    public void Dispose()
    {
        Room.Changed -= OnChanged;
        ThemeProvider.ThemeChanged -= OnThemeChanged;
        MapLoader.MapLoadingComplete -= OnMapLoadingComplete;
        TranslationSvc.LanguageChanged -= OnLanguageChanged;
        if (_dotNetRef is not null)
        {
            _ = JS.InvokeVoidAsync("cncnet.disposeLobbyKeyNav");
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }

    private sealed record MapOption(GameModeMap Value, int Index, string Mode, string Display);
    private sealed record ColorOption(string Name, int Index, Rgba32 Color);
}
