@page "/lan/loading"
@implements IDisposable
@using System.Threading
@using CnCNetClient.Core
@inject LanGameRoomService Room
@inject NavigationManager Nav
@inject MessageBoxService MessageBox
@inject ITranslationService TranslationSvc

@if (!Room.IsInGameRoom)
{
    <div class="game-empty page-anim">
        <div class="ge-box pop-in">
            <div class="ge-title">LAN LOADING</div>
            <div class="ge-sub">@T("Loading.NoActiveGame", "No match in progress")</div>
            <button class="mb-btn primary" @onclick="BackToLobby">@T("GameLobby.BackToLobby", "Back to lobby")</button>
        </div>
    </div>
}
else
{
    <div class="gload page-anim">
        <div class="gload-center pop-in">
            <!-- 雷达式加载环（与在线加载页同款） -->
            <div class="gload-radar">
                <div class="radar-ring r1"></div>
                <div class="radar-ring r2"></div>
                <div class="radar-ring r3"></div>
                <div class="radar-sweep"></div>
                <div class="radar-core">
                    <span class="rc-en">LAN SPAWN</span>
                    <span class="rc-cn">@T("Loading.RadarLan", "LAN Match")</span>
                </div>
            </div>

            <div class="gload-title">LAN GAME LOADING</div>
            <div class="gload-sub">@T("Loading.SubLan", "LAN match loading · Please wait")</div>

            <div class="gload-info">
                <div class="gi-row"><span>@T("Loading.Room", "Room")</span><b>@Room.RoomName</b></div>
                <div class="gi-row"><span>GameID</span><b>#@Room.UniqueGameId</b></div>
                <div class="gi-row"><span>@T("Lobby.Map", "Map")</span><b>@(Room.SelectedMap?.Map.UntranslatedName ?? "—")</b></div>
                <div class="gi-row"><span>@T("Lobby.Mode", "Mode")</span><b>@(Room.SelectedMap?.GameMode.UIName ?? "—")</b></div>
                <div class="gi-row"><span>@T("Lobby.Player", "Player")</span><b>@F("Lobby.NPlayers", "{0} players", Room.Players.Count)</b></div>
            </div>

            <div class="gload-status">
                <span class="gs-dot"></span>
                @T("Loading.ProcessStarted", "Game process started, window minimized · ")@T("Loading.ReturnRoom", "You will return to the room after the match (running ")<b>@ElapsedSeconds</b>@T("Loading.SecondsSuffix", "s)")
            </div>

            <div class="gload-actions">
                <button class="mb-btn" @onclick="BackToLobby">@T("GameLobby.BackToLobby", "Back to lobby")</button>
            </div>
        </div>
    </div>
}

@code {
    private Timer? _timer;
    private int _elapsedSeconds;

    private int ElapsedSeconds => _elapsedSeconds;

    private static string T(string key, string fallback) => UiText.T(key, fallback);
    private static string F(string key, string fallback, params object[] args) => string.Format(UiText.T(key, fallback), args);

    protected override void OnInitialized()
    {
        // 对局进行中计时显示；每秒刷新一次
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            _elapsedSeconds++;
            StateHasChanged();
        }), null, 1000, 1000);

        TranslationSvc.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task BackToLobby()
    {
        if (Room.IsInGameRoom)
        {
            var confirm = await MessageBox.ShowAsync(T("GameLobby.BackToLobby", "Back to lobby"),
                T("Loading.LeaveRoomBody", "A match is still in progress. Returning to the lobby will leave the current room. Continue?"),
                MessageBoxButtons.YesNo, MessageBoxKind.Confirm);
            if (!confirm)
                return;
            Room.LeaveGame();
        }
        Nav.NavigateTo("/lan/lobby");
    }

    public void Dispose()
    {
        TranslationSvc.LanguageChanged -= OnLanguageChanged;
        _timer?.Dispose();
        _timer = null;
    }
}
