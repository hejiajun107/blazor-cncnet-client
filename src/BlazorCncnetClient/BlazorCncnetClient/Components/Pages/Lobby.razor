    private ChannelUser? FindUser(string? name)
    {
        if (string.IsNullOrEmpty(name))
            return null;
        ChannelUser? found = null;
        CurrentChannel?.Users.DoForAllUsers(u =>
        {
            if (found is null && string.Equals(u.IRCUser.Name, name, StringComparison.OrdinalIgnoreCase))
                found = u;
        });
        return found;
    }

