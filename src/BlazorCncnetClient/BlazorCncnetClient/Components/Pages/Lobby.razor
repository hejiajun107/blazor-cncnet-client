    /// <summary>根据当前草稿（/ 开头）过滤出匹配指令列表，供提示浮层渲染。</summary>
    private List<ChannelCommand> CommandHints
    {
        get
        {
            var trimmed = _draft.Trim();
            if (!trimmed.StartsWith('/') || trimmed.Length < 2)
                return [];
            var input = trimmed.Substring(1).TrimStart();
            var space = input.IndexOf(' ');
            var prefix = space == -1 ? input : input.Substring(0, space);
            if (prefix.Length == 0)
                return LobbySvc.ChannelCommands.ToList();
            return LobbySvc.ChannelCommands
                .Where(c => c.Command.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    /// <summary>点击提示项：将指令补全到输入框并聚焦参数输入。</summary>
    private void ApplyCommandHint(ChannelCommand command) => _draft = $"/{command.Command} ";

