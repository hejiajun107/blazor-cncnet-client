    /// 房间列表的地图名：房主广播的是未翻译原文，本机装了同一张图时换成当前语言的名字
    /// （未安装则原样显示，由进入房间的缺失地图提示处理）。
    /// </summary>
    private string DisplayMap(LobbyGameItem game) => MapLoader.GetLocalizedMapName(game.MapHash, game.Map);

