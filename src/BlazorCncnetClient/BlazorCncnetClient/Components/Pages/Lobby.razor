            "确认退出 CnCNet 在线大厅？", MessageBoxButtons.YesNo, MessageBoxKind.Confirm);
        if (!confirm)
            return;
        LobbySvc.Logout();
        await JS.InvokeVoidAsync("cncnet.toast", "已离开大厅");
        Nav.NavigateTo("/menu");
    }

    private static string ToCss(Rgba32 color) => $"rgb({color.R},{color.G},{color.B})";

    public void Dispose()
    {
        LobbySvc.Changed -= OnChanged;
        LobbySvc.PmChanged -= OnPmChanged;
        LobbySvc.PmReceived -= OnPmReceived;
        ThemeProvider.ThemeChanged -= OnThemeChanged;
        Mon.StateChanged -= OnMonConnectionChanged;
        _renderThrottle?.Dispose();
        _renderThrottle = null;
        if (_dotNetRef is not null)
        {
            _ = JS.InvokeVoidAsync("cncnet.disposeLobbyKeyNav");
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }
