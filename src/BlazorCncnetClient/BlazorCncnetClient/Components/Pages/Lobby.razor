@page "/online/lobby"
@implements IDisposable
@using CnCNetClient.Core
@using CnCNetClient.Online
@using CnCNetClient.Domain.Multiplayer.CnCNet
@using SixLabors.ImageSharp.PixelFormats
@inject LobbyService LobbySvc
@inject GameRoomNavigation NavData
@inject ConnectionMonitor Mon
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IThemeProvider ThemeProvider
@inject MessageBoxService MessageBox
@inject DiscordPresenceService Discord

<div class="lobby page-anim">
    <header class="lobby-top item-in">
        <div class="lt-left">
            <span class="lt-t">频道</span>
            <select class="lt-select" value="@CurrentChannelName" @onchange="OnChannelChanged">
                @foreach (var c in LobbySvc.Channels)
                {
                    <option value="@c.ChannelName">@c.UIName · @c.ChannelName (@c.Users.Count)</option>
                }
            </select>
        </div>
        <div class="lt-mid">
            <span class="lt-title">CNCNet 在线大厅</span>
            <span class="lt-en">ONLINE LOBBY · @(LobbySvc.LocalGame?.UIName ?? "CnCNet")</span>
        </div>
        <div class="lt-right">
            <span class="lt-player">@ProgramConstants.PLAYERNAME</span>
            <span class="lt-conn @Mon.StatusClass"><i class="dot"></i>@Mon.StateCn@(Mon.IsConnected ? $" · {OnlineCount} 在线" : "")</span>
            <button class="mb-btn item-in" @onclick="OnLogout">离开</button>
        </div>
    </header>

    <div class="lobby-grid">
        <section class="lb-panel lb-games item-in" style="animation-delay:60ms">
            <header class="lb-ph">
                <span>房间列表 <em>@FilteredGames.Count</em></span>
                <div class="lb-ph-actions">
                    <input class="lb-search" placeholder="筛选房间…" value="@_gameFilter" @oninput="OnGameFilterInput" />
                    <button class="mb-btn primary lb-create" @onclick="OpenCreateDialog">创建房间</button>
                </div>
            </header>
            <div class="lb-filters">
                <label class="fl-chip @(_friendsOnly ? "on" : "")" title="只显示好友开的房间">
                    <input type="checkbox" @bind="_friendsOnly" /><i></i>好友专用
                </label>
                <label class="fl-chip @(_hideLocked ? "on" : "")" title="隐藏已锁定房间">
                    <input type="checkbox" @bind="_hideLocked" /><i></i>隐藏锁定
                </label>
                <label class="fl-chip @(_hidePassworded ? "on" : "")" title="隐藏密码房">
                    <input type="checkbox" @bind="_hidePassworded" /><i></i>隐藏密码
                </label>
                <label class="fl-chip @(_hideIncompatible ? "on" : "")" title="隐藏版本不一致的房间">
                    <input type="checkbox" @bind="_hideIncompatible" /><i></i>隐藏不兼容
                </label>
                <select class="fl-select" value="@_maxPlayersFilter" @onchange="OnMaxPlayersFilterChange">
                    <option value="0">全部人数</option>
                    @for (int p = 2; p <= 8; p++)
                    {
                        <option value="@p">@p 人</option>
                    }
                </select>
                <button type="button" class="fl-reset" @onclick="ResetFilters" title="重置全部筛选">重置</button>
            </div>
            <div class="lb-body">
                @if (FilteredGames.Count == 0)
                {
                    <div class="lb-empty">@(_gameFilter.Length == 0 ? "暂无公开房间" : "无匹配房间")</div>
                }
                else
                {
                    <Virtualize Items="@FilteredGames" Context="g">
                        <div class="game-card @(g.Passworded ? "locked" : "")"
                             @onclick="() => OnGameClick(g)">
                            <div class="gc-preview">
                                <MapThumbnail MapHash="@g.MapHash" MapName="@g.Map" />
                            </div>
                            <div class="gc-top">
                                <span class="gc-name">@(g.Passworded ? "◈ " : "")@g.RoomName</span>
                                <span class="gc-players @(g.IsFull ? "full" : "")">@g.PlayerCount/@g.MaxPlayers</span>
                            </div>
                            <div class="gc-sub" title="@g.Map">@g.Map</div>
                            <div class="gc-meta">
                                <span class="gc-mode">@g.GameMode</span>
                                <span class="gc-host">@g.HostName</span>
                                <span class="gc-tag">@(g.IsLadder ? "天梯" : g.Tunneled ? "隧道" : "动态")</span>
                            </div>
                        </div>
                    </Virtualize>
                }
            </div>
        </section>

        <section class="lb-panel lb-chat item-in" style="animation-delay:110ms">
            <header class="lb-ph">
                <span>频道聊天 <em>@CurrentChannelName</em></span>
            </header>
            @if (!Mon.IsConnected)
            {
                <div class="conn-banner @Mon.StatusClass">
                    @if (Mon.State == ConnectionState.Reconnecting)
                    {
                        <text>⚠ 连接已断开，正在自动重连…</text>
                    }
                    else
                    {
                        <text>⚠ 已与 CnCNet 断开连接</text>
                    }
                    @if (!string.IsNullOrEmpty(Mon.LastError))
                    {
                        <span class="cb-reason">@Mon.LastError</span>
                    }
                </div>
            }
            <div class="chat-scroll">
                @if (VisibleMessages.Count == 0)
                {
                    <div class="lb-empty">尚无消息，打个招呼吧</div>
                }
                else
                {
                    @foreach (var m in VisibleMessages)
                    {
                        <div class="chat-msg @(m.IsUser ? "user" : "sys")">
                            @if (m.IsUser)
                            {
                                <span class="cm-time">@m.DateTime.ToString("HH:mm")</span>
                                <span class="cm-name" style="color:@ToCss(m.Color)"
                                      @oncontextmenu="e => OpenContextMenuBySender(m.SenderName, e)">@m.SenderName</span>
                                <span class="cm-text"><ChatText Text="@m.Message" /></span>
                            }
                            else
                            {
                                <span class="cm-sys"><ChatText Text="@m.Message" /></span>
                            }
                        </div>
                    }
                }
                <div @ref="_chatEnd"></div>
            </div>
            <div class="chat-input">
                @if (CommandHints.Count > 0)
                {
                    <div class="cmd-hint pop-in">
                        @foreach (var c in CommandHints)
                        {
                            <div class="cmd-hint-item @(c.RequiresAdmin && !LobbySvc.IsCurrentChannelAdmin ? "locked" : "")"
                                 @onclick="() => ApplyCommandHint(c)">
                                <span class="ch-cmd">/@c.Command</span>
                                <span class="ch-desc">@c.Description</span>
                                @if (c.RequiresAdmin)
                                {
                                    <span class="ch-admin">管理员</span>
                                }
                            </div>
                        }
                    </div>
                }
                <input class="ci-field" maxlength="200" placeholder="输入消息，Enter 发送；/ 开头为频道指令（/help）"
                       value="@_draft" disabled="@(CurrentChannel is null)"
                       @oninput="OnDraftInput" @onkeydown="OnChatKeyDown" />
                <button class="mb-btn primary ci-send" @onclick="OnSend" disabled="@(CurrentChannel is null)">发送</button>
            </div>
        </section>

        <section class="lb-panel lb-users item-in" style="animation-delay:160ms">
            <header class="lb-ph">
                <span>玩家 <em>@Users.Count</em></span>
            </header>
            <div class="lb-body">
                @if (Users.Count == 0)
                {
                    <div class="lb-empty">频道暂无玩家</div>
                }
                else
                {
                    <Virtualize Items="@Users" Context="u">
                        <div class="user-item @(LobbySvc.IsSelf(u.IRCUser.Name) ? "self" : "")"
                             @oncontextmenu="e => OpenContextMenu(u, e)"
                             @onclick="() => OpenContextMenu(u, null)">
                            <span class="u-mark">@(u.IsAdmin ? "@" : u.HasVoice ? "+" : "·")</span>
                            <span class="u-name">@u.IRCUser.Name</span>
                            @if (u.IsFriend)
                            {
                                <span class="u-friend">★</span>
                            }
                            @if (u.IRCUser.IsIgnored)
                            {
                                <span class="u-ignored">屏蔽</span>
                            }
                        </div>
                    </Virtualize>
                }
            </div>
        </section>
        @* F4 追加型槽位：插件面板（.lobby-grid 为三列网格；插件可用 grid-column:1/-1 占满整行） *@
        <PluginSlot Key="page.lobby.aside" />
    </div>

    @if (_menuOpen && _menuUser is not null)
    {
        <div class="ctx-backdrop" @onclick="CloseContextMenu" @oncontextmenu="CloseContextMenu"
             @oncontextmenu:preventDefault="true"></div>
        <div class="ctx-menu pop-in" style="left:@(_menuX)px;top:@(_menuY)px"
             @onmousedown:stopPropagation="true" @oncontextmenu:stopPropagation="true">
            <div class="ctx-title">@_menuUser.IRCUser.Name</div>
            <button type="button" class="ctx-item" @onclick="OnPrivateMessage">私聊<span class="en">PM</span></button>
            <button type="button" class="ctx-item" disabled="@(!LobbySvc.CanInvite)" @onclick="OnInvite">
                邀请加入<span class="en">INVITE</span></button>
            @if (LobbySvc.IsCurrentChannelAdmin)
            {
                <div class="ctx-sep"></div>
                <button type="button" class="ctx-item warn" @onclick="OnKickPlayer">
                    踢出频道<span class="en">KICK</span></button>
                <button type="button" class="ctx-item warn" @onclick="OnBanPlayer">
                    封禁<span class="en">BAN</span></button>
                <button type="button" class="ctx-item warn" @onclick="OnToggleMute">
                    @(_menuUser.HasVoice ? "禁言" : "解除禁言")<span class="en">@(_menuUser.HasVoice ? "MUTE" : "VOICE")</span></button>
            }
            <div class="ctx-sep"></div>
            <button type="button" class="ctx-item" @onclick="OnToggleFriend">
                @(_menuUser.IRCUser.IsFriend ? "取消加友" : "加为好友")<span class="en">FRIEND</span></button>
            <button type="button" class="ctx-item" @onclick="OnToggleIgnore">
                @(_menuUser.IRCUser.IsIgnored ? "取消屏蔽" : "屏蔽此人")<span class="en">IGNORE</span></button>
        </div>
    }

    @if (_pmOpen)
    {
        <div class="ctx-backdrop" @onclick="ClosePm"></div>
        <div class="pm-panel pop-in">
            <div class="pm-head">
                <span>私聊中心</span><span class="pm-en">PRIVATE MSG</span>
                <button type="button" class="pm-close" @onclick="ClosePm" aria-label="关闭">✕</button>
            </div>
            <!-- 第七轮补缺：私聊 / 最近玩家 双 tab（原版 PrivateMessagingWindow 双标签） -->
            <div class="pm-mode">
                <button type="button" class="pm-mode-btn @(!_pmRecentTab ? "active" : "")" @onclick="() => SwitchPmTab(false)">私聊</button>
                <button type="button" class="pm-mode-btn @(_pmRecentTab ? "active" : "")" @onclick="() => SwitchPmTab(true)">最近玩家</button>
            </div>
            @if (!_pmRecentTab)
            {
                @if (LobbySvc.PmSessions.Count == 0)
                {
                    <div class="pm-empty">暂无私聊会话</div>
                }
                else
                {
                    <div class="pm-tabs">
                        @foreach (var s in LobbySvc.PmSessions)
                        {
                            <div class="pm-tab @(string.Equals(s.UserName, _activePmName, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                 @onclick="() => ActivatePm(s.UserName)">
                                <span class="pt-name">@s.UserName</span>
                                @if (s.UnreadCount > 0)
                                {
                                    <span class="pt-badge">@s.UnreadCount</span>
                                }
                                <button type="button" class="pt-close" @onclick="() => ClosePmSession(s.UserName)"
                                        @onclick:stopPropagation="true" aria-label="关闭会话">✕</button>
                            </div>
                        }
                    </div>
                }
                @if (ActivePmSession is { } active)
                {
                    <div class="pm-body">
                        @if (active.Messages.Count == 0)
                        {
                            <div class="pm-empty">尚无消息，说点什么吧</div>
                        }
                        else
                        {
                            @foreach (var m in active.Messages)
                            {
                                <div class="pm-msg @(m.IsMine ? "mine" : "")">
                                    <span class="pm-time">@m.Time.ToString("HH:mm")</span>
                                    <span class="pm-name">@(m.IsMine ? "我" : m.SenderName)</span>
                                    <span class="pm-text"><ChatText Text="@m.Text" /></span>
                                </div>
                            }
                        }
                        <div @ref="_pmChatEnd"></div>
                    </div>
                    <div class="pm-input">
                        <input class="pm-field" maxlength="200" placeholder="输入消息，Enter 发送…"
                               value="@_pmDraft" @oninput="OnPmInput" @onkeydown="OnPmKeyDown" />
                        <button type="button" class="mb-btn primary" @onclick="OnPmSend">发送</button>
                    </div>
                }
            }
            else
            {
                <div class="rp-head">
                    <span class="rp-col">玩家</span>
                    <span class="rp-col">游戏</span>
                    <span class="rp-col">时间</span>
                </div>
                <div class="rp-body">
                    @if (RecentPlayersList.Count == 0)
                    {
                        <div class="pm-empty">暂无最近玩家记录（参与对局后自动记录）</div>
                    }
                    else
                    {
                        @foreach (var rp in RecentPlayersList)
                        {
                            var isOnline = LobbySvc.OnlineUsers.Any(u =>
                                string.Equals(u.Name, rp.PlayerName, StringComparison.OrdinalIgnoreCase));
                            <div class="rp-item @(isOnline ? "online" : "offline")"
                                 @onclick="() => OpenRecentPlayerMenu(rp.PlayerName)"
                                 @oncontextmenu="(e) => OpenRecentPlayerMenu(rp.PlayerName, e)"
                                 @oncontextmenu:preventDefault="true">
                                <span class="rp-name">@rp.PlayerName</span>
                                <span class="rp-game">@rp.GameName</span>
                                <span class="rp-time">@rp.GameTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }

    @if (_rpMenuOpen && _rpMenuPlayer is not null)
    {
        <div class="ctx-backdrop" @onclick="CloseRpmMenu" @oncontextmenu="CloseRpmMenu"
             @oncontextmenu:preventDefault="true"></div>
        <div class="ctx-menu pop-in" style="left:@(_rpMenuX)px;top:@(_rpMenuY)px"
             @onmousedown:stopPropagation="true" @oncontextmenu:stopPropagation="true">
            <div class="ctx-title">@_rpMenuPlayer</div>
            <button type="button" class="ctx-item" @onclick="OnRpmPrivateMessage">私聊<span class="en">PM</span></button>
            <div class="ctx-sep"></div>
            <button type="button" class="ctx-item" @onclick="OnRpmToggleFriend">
                @(LobbySvc.IsFriend(_rpMenuPlayer) ? "取消加友" : "加为好友")<span class="en">FRIEND</span></button>
            <button type="button" class="ctx-item" @onclick="OnRpmToggleIgnore">
                @(LobbySvc.IsIgnored(_rpMenuPlayer, null) ? "取消屏蔽" : "屏蔽此人")<span class="en">IGNORE</span></button>
        </div>
    }

    @if (_selectedGame is not null)
    {
        <div class="ctx-backdrop" @onclick="CloseGameDetail"></div>
        <div class="game-detail pop-in">
            <header class="gd-head">
                <span class="gd-name">@(_selectedGame.Passworded ? "◈ " : "")@_selectedGame.RoomName</span>
                <button type="button" class="gd-close" @onclick="CloseGameDetail" aria-label="关闭">✕</button>
            </header>
            <div class="gd-map">
                <MapThumbnail MapHash="@_selectedGame.MapHash" MapName="@_selectedGame.Map" />
            </div>
            <div class="gd-rows">
                <div class="gd-row"><span>地图</span><b>@_selectedGame.Map</b></div>
                <div class="gd-row"><span>房主</span><b>@_selectedGame.HostName</b></div>
                <div class="gd-row"><span>模式</span><b>@_selectedGame.GameMode</b></div>
                <div class="gd-row"><span>人数</span><b>@_selectedGame.PlayerCount / @_selectedGame.MaxPlayers</b></div>
                <div class="gd-row"><span>类型</span><b>@(_selectedGame.IsLadder ? "天梯" : _selectedGame.Tunneled ? "隧道" : "动态")</b></div>
                @if (_selectedGame.Passworded)
                {
                    <div class="gd-row"><span>密码</span><b class="gd-pass">已加密</b></div>
                }
            </div>
            <div class="gd-actions">
                <button type="button" class="mb-btn primary" @onclick="OnJoinGame">加入游戏</button>
                <button type="button" class="mb-btn" @onclick="CloseGameDetail">取消</button>
            </div>
        </div>
    }

    @if (_createOpen)
    {
        <div class="ctx-backdrop" @onclick="CloseCreateDialog"></div>
        <div class="cr-panel pop-in">
            <div class="cr-head">创建房间<span class="cr-en">CREATE ROOM</span></div>
            <label class="cr-field">
                <span>房间名</span>
                <input maxlength="40" value="@_createRoomName" @oninput="OnCreateRoomNameInput" />
            </label>
            <div class="cr-row">
                <label class="cr-field">
                    <span>最大人数</span>
                    <select value="@_createMaxPlayers" @onchange="OnCreateMaxPlayersChange">
                        @for (int p = 2; p <= 8; p++)
                        {
                            <option value="@p">@p 人</option>
                        }
                    </select>
                </label>
                <label class="cr-field">
                    <span>密码（可选）</span>
                    <input maxlength="32" placeholder="留空为公开房" value="@_createPassword" @oninput="OnCreatePasswordInput" />
                </label>
            </div>
            <div class="cr-actions">
                <button type="button" class="mb-btn" @onclick="CloseCreateDialog">取消</button>
                <button type="button" class="mb-btn primary" @onclick="OnCreateGame">创建</button>
            </div>
        </div>
    }

    @if (_joinPwOpen && _selectedGame is not null)
    {
        <div class="ctx-backdrop" @onclick="CloseJoinPw"></div>
        <div class="cr-panel pop-in">
            <div class="cr-head">加入房间 · <b>@_selectedGame.RoomName</b><span class="cr-en">ENTER PASSWORD</span></div>
            <label class="cr-field">
                <span>房间密码</span>
                <input maxlength="32" value="@_joinPassword" @oninput="OnJoinPasswordInput"
                       @onkeydown="OnJoinPwKeyDown" autocomplete="off" />
            </label>
            <div class="cr-actions">
                <button type="button" class="mb-btn" @onclick="CloseJoinPw">取消</button>
                <button type="button" class="mb-btn primary" @onclick="OnJoinWithPassword">加入</button>
            </div>
        </div>
    }
</div>

@code {
    private const int MAX_VISIBLE_MESSAGES = 300;

    /// <summary>M4.9 渲染节流窗口：高频网络事件（刷屏聊天/广播）合并为一次 DOM 更新，保证 60fps。</summary>
    private const int RENDER_THROTTLE_MS = 66;

    private string _draft = string.Empty;
    private string _gameFilter = string.Empty;

    // 2-1 房间筛选（原版 GameFiltersPanel）
    private bool _friendsOnly;
    private bool _hideLocked;
    private bool _hidePassworded;
    private bool _hideIncompatible;
    private int _maxPlayersFilter;

    private ElementReference _chatEnd;
    private bool _scrollToBottom;
    private int _lastMessageCount;

    // M4.9：OnlineCount 懒计算缓存（Changed 时失效），避免每次渲染遍历全频道用户
    private int _onlineCount = -1;

    // M4.9：渲染节流（Interlocked 标志，Timer 回调仅翻转标志并触发渲染）
    private System.Threading.Timer? _renderThrottle;
    private int _renderScheduled;

    // M3.3 右键菜单 / 私聊中心状态（M3.8 多标签）
    private ChannelUser? _menuUser;
    private bool _menuOpen;
    private double _menuX;
    private double _menuY;
    private bool _pmOpen;
    private string? _activePmName;
    private string _pmDraft = string.Empty;
    private ElementReference _pmChatEnd;
    private bool _pmScroll;
    private DotNetObjectReference<Lobby>? _dotNetRef;

    // 第七轮补缺 r7-5：私聊中心「最近玩家」tab（原版 PrivateMessagingWindow 双标签）及独立右键菜单
    private bool _pmRecentTab;
    private string? _rpMenuPlayer;
    private bool _rpMenuOpen;
    private double _rpMenuX;
    private double _rpMenuY;

    // M3.4 选中房间信息面板（地图预览）
    private LobbyGameItem? _selectedGame;

    // M3.5 创建房间 / 加入密码对话框
    private bool _createOpen;
    private string _createRoomName = string.Empty;
    private int _createMaxPlayers = 8;
    private string _createPassword = string.Empty;
    private bool _joinPwOpen;
    private string _joinPassword = string.Empty;

    private Channel? CurrentChannel => LobbySvc.CurrentChannel;
    private string CurrentChannelName => CurrentChannel?.ChannelName ?? "—";

    private int OnlineCount
    {
        get
        {
            if (_onlineCount >= 0)
                return _onlineCount;
            var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var c in LobbySvc.Channels)
                c.Users.DoForAllUsers(u => names.Add(u.IRCUser.Name));
            _onlineCount = names.Count;
            return _onlineCount;
        }
    }

    private List<ChatMessage> VisibleMessages
    {
        get
        {
            var messages = CurrentChannel?.Messages;
            if (messages is null || messages.Count == 0)
                return [];
            return messages.Count > MAX_VISIBLE_MESSAGES
                ? messages.GetRange(messages.Count - MAX_VISIBLE_MESSAGES, MAX_VISIBLE_MESSAGES)
                : messages;
        }
    }

    private List<ChannelUser> Users
    {
        get
        {
            var list = new List<ChannelUser>();
            CurrentChannel?.Users.DoForAllUsers(list.Add);
            list.Sort(ChannelUser.ChannelUserComparison);
            return list;
        }
    }

    private List<LobbyGameItem> FilteredGames
    {
        get
        {
            IEnumerable<LobbyGameItem> query = LobbySvc.Games;

            // 2-1 房间筛选面板（原版 GameFiltersPanel）
            if (_friendsOnly)
                query = query.Where(g => LobbySvc.IsFriend(g.HostName));
            if (_hideLocked)
                query = query.Where(g => !g.Locked);
            if (_hidePassworded)
                query = query.Where(g => !g.Passworded);
            if (_hideIncompatible)
                query = query.Where(g => g.IsVersionCompatible);
            if (_maxPlayersFilter > 0)
                query = query.Where(g => g.MaxPlayers == _maxPlayersFilter);

            var filter = _gameFilter.Trim();
            if (filter.Length > 0)
            {
                query = query.Where(g => g.RoomName.Contains(filter, StringComparison.OrdinalIgnoreCase)
                                        || g.Map.Contains(filter, StringComparison.OrdinalIgnoreCase)
                                        || g.HostName.Contains(filter, StringComparison.OrdinalIgnoreCase)
                                        || g.GameMode.Contains(filter, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    // M3.8 私聊中心：当前激活会话
    private PmSession? ActivePmSession =>
        _activePmName is null ? null : LobbySvc.FindPmSession(_activePmName);

    protected override void OnInitialized()
    {
        LobbySvc.Changed += OnChanged;
        LobbySvc.PmChanged += OnPmChanged;
        LobbySvc.PmReceived += OnPmReceived;
        ThemeProvider.ThemeChanged += OnThemeChanged;
        // 连接状态变化时刷新左侧状态条（lt-conn），否则停留在进入页面时的旧值（顶栏/底栏已实时刷新）
        Mon.StateChanged += OnMonConnectionChanged;

        // 2-2 从在线房间跳转而来：?pm=<昵称> 直达私聊会话
        var pmName = GetQueryParam(Nav.ToAbsoluteUri(Nav.Uri), "pm");
        if (!string.IsNullOrWhiteSpace(pmName))
        {
            LobbySvc.OpenPmSession(pmName);
            _activePmName = pmName;
        }

        // r9-4：Discord 呈现恢复为「In Client」（从游戏房间/对局返回大厅时覆盖房间状态）
        Discord.MainMenu();
    }

    private static string? GetQueryParam(Uri uri, string key)
    {
        var query = uri.Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2 && string.Equals(kv[0], key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(kv[1]);
        }
        return null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            LobbySvc.Initialize();
            // M3.3：ESC 关闭右键菜单/私聊窗（不导航）
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("cncnet.initLobbyKeyNav", _dotNetRef);
        }
        else if (_scrollToBottom && _chatEnd.Id is not null)
        {
            _scrollToBottom = false;
            await JS.InvokeVoidAsync("cncnet.scrollToBottom", _chatEnd);
        }
        else if (_pmScroll && _pmChatEnd.Id is not null)
        {
            _pmScroll = false;
            await JS.InvokeVoidAsync("cncnet.scrollToBottom", _pmChatEnd);
        }
    }

    private void OnMonConnectionChanged() => InvokeAsync(StateHasChanged);

    private void OnChanged()
    {
        var count = CurrentChannel?.Messages.Count ?? 0;
        _scrollToBottom = count != _lastMessageCount;
        _lastMessageCount = count;
        _onlineCount = -1;

        // M4.9：66ms 窗口内合并多次网络事件为一次渲染（滚动标记即时更新，保证渲染后停在最新消息）
        if (Interlocked.CompareExchange(ref _renderScheduled, 1, 0) == 1)
            return;
        _renderThrottle = new System.Threading.Timer(_ =>
        {
            Interlocked.Exchange(ref _renderScheduled, 0);
            _ = InvokeAsync(StateHasChanged);
        }, null, RENDER_THROTTLE_MS, System.Threading.Timeout.Infinite);
    }

