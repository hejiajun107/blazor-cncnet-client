    private void ActivatePm(string name)
    {
        if (_activePmName is not null && string.Equals(_activePmName, name, StringComparison.OrdinalIgnoreCase))
            return;
        _activePmName = name;
        _pmDraft = string.Empty;
        LobbySvc.MarkPmRead(name);
        _pmScroll = true;
    }

    private void ClosePmSession(string name)
    {
        var activeWas = _activePmName is not null
            && string.Equals(_activePmName, name, StringComparison.OrdinalIgnoreCase);
        LobbySvc.ClosePmSession(name);
        if (activeWas)
        {
            _activePmName = null;
            _pmDraft = string.Empty;
        }
    }

    private void OnPmSend()
    {
        if (ActivePmSession is not { } session || string.IsNullOrWhiteSpace(_pmDraft))
            return;
        LobbySvc.SendPrivateMessage(session.UserName, _pmDraft);
        _pmDraft = string.Empty;
        _pmScroll = true;
    }

