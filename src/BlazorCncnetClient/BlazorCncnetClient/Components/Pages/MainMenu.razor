@page "/menu"
@implements IDisposable
@using CnCNetClient.Core
@using CnCNetClient.Core.Settings
@using CnCNetClient.Online
@using CnCNetClient.Updater
@using CnCNetClient.Domain.Multiplayer.CnCNet
@using System.IO
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IThemeProvider ThemeProvider
@inject MessageBoxService MessageBox
@inject AppExitNotifier ExitNotifier
@inject ExtrasService Extras
@inject LoginService Login
@inject IServiceProvider Services
@inject UpdateService UpdateSvc
@inject UiDefinitionService UiDefs
@inject DiscordPresenceService Discord
@inject PluginCatalog Plugins
@inject ITranslationService TranslationSvc
@inject MainMenuVideoService MainMenuVideo
@inject ReplayLaunchService ReplaySvc

@* F4 可替换主页：插件可通过 ReplaceSlot("page.mainmenu", …) 接管整个主菜单主体。
   宿主逻辑（自动连接、ESC、更新检查、隐私声明）仍在本页代码中执行，不受覆盖影响。 *@
@if (_mainMenuOverride is not null)
{
    <DynamicComponent Type="_mainMenuOverride" />
}
else
{
<main class="stage">
    <section class="left">
        <div class="logobar">
            <span class="rec"></span>
            @if (ThemeProvider.Current.Key == "ra")
            {
                <span style="color:#ffd23f;letter-spacing:5px">RED ALERT</span>
                <span class="ver">@UiText.T("MainMenu.LogoTagRa", "// COMMAND & CONQUER")</span>
            }
            else
            {
                <text>CNC</text><span style="color:#fff">NET</span> <span class="ver">@UiText.T("MainMenu.LogoTag", "// COMMAND VIEW")</span>
            }
        </div>

        <div class="viewport item-in">
            @* 视口视频：自动播放、循环、静音、无控件（默认嵌入 YR，可通过 ClientDefinitions.ini 更换） *@
            @if (!string.IsNullOrEmpty(_videoUrl))
            {
                <video class="mm-video" src="@_videoUrl" autoplay muted loop playsinline preload="auto"></video>
            }
        </div>

        <!-- r9-1：更新状态链接（原版 lblUpdateStatus：点击检查/查看更新；OUTDATED 跳设置更新页）。
             新客户端把版本/更新状态/在线人数放进了常驻 HUD，已脱离旧主菜单列表，
             暂按新客户端硬编码常显；只有列表项（按钮）跟随 MainMenu.ini。 -->
        <div class="updstrip item-in" style="animation-delay:140ms">
            <span class="us-dot @_updateDot"></span>
            <button type="button" class="us-link" disabled="@_updateBusy" @onclick="OnUpdateStatusClick">@UpdateStatusText</button>
            <span class="us-ver">v@(UpdateSvc.GameVersion)</span>
        </div>
    </section>

    <aside class="panel">
        <div class="ph"><span>@UiText.T("MainMenu.PanelTitle", "Command Menu")</span><span style="font-family:var(--font-orbitron)">MAIN TERMINAL</span></div>
        @for (var i = 0; i < VisibleMenuItems.Length; i++)
        {
            var m = VisibleMenuItems[i];
            <button class="mbtn @(m.IsPrimary ? "primary" : "") item-in"
                    style="animation-delay:@((120 + i * 50).ToString())ms"
                    disabled="@(!m.IsEnabled)"
                    @onclick="() => OnMenuClick(m)">
                <span class="ic">@m.Icon</span>
                <span class="txt"><span class="cn">@Label(m)</span></span>
                <span class="go">›</span>
            </button>
        }
        @* F4 追加型槽位：插件自定义渲染的菜单入口（勿与 AddMenuEntry 的按钮式入口重复声明） *@
        <PluginSlot Key="menu.entry" />
        <div class="pf"><span class="cn">© 2026 CNCNet CLIENT</span><span>ESC · @UiText.T("MainMenu.Back", "Back")</span></div>
    </aside>
</main>
}

<!-- 首次运行隐私声明（原版 PrivacyNotification：未接受前每次进主菜单弹出） -->
@if (_privacyOpen)
{
    <div class="ctx-backdrop" @onclick="OnPrivacyDismiss"></div>
    <div class="cr-panel privacy-panel pop-in">
        <div class="cr-head">
            <span>@UiText.T("Privacy.Title", "Privacy Notice")</span>
            <span class="cr-en">PRIVACY NOTICE</span>
            <button type="button" class="gop-close" @onclick="OnPrivacyDismiss" title="@UiText.T("Common.Close", "Close")">✕</button>
        </div>
        <div class="privacy-body">
            <p>@UiText.T("Privacy.Body", "This application uses CnCNet web and tunnel server services and may collect technical and other information necessary for its operation.")</p>
            <div class="privacy-links">
                <button type="button" class="link" @onclick='() => OpenPrivacyUrl("https://cncnet.org/terms-and-conditions")'>@UiText.T("Privacy.Terms", "Terms & Conditions")</button>
                <button type="button" class="link" @onclick='() => OpenPrivacyUrl("https://cncnet.org/privacy-policy")'>@UiText.T("Privacy.Policy", "Privacy Policy")</button>
            </div>
            <p class="sub">@UiText.T("Privacy.Footer", "By using this application you agree to the CnCNet terms and privacy policy. These options can be configured in Settings > Privacy.")</p>
        </div>
        <div class="cr-actions">
            <button type="button" class="mb-btn primary" @onclick="OnPrivacyAccept">
                @UiText.T("Privacy.Accept", "Got it")<span class="en">GOT IT</span>
            </button>
        </div>
    </div>
}

@code {
    /// <summary>首次运行隐私提示可见性（原版 PrivacyNotification：PrivacyPolicyAccepted 未勾选时显示）。</summary>
    private bool _privacyOpen;

    /// <summary>F4：插件替换的主菜单主体组件（page.mainmenu），为空时渲染内置主体。</summary>
    private Type? _mainMenuOverride;
    private sealed record MenuItem(string Key, string Cn, string En, string Icon, bool IsPrimary = false, string? Route = null, bool IsEnabled = true);

    private static readonly MenuItem[] MenuItems =
    [
        new("campaign", "战役", "Campaign", "◆", true),
        new("multiplayer", "多人游戏", "Multiplayer", "⬡"),
        new("skirmish", "遭遇战", "Skirmish", "⚔"),
        new("lan", "局域网", "LAN", "⌗"),
        new("load", "载入", "Load Game", "↻"),
        new("lore", "资料库", "Codex / Lore", "❖"),
        new("stats", "统计", "Statistics", "▤"),
        new("settings", "设置", "Settings", "⚙"),
        new("mapeditor", "地图编辑器", "Map Editor", "▦"),
        new("credits", "鸣谢", "Credits", "✦"),
        new("extras", "附加功能", "Extras", "＋"),
        new("exit", "退出", "Exit", "✕"),
    ];

    /// <summary>
    /// 菜单项显示文案（单语）：内置项走 Resx / 原版 Translation.ini；插件项按当前语言取 Label / LabelEn。
    /// </summary>
    private static string Label(MenuItem m)
    {
        if (!m.Key.StartsWith("plugin:", StringComparison.Ordinal))
            return UiText.T("MainMenu." + m.Key, m.En);

        return (CnCNetClient.Core.I18N.UIStrings.Culture ?? System.Globalization.CultureInfo.CurrentUICulture).Name
            .StartsWith("zh", StringComparison.OrdinalIgnoreCase) ? m.Cn : m.En;
    }

    /// <summary>按 ClientDefinitions.ini [UI] HiddenMenus 过滤后的可见入口（F3）+ 插件菜单项（F4）。</summary>
    private MenuItem[]? _visible;
    private MenuItem[] VisibleMenuItems => _visible ??= BuildMenu();

    /// <summary>
    /// 合并内置入口与插件入口（F4）：内置项（HiddenMenus 过滤后）→ 插件项（按 Order 升序，
    /// 默认 100）→「退出」。插件项通过 <see cref="MenuItem.Route"/> 跳转其提供的页面。
    /// </summary>
    private MenuItem[] BuildMenu()
    {
        // 显隐双闸：ClientDefinitions.ini [UI] HiddenMenus（移植版扩展）+
        // Resources\MainMenu.ini [btn*] Visible（官方 XNA 主菜单开关）。
        var builtins = MenuItems
            .Where(m => !UiDefs.HiddenMenus.Contains(m.Key) && UiDefs.IsMainMenuEntryVisible(m.Key))
            .Select(m => m with { IsEnabled = UiDefs.IsMainMenuEntryEnabled(m.Key) })
            .ToList();

        var pluginItems = Plugins.EnabledMenuEntries
            .OrderBy(e => e.Order)
            .Select(e => new MenuItem($"plugin:{e.Key}", e.Label, e.LabelEn, e.Icon, Route: e.Route))
            .ToList();
        if (pluginItems.Count == 0)
            return builtins.ToArray();

        int exitIndex = builtins.FindIndex(m => m.Key == "exit");
        if (exitIndex < 0)
            builtins.AddRange(pluginItems);
        else
            builtins.InsertRange(exitIndex, pluginItems);

        return builtins.ToArray();
    }

    /// <summary>视口视频 URL（默认嵌入 YR，可由 ClientDefinitions.ini [MainMenu] Video 更换）；
    /// 内容服务器未启动时为空，视口保持纯色底。</summary>
    private string _videoUrl = string.Empty;

    protected override void OnInitialized()
    {
        // F4：插件可替换主菜单主体（内部渲染仍沿用宿主服务，自动连接/ESC/更新检查不受影响）
        _mainMenuOverride = Plugins.TryGetReplacement("page.mainmenu", out var overrideType) ? overrideType : null;
        // 视口视频地址需在首帧渲染前确定（OnAfterRenderAsync 里赋值不会触发重渲染）
        _videoUrl = MainMenuVideo.ResolveUrl();
        // 品牌文案随主题切换刷新（红警 → RED ALERT）
        ThemeProvider.ThemeChanged += OnThemeChanged;
        // 原版 PrivacyNotification：未接受隐私政策前，每次进入主菜单弹底部提示
        _privacyOpen = !UserINISettings.Instance.PrivacyPolicyAccepted.Value;
        // 语言切换：文案走 Resx / Translation.ini，切换后整体重渲染
        TranslationSvc.LanguageChanged += OnLanguageChanged;
        // r9-1：更新状态链接（原版 lblUpdateStatus，启动检查结果由 TryStartupUpdateCheck 触发）
        UpdateSvc.StateChanged += OnUpdateStateChanged;
        RefreshUpdateStatus();
        // r9-4：Discord 呈现恢复为「客户端内」（原版 MainMenu 构造后为默认 In Client）
        Discord.MainMenu();
    }

    // ── r9-1：更新状态链接（原版 lblUpdateStatus 各状态文案与点击行为） ──

    private string UpdateStatusText { get; set; } = UiText.T("MainMenu.Update.CheckNow", "Click to check for updates");
    private bool _updateBusy;
    private bool _updateOutdated;
    private string _updateDot = "";

    private void OnUpdateStateChanged() => InvokeAsync(() => { RefreshUpdateStatus(); StateHasChanged(); });

    /// <summary>按 Updater 版本状态刷新链接文案/指示灯（对应原版 HandleFileIdentifierUpdate 的分支）。</summary>
    private void RefreshUpdateStatus()
    {
        _updateOutdated = false;
        if (!UpdateSvc.IsAvailable)
        {
            UpdateStatusText = UiText.T("MainMenu.Update.Unavailable", "Update service unavailable");
            _updateBusy = false;
            _updateDot = "";
            return;
        }

        switch (UpdateSvc.VersionState)
        {
            case VersionState.UPDATECHECKINPROGRESS:
                UpdateStatusText = UiText.T("MainMenu.Update.Checking", "Checking for updates…");
                _updateBusy = true;
                _updateDot = "busy";
                break;
            case VersionState.UPDATEINPROGRESS:
                UpdateStatusText = string.Format(
                    UiText.T("MainMenu.Update.Updating", "Updating… {0}%"), UpdateSvc.TotalPercentage);
                _updateBusy = true;
                _updateDot = "busy";
                break;
            case VersionState.OUTDATED:
                _updateOutdated = true;
                UpdateStatusText = UpdateSvc.ManualUpdateRequired
                    ? string.Format(UiText.T("MainMenu.Update.NewVersionManual", "New version v{0} found (manual download required)"), UpdateSvc.ServerGameVersion)
                    : string.Format(UiText.T("MainMenu.Update.NewVersion", "New version v{0} found, click to view"), UpdateSvc.ServerGameVersion);
                _updateBusy = false;
                _updateDot = "warn";
                break;
            case VersionState.MISMATCHED:
                UpdateStatusText = UiText.T("MainMenu.Update.Mismatch", "Version mismatch, click to check");
                _updateBusy = false;
                _updateDot = "warn";
                break;
            case VersionState.UNKNOWN:
                UpdateStatusText = UiText.T("MainMenu.Update.Failed", "Update check failed, click to retry");
                _updateBusy = false;
                _updateDot = "err";
                break;
            default: // UPTODATE
                UpdateStatusText = string.Format(
                    UiText.T("MainMenu.Update.UpToDate", "Already up to date v{0}, click to check"), UpdateSvc.GameVersion);
                _updateBusy = false;
                _updateDot = "ok";
                break;
        }
    }

    /// <summary>点击更新状态链接：有新版本 → 跳设置「更新」页；否则重新检查（同原版 LblUpdateStatus_LeftClick）。</summary>
    private void OnUpdateStatusClick()
    {
        if (_updateBusy)
            return;
        if (_updateOutdated)
        {
            Nav.NavigateTo("/settings?tab=update");
            return;
        }
        UpdateSvc.CheckForUpdates();
    }

    // ── 隐私声明（原版 PrivacyNotification：Got it → 写入并保存设置后关闭） ──

    private void OnPrivacyAccept()
    {
        UserINISettings.Instance.PrivacyPolicyAccepted.Value = true;
        UserINISettings.Instance.SaveSettings();
        _privacyOpen = false;
    }

    private void OnPrivacyDismiss() => _privacyOpen = false;

    private void OpenPrivacyUrl(string url)
    {
        if (Extras.OpenUrl(url) is { } err)
            _ = JS.InvokeVoidAsync("cncnet.toast", err, "err");
    }

    private DotNetObjectReference<MainMenu>? _dotNetRef;

    /// <summary>拖放导入回放（对齐原版 MainMenu 的拖放回放文件）。</summary>
    private DotNetObjectReference<MainMenu>? _replayDropRef;
    private FileStream? _replayDropStream;
    private string? _replayDropPath;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // ESC 返回首页（实现「可退」）
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("cncnet.initMenuKeyNav", _dotNetRef);

            // 回放文件拖放导入：仅支持回放的游戏包才启用。
            if (ReplaySvc.IsSupported)
            {
                _replayDropRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("replayDrop.register", _replayDropRef, ReplaySvc.FileExtension);
            }

            // 自动连接（3.1.3）：记住我已勾选 → 跳过登录浮窗直接连接
            TryAutoConnect();
            // M4.3 D6.1 启动检查：环境就绪且「启动时检查更新」开启（默认 true）→ 非阻塞检查
            TryStartupUpdateCheck();
        }
    }

    /// <summary>拖放开始：为匹配的回放文件创建临时文件并分块接收。</summary>
    [JSInvokable]
    public Task ReplayDropBegin(string fileName)
    {
        CloseReplayDropStream(deleteFile: true);

        if (!string.Equals(Path.GetExtension(fileName), "." + ReplaySvc.FileExtension, StringComparison.OrdinalIgnoreCase))
            return Task.CompletedTask;

        _replayDropPath = Path.Combine(Path.GetTempPath(),
            "cncnet-replay-" + Guid.NewGuid().ToString("N") + "." + ReplaySvc.FileExtension);

        _replayDropStream = new FileStream(_replayDropPath, FileMode.Create, FileAccess.Write, FileShare.None);
        return Task.CompletedTask;
    }

    /// <summary>拖放数据块（Base64，避免大文件超出 WebView 单次消息上限）。</summary>
    [JSInvokable]
    public async Task ReplayDropChunk(string base64)
    {
        if (_replayDropStream is null || string.IsNullOrEmpty(base64))
            return;

        byte[] bytes = Convert.FromBase64String(base64);
        await _replayDropStream.WriteAsync(bytes);
    }

    /// <summary>拖放结束：把临时文件导入回放目录并跳转到存档/回放页。</summary>
    [JSInvokable]
    public async Task ReplayDropEnd()
    {
        string? path = _replayDropPath;
        await CloseReplayDropStreamAsync(deleteFile: false);

        if (path is null)
            return;

        try
        {
            string? imported = ReplaySvc.ImportReplay(path);

            if (imported is null)
            {
                await MessageBox.ShowAsync(
                    UiText.T("Replays.ImportFailedTitle", "Import failed"),
                    UiText.T("Replays.ImportFailedText", "This file is not a readable replay."),
                    MessageBoxButtons.Ok, MessageBoxKind.Error);
                return;
            }

            Nav.NavigateTo("/load");
        }
        finally
        {
            TryDelete(path);
        }
    }

    /// <summary>拖放的不是回放文件。</summary>
    [JSInvokable]
    public async Task ReplayDropInvalid(string fileName)
    {
        await MessageBox.ShowAsync(
            UiText.T("Replays.ImportFailedTitle", "Import failed"),
            string.Format(UiText.T("Replays.NotAReplayFile",
                "{0} is not a {1} replay file.\n\nOnly {1} replay files can be dropped here."),
                fileName, "." + ReplaySvc.FileExtension),
            MessageBoxButtons.Ok, MessageBoxKind.Error);
    }

    /// <summary>JS 侧读取失败。</summary>
    [JSInvokable]
    public async Task ReplayDropFailed(string fileName, string reason)
    {
        CloseReplayDropStream(deleteFile: true);
        await MessageBox.ShowAsync(
            UiText.T("Replays.ImportFailedTitle", "Import failed"),
            string.Format(UiText.T("Replays.ImportReadFailed", "Could not read {0}: {1}"), fileName, reason),
            MessageBoxButtons.Ok, MessageBoxKind.Error);
    }

    private async Task CloseReplayDropStreamAsync(bool deleteFile)
    {
        if (_replayDropStream is not null)
        {
            await _replayDropStream.FlushAsync();
            await _replayDropStream.DisposeAsync();
            _replayDropStream = null;
        }

        if (deleteFile)
            TryDelete(_replayDropPath);

        _replayDropPath = null;
    }

    private void CloseReplayDropStream(bool deleteFile)
    {
        if (_replayDropStream is not null)
        {
            _replayDropStream.Dispose();
            _replayDropStream = null;
        }

        if (deleteFile)
            TryDelete(_replayDropPath);

        _replayDropPath = null;
    }

    private static void TryDelete(string? path)
    {
        try
        {
            if (path is not null && File.Exists(path))
                File.Delete(path);
        }
        catch
        {
            // 临时文件清理失败不影响导入结果
        }
    }

    /// <summary>自动连接（spec §5.3.1）：SkipConnectDialog（记住我）已勾选时进主菜单即连接，不再弹登录浮窗。
    /// 偏好来自 settings INI（M4 4.1.1，spec §6.10）。</summary>
    private void TryAutoConnect()
    {
        try
        {
            var ini = UserINISettings.Instance;
            if (!ini.SkipConnectDialog.Value || string.IsNullOrWhiteSpace(ini.PlayerName.Value))
                return;
            ProgramConstants.PLAYERNAME = ini.PlayerName.Value.Trim();
            var manager = (CnCNetManager)Services.GetService(typeof(CnCNetManager))!;
            _ = JS.InvokeVoidAsync("cncnet.toast", string.Format(
                UiText.T("MainMenu.Toast.AutoConnect", "Auto-connecting to CnCNet: {0}…"), ProgramConstants.PLAYERNAME));
            manager.Connect();
        }
        catch
        {
            // 自动连接失败不阻塞主菜单
        }
    }

    /// <summary>M4.3 D6.1 启动更新检查：由 [Options] CheckforUpdates（默认 true）控制。
    /// 环境未就绪/正在检查时 UpdateService 内部安全降级；非阻塞，不干扰页面导航。</summary>
    private void TryStartupUpdateCheck()
    {
        try
        {
            if (!UserINISettings.Instance.CheckForUpdates.Value)
                return;
            UpdateSvc.CheckForUpdates();
        }
        catch
        {
            // 启动检查失败不阻塞主菜单（结果会在设置「更新」Tab 展示/重试）
        }
    }

    private void OnThemeChanged(ThemeInfo theme) => InvokeAsync(StateHasChanged);

    private void OnLanguageChanged() => InvokeAsync(() =>
    {
        RefreshUpdateStatus();
        StateHasChanged();
    });

    /// <summary>ESC 键：从主菜单返回首页（环境检测页）。由 JS keydown 触发。</summary>
    [JSInvokable]
    public Task OnEscKey()
    {
        Nav.NavigateTo("/");
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        ThemeProvider.ThemeChanged -= OnThemeChanged;
        TranslationSvc.LanguageChanged -= OnLanguageChanged;
        UpdateSvc.StateChanged -= OnUpdateStateChanged;

        // 主菜单音乐由布局（MainLayout）统一管理，离开主菜单时继续播放
        if (_dotNetRef is not null)
        {
            _ = JS.InvokeVoidAsync("cncnet.disposeMenuKeyNav");
            _dotNetRef.Dispose();
        }

        if (_replayDropRef is not null)
        {
            _ = JS.InvokeVoidAsync("replayDrop.unregister");
            _replayDropRef.Dispose();
            _replayDropRef = null;
        }

        CloseReplayDropStream(deleteFile: true);
    }

    private async Task OnMenuClick(MenuItem item)
    {
        // MainMenu.ini [btn*] Enabled=false：官方语义为置灰不可点。
        if (!item.IsEnabled)
            return;

        // F4 插件入口：直接跳转插件声明的路由（不做占位 toast）
        if (item.Route is { Length: > 0 } pluginRoute)
        {
            Nav.NavigateTo(pluginRoute);
            return;
        }

        // M2.4/M2.7/M3.1：暂以 toast / MessageBox / 登录浮窗占位，后续各功能页接入后改为真实导航。
        switch (item.Key)
        {
            case "multiplayer":
                // 已连接（含自动连接）→ 直接进入大厅（M3.2 /online/lobby）
                var manager = (CnCNetManager)Services.GetService(typeof(CnCNetManager))!;
                if (manager.IsConnected)
                {
                    Nav.NavigateTo("/online/lobby");
                    break;
                }

                // 登录浮窗（spec §5.3.1）：昵称连接 CnCNet，成功 → 进入大厅
                var result = await Login.ShowAsync();
                if (result == LoginResult.Connected)
                    Nav.NavigateTo("/online/lobby");
                else if (result == LoginResult.Cancelled)
                    await JS.InvokeVoidAsync("cncnet.toast", UiText.T("MainMenu.Toast.ConnectCancelled", "Connection cancelled"));
                // Failed：浮窗内已给出错误提示
                break;
            case "settings":
                // M4.1 设置中心（/settings）：显示/音频/游戏/网络/更新/隐私，即改即存
                Nav.NavigateTo("/settings");
                break;
            case "skirmish":
                // M4.5 遭遇战（/skirmish）：本地对战（人类 + AI）配置与启动
                Nav.NavigateTo("/skirmish");
                break;
            case "campaign":
                // M4.6 战役（/campaign）：单机任务选择（Battle.ini 解析）与启动
                Nav.NavigateTo("/campaign");
                break;
            case "lan":
                // M4.4 局域网大厅（/lan/lobby）：UDP 广播发现 + 聊天 + 玩家列表
                Nav.NavigateTo("/lan/lobby");
                break;
            case "load":
                // 加载单机存档（/load，原版 GameLoadingWindow）：Saved Games/*.SAV 列表 → 加载/删除
                Nav.NavigateTo("/load");
                break;
            case "credits":
                // 鸣谢（原版 btnCredits CreditsWindow 语义）：直接打开鸣谢页面
                if (Extras.OpenUrl(ClientConfiguration.Instance.CreditsURL) is { } creditsErr)
                    await JS.InvokeVoidAsync("cncnet.toast", string.Format(
                        UiText.T("MainMenu.Toast.CreditsFailed", "Could not open credits: {0}"), creditsErr), "err");
                break;
            case "mapeditor":
                // 直接启动地图编辑器（原版 btnMapEditor：FinalSun 外部进程）
                if (Extras.LaunchMapEditor() is { } mapErr)
                    await JS.InvokeVoidAsync("cncnet.toast", string.Format(
                        UiText.T("MainMenu.Toast.MapEditorFailed", "Map editor failed to start: {0}"), mapErr), "err");
                break;
            case "extras":
                // 附加功能窗（原版 btnExtras ExtrasWindow：地图编辑器/更新日志/鸣谢/关于）
                await Extras.ShowAsync();
                break;
            case "stats":
                // M4.8 统计窗口（/stats，原版 StatisticsWindow）：对局列表 + 总统计
                Nav.NavigateTo("/stats");
                break;
            case "exit":
                // 退出应用（原版 MainMenu 的 Exit）：确认后先持久化（IAppExitNotifier），再结束进程
                if (await MessageBox.ShowAsync(
                        UiText.T("MainMenu.ExitTitle", "Exit client"),
                        UiText.T("MainMenu.ExitBody", "Are you sure you want to exit CNCNet CLIENT?"),
                        MessageBoxButtons.YesNo, MessageBoxKind.Confirm))
                {
                    ExitNotifier.NotifyExiting();
                    Environment.Exit(0);
                }
                break;
            default:
                await JS.InvokeVoidAsync("cncnet.toast", string.Format(
                    UiText.T("MainMenu.Toast.Entering", "Entering {0}…"), Label(item)));
                break;
        }
    }
}
