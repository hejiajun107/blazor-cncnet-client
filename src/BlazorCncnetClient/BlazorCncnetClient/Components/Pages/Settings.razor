@page "/settings"
@implements IDisposable
@using System.Globalization
@using CnCNetClient.Core
@using CnCNetClient.Domain
@using CnCNetClient.Tools
@using CnCNetClient.Updater
@using BlazorCncnetClient.Infrastructure.Theme
@using Microsoft.Extensions.Logging
@inject SettingsService SettingsSvc
@inject ITranslationService TranslationSvc
@inject IThemeProvider ThemeProvider
@inject UpdateService UpdateSvc
@inject IServiceProvider Services
@inject ILogger<Settings> Logger
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="settings page-anim">
    <header class="settings-top item-in">
        <div class="st-left">
            <button class="mb-btn item-in" @onclick="OnCancel">‹ @Ui("Settings.Back", "返回")</button>
        </div>
        <div class="st-mid">
            <span class="st-title">@Ui("Settings.Title", "设置中心")</span>
            <span class="st-en">SETTINGS TERMINAL · 保存生效</span>
        </div>
        <div class="st-right">
            <span class="st-player">@(ProgramConstants.PLAYERNAME.Length > 0 ? ProgramConstants.PLAYERNAME : "未连接")</span>
        </div>
    </header>

    <div class="settings-grid">
        <nav class="set-nav item-in">
            @foreach (var s in Sections)
            {
                <button class="set-nav-item @(s.Key == Active ? "active" : "")" @onclick="() => Active = s.Key">
                    <span class="set-nav-ic">@s.Icon</span>
                    <span class="set-nav-tx"><span class="cn">@Ui("Settings.Nav." + s.Key, s.Cn)</span><span class="en">@s.En</span></span>
                </button>
            }
        </nav>

        <section class="set-panel item-in" style="animation-delay:60ms">
            @switch (Active)
            {
                case "display":
                    @RenderDisplay()
                    break;
                case "audio":
                    @RenderAudio()
                    break;
                case "game":
                    @RenderGame()
                    break;
                case "network":
                    @RenderNetwork()
                    break;
                case "update":
                    @RenderUpdate()
                    break;
                case "components":
                    @RenderComponents()
                    break;
                case "privacy":
                    @RenderPrivacy()
                    break;
            }
        </section>
    </div>

    @* M 草稿-提交模式（对齐原版 OptionsWindow）：控件只改内存草稿，底部「保存/取消」统一提交。 *@
    <footer class="set-bar item-in" style="animation-delay:120ms">
        <span class="set-bar-status@(HasDraft ? " has-draft" : "")">@(HasDraft ? "· 有未保存的修改" : "设置已同步")</span>
        <button class="mb-btn" @onclick="OnCancel">@Ui("Settings.Cancel", "取消")</button>
        <button class="mb-btn primary" @onclick="OnSave">@Ui("Settings.Save", "保存设置")</button>
    </footer>
</div>

@code {
    private sealed record Section(string Key, string Cn, string En, string Icon);

    private static readonly Section[] Sections =
    [
        new("display", "显示", "DISPLAY", "▦"),
        new("audio", "音频", "AUDIO", "♪"),
        new("game", "游戏", "GAME", "⚙"),
        new("network", "网络", "NETWORK", "⌗"),
        new("update", "更新", "UPDATE", "↻"),
        new("components", "组件", "COMPONENTS", "▣"),
        new("privacy", "隐私", "PRIVACY", "⬢"),
    ];

    private string Active { get; set; } = "display";

    /// <summary>M 草稿：尚未提交的设置改动（对齐原版控件值先于 Save 落盘的语义）。</summary>
    private readonly Dictionary<string, object> _draft = new();

    private bool HasDraft => _draft.Count > 0;

    protected override void OnInitialized()
    {
        SettingsSvc.SettingsChanged += OnSettingsChanged;
        ThemeProvider.ThemeChanged += OnThemeChanged;
        TranslationSvc.LanguageChanged += OnLanguageChanged;
        // r9-1：支持 /settings?tab=update 直达指定分区（主菜单更新状态链接跳转）
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;
        int tabIdx = query.IndexOf("tab=", StringComparison.OrdinalIgnoreCase);
        if (tabIdx >= 0)
        {
            var tab = query.Substring(tabIdx + 4).Split('&')[0];
            if (Sections.Any(s => s.Key == tab))
                Active = tab;
        }
        // M4.3：进入设置即尝试初始化更新服务（环境就绪时读取本地版本/镜像表）。
        UpdateSvc.EnsureInitialized();
        UpdateSvc.StateChanged += OnUpdateStateChanged;
        // r9-5：组件面板订阅组件下载进度/完成事件。
        UpdateSvc.ComponentChanged += OnComponentChanged;
        // 游戏渲染器：首帧即加载兼容列表（资源未就绪时静默为空，下拉禁用）。
        EnsureRenderers();
    }

    private void OnUpdateStateChanged() => InvokeAsync(StateHasChanged);

    private void OnComponentChanged(CustomComponent component) => InvokeAsync(StateHasChanged);

    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);
    private void OnThemeChanged(ThemeInfo theme) => InvokeAsync(StateHasChanged);
    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    /// <summary>按当前 UI 文化取 Resx 文案（UI 键走 Resx，spec §6.8；缺失回退默认值）。</summary>
    private static string Ui(string key, string fallback) => fallback.L10N(UIStrings.KeyPrefix + key);

    /// <summary>当前分区标题（本地化；默认回退「中文 英文」双语占位）。</summary>
    private string CurrentSectionTitle()
    {
        return Sections.FirstOrDefault(s => s.Key == Active) is { } sec
            ? Ui("Settings.Section." + Active, $"{sec.Cn} {sec.En}")
            : Active;
    }

    /* ── 草稿读写 ── */
    private bool GetBool(string key, bool fallback)
        => _draft.TryGetValue(key, out var v) && v is bool b ? b : fallback;

    private int GetInt(string key, int fallback)
        => _draft.TryGetValue(key, out var v) && v is int i ? i : fallback;

    private double GetDouble(string key, double fallback)
        => _draft.TryGetValue(key, out var v) && v is double d ? d : fallback;

    private string GetStr(string key, string fallback)
        => _draft.TryGetValue(key, out var v) && v is string s ? s : fallback;

    private void SetDraft(string key, object value)
    {
        _draft[key] = value;
        StateHasChanged();
    }

    private void SetDraftBool(string key, ChangeEventArgs e)
        => SetDraft(key, e.Value is bool b && b);

    private void SetDraftInt(string key, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
            SetDraft(key, v);
    }

    private void SetDraftDouble(string key, ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var v))
            SetDraft(key, v);
    }

    private void OnLanguageChange(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } code)
            TranslationSvc.SetLanguage(code);
    }

    private async Task OnThemeChange(ChangeEventArgs e)
    {
        var key = e.Value?.ToString() ?? ThemeProvider.Current.Key;
        await ThemeProvider.ApplyAsync(key);
    }

    /* ── 游戏渲染器选择（原版 Display render options，草稿内暂存，保存时应用） ── */

    private DirectDrawWrapperManager? _renderers;
    private List<DirectDrawWrapper> _rendererList = new();

    /// <summary>当前渲染器 internal name（草稿优先；资源未就绪为空串，下拉禁用）。</summary>
    private string CurrentRendererInternalName =>
        GetStr("renderer", _renderers?.SelectedRenderer.InternalName ?? string.Empty);

    /// <summary>当前生效渲染器（草稿优先；渲染器资源未就绪为空）。</summary>
    private DirectDrawWrapper? CurrentRenderer
    {
        get
        {
            if (_renderers is null)
                return null;
            string name = GetStr("renderer", _renderers.SelectedRenderer.InternalName);
            return _rendererList.FirstOrDefault(r => r.InternalName == name) ?? _renderers.SelectedRenderer;
        }
    }

    /// <summary>窗口化当前值（草稿优先；旧版语义：DxWnd 类渲染器从自身配置 INI 读，否则读 UserINISettings）。</summary>
    private bool WindowedChecked => GetBool("windowed", ReadWindowedFromRenderer(CurrentRenderer));

    /// <summary>无边框当前值（草稿优先；渲染器有 BorderlessWindowedModeKey 时从自身配置 INI 读，否则读 UserINISettings）。</summary>
    private bool BorderlessChecked => GetBool("borderless", ReadBorderlessFromRenderer(CurrentRenderer));

    /// <summary>旧版 DisplayOptionsPanel：渲染器 UsesCustomWindowedOption 时窗口化状态存其配置 INI（如 dxwnd.ini [DxWnd] RunInWindow）。</summary>
    private bool ReadWindowedFromRenderer(DirectDrawWrapper? renderer)
    {
        if (renderer is not null && renderer.UsesCustomWindowedOption())
        {
            try
            {
                var rendererIni = new IniFile(SafePath.CombineFilePath(ProgramConstants.GamePath, renderer.ConfigFileName));
                return rendererIni.GetBooleanValue(renderer.WindowedModeSection!, renderer.WindowedModeKey!, false);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "读取渲染器窗口化配置失败：{Name}", renderer.InternalName);
            }
            return false;
        }
        return SettingsSvc.Ini.WindowedMode.Value;
    }

    /// <summary>旧版 DisplayOptionsPanel：渲染器有 BorderlessWindowedModeKey 时无边框存其配置 INI（可反向），否则读 UserINISettings。</summary>
    private bool ReadBorderlessFromRenderer(DirectDrawWrapper? renderer)
    {
        if (renderer is not null && !string.IsNullOrEmpty(renderer.BorderlessWindowedModeKey))
        {
            try
            {
                var rendererIni = new IniFile(SafePath.CombineFilePath(ProgramConstants.GamePath, renderer.ConfigFileName));
                bool setting = rendererIni.GetBooleanValue(renderer.WindowedModeSection!, renderer.BorderlessWindowedModeKey, false);
                return renderer.IsBorderlessWindowedModeKeyReversed ? !setting : setting;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "读取渲染器无边框配置失败：{Name}", renderer.InternalName);
            }
            return false;
        }
        return SettingsSvc.Ini.BorderlessWindowedMode.Value;
    }

    /// <summary>窗口化切换：取消勾选时按旧版 ChkWindowedMode_CheckedChanged 连带取消无边框。</summary>
    private void OnWindowedChange(ChangeEventArgs e)
    {
        bool isChecked = e.Value is bool b && b;
        SetDraft("windowed", isChecked);
        if (!isChecked)
            SetDraft("borderless", false);
    }

    private void EnsureRenderers()
    {
        if (_renderers is not null)
            return;

        var mgr = (DirectDrawWrapperManager?)Services.GetService(typeof(DirectDrawWrapperManager));
        if (mgr is null)
            return;

        _renderers = mgr;
        _rendererList = mgr
            .GetRenderers(ClientConfiguration.Instance.GetOperatingSystemVersion())
            .ToList();
    }

    private void OnRendererChange(ChangeEventArgs e)
    {
        EnsureRenderers();
        if (_renderers is null)
            return;

        string? name = e.Value?.ToString();
        if (string.IsNullOrEmpty(name))
            return;

        if (_rendererList.Any(r => r.InternalName == name))
        {
            // 旧版切换渲染器后立即刷新窗口化勾选（DisplayOptionsPanel.LoadRenderer）；
            // 清除草稿让 UI 回退到新渲染器配置 INI / UserINISettings 的当前值。
            _draft.Remove("windowed");
            _draft.Remove("borderless");
            SetDraft("renderer", name);
        }
    }

    /* ── 分辨率（原版 ddIngameResolution / ddClientResolution 语义） ── */

    /// <summary>游戏分辨率档位（YR 常见档；当前值不在列表时由 EnsureInList 补入）。</summary>
    private static readonly string[] IngameResolutions =
    [
        "640x480", "800x600", "1024x768", "1152x864", "1280x720", "1280x960",
        "1280x1024", "1366x768", "1440x900", "1600x900", "1680x1050", "1920x1080",
        "1920x1200", "2560x1440", "2560x1600", "3840x2160",
    ];

    /// <summary>客户端窗口分辨率档位（下限 1280x720，与窗口最小尺寸一致）。</summary>
    private static readonly string[] ClientResolutions =
    [
        "1280x720", "1366x768", "1440x900", "1536x864", "1600x900", "1680x1050",
        "1920x1080", "1920x1200", "2560x1440", "2560x1600", "3840x2160",
    ];

    private string CurrentIngameRes =>
        GetStr("ingameRes", $"{SettingsSvc.Ini.IngameScreenWidth.Value}x{SettingsSvc.Ini.IngameScreenHeight.Value}");

    private string CurrentClientRes =>
        GetStr("clientRes", $"{SettingsSvc.Ini.ClientResolutionX.Value}x{SettingsSvc.Ini.ClientResolutionY.Value}");

    /// <summary>分辨率下拉选项：标准档 + 当前值兜底（保证 select 始终能显示现有设置）。</summary>
    private static IEnumerable<string> EnsureInList(IEnumerable<string> presets, string current)
        => presets.Contains(current) ? presets : presets.Append(current);

    private static bool TryParseRes(string text, out int w, out int h)
    {
        w = h = 0;
        var parts = text.Split('x');
        return parts.Length == 2
               && int.TryParse(parts[0], out w)
               && int.TryParse(parts[1], out h);
    }

    private void OnIngameResChange(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } res)
            SetDraft("ingameRes", res);
    }

    private void OnClientResChange(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } res)
            SetDraft("clientRes", res);
    }

    /* ── 保存 / 取消（原版 OptionsWindow.BtnSave_LeftClick / BtnBack_LeftClick） ── */

    /// <summary>保存草稿：全部写回 UserINISettings + 渲染器应用 + 落盘；涉及重启项时 toast 提示。</summary>
    private void OnSave()
    {
        // 分辨率（游戏 INI 回写在 UserINISettings.SaveSettings 内完成）
        if (_draft.TryGetValue("ingameRes", out var ir) && ir is string ires && TryParseRes(ires, out int iw, out int ih))
        {
            SettingsSvc.Ini.IngameScreenWidth.Value = iw;
            SettingsSvc.Ini.IngameScreenHeight.Value = ih;
        }
        if (_draft.TryGetValue("clientRes", out var cr) && cr is string cres && TryParseRes(cres, out int cw, out int ch))
        {
            SettingsSvc.Ini.ClientResolutionX.Value = cw;
            SettingsSvc.Ini.ClientResolutionY.Value = ch;
        }

        // 渲染器（DirectDrawWrapperManager.Save 应用 ddraw 配置并持久化 [Compatibility] Renderer）
        if (_draft.TryGetValue("renderer", out var rv) && rv is string rname && _renderers is not null)
        {
            DirectDrawWrapper? selected = _rendererList.FirstOrDefault(r => r.InternalName == rname);
            if (selected is not null)
            {
                try
                {
                    _renderers.Save(selected);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "应用游戏渲染器失败：{Name}", rname);
                }
            }
        }

        // 窗口化 / 无边框（旧版 DisplayOptionsPanel.Save 分流语义）：
        // 渲染器自定义窗口化（DxWnd 等 UsesCustomWindowedOption）→ 写其配置 INI（dxwnd.ini），
        // 此时 UserINISettings.Video.Windowed 不保存（旧版 chkWindowedMode.Checked && !UsesCustomWindowedOption）；
        // 无边框在渲染器提供 BorderlessWindowedModeKey 时同样只写渲染器配置 INI。
        bool windowed = WindowedChecked;
        bool borderless = BorderlessChecked;
        var windowedRenderer = _renderers?.SelectedRenderer;

        if (windowedRenderer is not null && windowedRenderer.UsesCustomWindowedOption())
        {
            SettingsSvc.Ini.WindowedMode.Value = false;
            try
            {
                var rendererIni = new IniFile(SafePath.CombineFilePath(ProgramConstants.GamePath, windowedRenderer.ConfigFileName));
                rendererIni.SetBooleanValue(windowedRenderer.WindowedModeSection!, windowedRenderer.WindowedModeKey!, windowed);
                if (!string.IsNullOrEmpty(windowedRenderer.BorderlessWindowedModeKey))
                {
                    bool borderlessIniValue = windowedRenderer.IsBorderlessWindowedModeKeyReversed ? !borderless : borderless;
                    rendererIni.SetBooleanValue(windowedRenderer.WindowedModeSection!, windowedRenderer.BorderlessWindowedModeKey, borderlessIniValue);
                }
                rendererIni.WriteIniFile();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "写入渲染器窗口化配置失败：{Name}", windowedRenderer.InternalName);
            }
        }
        else
        {
            SettingsSvc.Ini.WindowedMode.Value = windowed;
            SettingsSvc.Ini.BorderlessWindowedMode.Value =
                borderless && string.IsNullOrEmpty(windowedRenderer?.BorderlessWindowedModeKey);
        }

        // 其余设置项
        void Bool(string key, Action<bool> setter)
        {
            if (_draft.TryGetValue(key, out var v) && v is bool b)
                setter(b);
        }
        void Int(string key, Action<int> setter)
        {
            if (_draft.TryGetValue(key, out var v) && v is int i)
                setter(i);
        }
        void Double(string key, Action<double> setter)
        {
            if (_draft.TryGetValue(key, out var v) && v is double d)
                setter(d);
        }
        void Str(string key, Action<string> setter)
        {
            if (_draft.TryGetValue(key, out var v) && v is string s)
                setter(s);
        }

        Int("clientFps", v => SettingsSvc.Ini.ClientFPS.Value = v);
        Bool("minimizeOnGameStart", v => SettingsSvc.Ini.MinimizeWindowsOnGameStart.Value = v);
        Bool("forceLowDetail", v => SettingsSvc.Ini.ForceLowestDetailLevel.Value = v);

        Double("soundVolume", v => SettingsSvc.Ini.SoundVolume.Value = v);
        Double("scoreVolume", v => SettingsSvc.Ini.ScoreVolume.Value = v);
        Double("voiceVolume", v => SettingsSvc.Ini.VoiceVolume.Value = v);
        Bool("playMainMenuMusic", v => SettingsSvc.Ini.PlayMainMenuMusic.Value = v);
        Bool("messageSound", v => SettingsSvc.Ini.MessageSound.Value = v);

        Int("scrollRate", v => SettingsSvc.Ini.ScrollRate.Value = v);
        Int("doubleTapInterval", v => SettingsSvc.Ini.DoubleTapInterval.Value = v);
        Int("gameSpeed", v => SettingsSvc.Ini.GameSpeed.Value = v);
        Int("difficulty", v => SettingsSvc.Ini.Difficulty.Value = v);
        Bool("autoTrimUnderscores", v => SettingsSvc.Ini.AutoRemoveUnderscoresFromName.Value = v);

        Str("playerName", v => SettingsSvc.Ini.PlayerName.Value = v);
        Bool("skipConnectDialog", v => SettingsSvc.Ini.SkipConnectDialog.Value = v);
        Bool("persistentMode", v => SettingsSvc.Ini.PersistentMode.Value = v);
        Bool("autoConnect", v => SettingsSvc.Ini.AutomaticCnCNetLogin.Value = v);
        Bool("pingCustomTunnels", v => SettingsSvc.Ini.PingUnofficialCnCNetTunnels.Value = v);
        Bool("mapSharing", v => SettingsSvc.Ini.EnableMapSharing.Value = v);
        Bool("tunnelList", v => SettingsSvc.Ini.AlwaysDisplayTunnelList.Value = v);

        Bool("checkUpdates", v => SettingsSvc.Ini.CheckForUpdates.Value = v);

        Bool("privacyAccepted", v => SettingsSvc.Ini.PrivacyPolicyAccepted.Value = v);
        Bool("discord", v => SettingsSvc.Ini.DiscordIntegration.Value = v);
        Bool("steam", v => SettingsSvc.Ini.SteamIntegration.Value = v);

        SettingsSvc.Save();

        // 需要重启客户端才生效的项：客户端分辨率 / 无边框窗口 / 渲染器（下次启动游戏应用）
        bool restartRequired = _draft.ContainsKey("clientRes")
            || _draft.ContainsKey("borderless")
            || _draft.ContainsKey("renderer");
        string msg = restartRequired
            ? "设置已保存 · 部分设置重启客户端后生效"
            : "设置已保存";
        _ = JS.InvokeVoidAsync("cncnet.toast", msg, "ok");

        _draft.Clear();
        Nav.NavigateTo("/menu");
    }

    /// <summary>取消：丢弃草稿（未写盘），直接返回（同原版 Cancel 按钮）。</summary>
    private void OnCancel()
    {
        _draft.Clear();
        StateHasChanged();
        Nav.NavigateTo("/menu");
    }

    /* ── 各分区渲染 ── */

    private RenderFragment RenderDisplay() => __builder =>
    {
        <div class="set-sec-title">@CurrentSectionTitle()</div>
        <div class="set-row">
            <div class="set-info"><span class="set-name">@Ui("Settings.Language", "语言")</span><span class="set-hint">LANGUAGE · 即切即用</span></div>
            <div class="set-ctl">
                <select class="set-select" value="@TranslationSvc.Current" @onchange="OnLanguageChange">
                    @foreach (var lang in TranslationSvc.Languages)
                    {
                        <option value="@lang.Code">@lang.DisplayName</option>
                    }
                </select>
            </div>
        </div>
        <div class="set-row">
            <div class="set-info"><span class="set-name">界面主题</span><span class="set-hint">THEME · 全局换肤</span></div>
            <div class="set-ctl">
                <select class="set-select" value="@ThemeProvider.Current.Key" @onchange="OnThemeChange">
                    @foreach (var t in ThemeProvider.Themes)
                    {
                        <option value="@t.Key">@t.Name · @t.Hint</option>
                    }
                </select>
            </div>
        </div>
        @* 游戏分辨率（原版 ddIngameResolution；保存时写回游戏 INI ScreenWidth/ScreenHeight） *@
        <div class="set-row">
            <div class="set-info"><span class="set-name">游戏分辨率</span><span class="set-hint">IN-GAME RESOLUTION · 下次启动游戏生效</span></div>
            <div class="set-ctl">
                <select class="set-select" value="@CurrentIngameRes" @onchange="OnIngameResChange">
                    @foreach (var r in EnsureInList(IngameResolutions, $"{SettingsSvc.Ini.IngameScreenWidth.Value}x{SettingsSvc.Ini.IngameScreenHeight.Value}"))
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
        </div>
        @* 客户端窗口分辨率（原版 ddClientResolution；重启客户端生效） *@
        <div class="set-row">
            <div class="set-info"><span class="set-name">客户端窗口分辨率</span><span class="set-hint">CLIENT RESOLUTION · 重启客户端生效</span></div>
            <div class="set-ctl">
                <select class="set-select" value="@CurrentClientRes" @onchange="OnClientResChange">
                    @foreach (var r in EnsureInList(ClientResolutions, $"{SettingsSvc.Ini.ClientResolutionX.Value}x{SettingsSvc.Ini.ClientResolutionY.Value}"))
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
        </div>
        <div class="set-row">
            <div class="set-info"><span class="set-name">窗口化运行</span><span class="set-hint">WINDOWED MODE</span></div>
            <div class="set-ctl">
                <label class="set-toggle">
                    <input type="checkbox" checked="@(WindowedChecked)"
                           @onchange="OnWindowedChange" />
                    <span class="tk"></span>
                </label>
            </div>
        </div>
        <div class="set-row">
            <div class="set-info"><span class="set-name">无边框窗口</span><span class="set-hint">BORDERLESS WINDOW · 需开启窗口化</span></div>
            <div class="set-ctl">
                <label class="set-toggle">
