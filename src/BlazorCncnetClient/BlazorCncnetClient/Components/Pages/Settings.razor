    private RenderFragment RenderUpdate() => __builder =>
    {
        <div class="set-sec-title">@CurrentSectionTitle()</div>
        <div class="set-row">
            <div class="set-info"><span class="set-name">启动时检查更新</span><span class="set-hint">CHECK FOR UPDATES ON START</span></div>
            <div class="set-ctl">
                <label class="set-toggle">
                    <input type="checkbox" checked="@(GetBool("checkUpdates", SettingsSvc.Ini.CheckForUpdates.Value))"
                           @onchange="@(e => SetDraftBool("checkUpdates", e))" />
                    <span class="tk"></span>
                </label>
            </div>
        </div>
        <div class="set-row">
            <div class="set-info"><span class="set-name">本地版本</span><span class="set-hint">LOCAL VERSION</span></div>
            <div class="set-ctl"><span class="set-val">@UpdateSvc.GameVersion</span></div>
        </div>
        <div class="set-row">
            <div class="set-info"><span class="set-name">服务器版本</span><span class="set-hint">SERVER VERSION</span></div>
            <div class="set-ctl"><span class="set-val">@UpdateSvc.ServerGameVersion</span></div>
        </div>

        @if (UpdateSvc.VersionState == VersionState.UPDATECHECKINPROGRESS)
        {
            <div class="set-hint-block">正在检查更新…</div>
        }
        else if (UpdateSvc.VersionState == VersionState.UPDATEINPROGRESS)
        {
            <div class="set-hint-block">
                <div>正在下载：@(UpdateSvc.CurrentFileName.Length > 0 ? UpdateSvc.CurrentFileName : "准备中…")</div>
                <div class="upd-progress"><i style="width:@(UpdateSvc.CurrentFilePercentage)%;background:var(--cyan)"></i></div>
                <div>当前文件 @UpdateSvc.CurrentFilePercentage% · 总进度 @UpdateSvc.TotalPercentage%</div>
            </div>
            <div class="upd-actions">
                <button class="mb-btn" @onclick="OnUpdateCancel">取消更新</button>
            </div>
        }
        else if (UpdateSvc.VersionState == VersionState.OUTDATED && UpdateSvc.ManualUpdateRequired)
        {
            <div class="set-hint-block">发现新版本 v@(UpdateSvc.ServerGameVersion)，需要手动下载安装。</div>
            <div class="upd-actions">
                <button class="mb-btn primary" @onclick="OnManualDownload" disabled="@(string.IsNullOrEmpty(UpdateSvc.ManualDownloadURL))">手动下载</button>
            </div>
        }
        else if (UpdateSvc.VersionState == VersionState.OUTDATED)
        {
            <div class="set-hint-block">发现新版本 v@(UpdateSvc.ServerGameVersion) · 更新大小 @(UpdateSvc.UpdateSizeInKb) KB</div>
            <div class="upd-actions">
                <button class="mb-btn primary" @onclick="OnUpdateNow">立即更新</button>
            </div>
        }
        else if (UpdateSvc.VersionState == VersionState.UPTODATE)
        {
            <div class="set-hint-block">客户端已是最新版本。</div>
            <div class="upd-actions">
                <button class="mb-btn" @onclick="OnUpdateCheck">重新检查</button>
            </div>
        }
        else if (!UpdateSvc.IsAvailable)
        {
            <div class="set-hint-block">更新服务不可用：环境未就绪或未配置更新镜像。</div>
        }
        else if (UpdateSvc.LastError.Length > 0)
        {
            <div class="set-hint-block">检查更新失败：@UpdateSvc.LastError</div>
            <div class="upd-actions">
                <button class="mb-btn" @onclick="OnUpdateCheck">重试</button>
            </div>
        }
        else
        {
            <div class="set-hint-block">尚未检查更新。</div>
            <div class="upd-actions">
                <button class="mb-btn primary" @onclick="OnUpdateCheck">立即检查</button>
            </div>
        }
    };

    private void OnUpdateCheck() => UpdateSvc.CheckForUpdates();

    private void OnUpdateNow() => UpdateSvc.StartUpdate();

    private void OnUpdateCancel() => UpdateSvc.StopUpdate();

    private void OnManualDownload()
    {
        if (!string.IsNullOrEmpty(UpdateSvc.ManualDownloadURL))
            ProcessLauncher.StartShellProcess(UpdateSvc.ManualDownloadURL);
    }

    /// <summary>组件面板（r9-5，原版 ComponentsPanel：UpdaterConfig.ini [CustomComponents] 的组件
    /// 状态列表 + 单独下载；「检查组件更新」复用主更新检查以填充远程标识）。</summary>
    private RenderFragment RenderComponents() => __builder =>
    {
        <div class="set-sec-title">@CurrentSectionTitle()</div>
        <div class="set-hint-block">自定义组件列表来自 UpdaterConfig.ini [CustomComponents]。点击「检查组件更新」从服务器读取组件版本信息；可更新的组件可单独下载。</div>
        <div class="upd-actions">
            <button class="mb-btn primary" @onclick="OnUpdateCheck"
                    disabled="@(UpdateSvc.IsBusy || UpdateSvc.IsComponentDownloadInProgress)">检查组件更新</button>
        </div>

        @if (!UpdateSvc.IsAvailable)
        {
            <div class="set-hint-block">组件检查不可用：环境未就绪或未配置更新镜像。</div>
        }
        else if (UpdateSvc.CustomComponents.Count == 0)
        {
            <div class="set-hint-block">未配置自定义组件。</div>
        }
        else
        {
            <div class="cc-list">
                @foreach (var cc in UpdateSvc.CustomComponents)
                {
                    (string stateText, string stateCls) = ComponentState(cc);
                    <div class="cc-row">
                        <div class="cc-main">
                            <span class="cc-name">@cc.GUIName</span>
                            <span class="cc-state @stateCls">@stateText</span>
                        </div>
                        @if (cc.IsBeingDownloaded)
                        {
                            var pct = UpdateSvc.GetComponentDownloadPercentage(cc);
                            <div class="cc-prog"><i style="width:@(pct)%"></i><em>@(pct)%</em></div>
                        }
                        else if (cc.Initialized && ComponentDownloadable(cc))
                        {
                            <button class="mb-btn" @onclick="() => OnComponentDownload(cc)">下载</button>
                        }
                    </div>
                }
            </div>
        }
    };

    /// <summary>组件是否可下载（未安装或远程标识与本地不一致）。</summary>
    private static bool ComponentDownloadable(CustomComponent cc)
        => string.IsNullOrEmpty(cc.LocalIdentifier) || cc.RemoteIdentifier != cc.LocalIdentifier;

    /// <summary>组件状态文案与样式（原版 ComponentsPanel 的列表状态文本语义）。</summary>
    private static (string Text, string Css) ComponentState(CustomComponent cc)
    {
        if (!cc.Initialized)
            return ("未检查", "dim");
        if (string.IsNullOrEmpty(cc.LocalIdentifier))
            return ("未安装", "err");
        return cc.RemoteIdentifier != cc.LocalIdentifier
            ? ("可更新", "warn")
            : ("已最新", "ok");
    }

    private void OnComponentDownload(CustomComponent cc)
    {
        if (cc.IsBeingDownloaded)
            return;
        cc.DownloadComponent();
        StateHasChanged();
    }

