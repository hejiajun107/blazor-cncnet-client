        <div class="set-row" data-setting="Options:CheckforUpdates">
            <div class="set-info"><span class="set-name">@Ui("Settings.CheckUpdates", "Check for updates on startup")</span><span class="set-hint">CHECK FOR UPDATES ON START</span></div>
            <div class="set-ctl">
                <label class="set-toggle">
                    <input type="checkbox" checked="@(GetBool("checkUpdates", SettingsSvc.Ini.CheckForUpdates.Value))"
                           @onchange="@(e => SetDraftBool("checkUpdates", e))" />
                    <span class="tk"></span>
                </label>
            </div>
        </div>
        <div class="set-row">
            <div class="set-info"><span class="set-name">@Ui("Settings.LocalVersion", "Local version")</span><span class="set-hint">LOCAL VERSION</span></div>
            <div class="set-ctl"><span class="set-val">@UpdateSvc.GameVersion</span></div>
        </div>
        <div class="set-row">
            <div class="set-info"><span class="set-name">@Ui("Settings.ServerVersion", "Server version")</span><span class="set-hint">SERVER VERSION</span></div>
            <div class="set-ctl"><span class="set-val">@UpdateSvc.ServerGameVersion</span></div>
        </div>

        @if (UpdateSvc.VersionState == VersionState.UPDATECHECKINPROGRESS)
        {
            <div class="set-hint-block">@Ui("Settings.CheckingUpdates", "Checking for updates…")</div>
        }
        else if (UpdateSvc.VersionState == VersionState.UPDATEINPROGRESS)
        {
            <div class="set-hint-block">
                <div>@F("Settings.Downloading", "Downloading: {0}", UpdateSvc.CurrentFileName.Length > 0 ? UpdateSvc.CurrentFileName : Ui("Settings.Preparing", "Preparing…"))</div>
                <div class="upd-progress"><i style="width:@(UpdateSvc.CurrentFilePercentage)%;background:var(--cyan)"></i></div>
                <div>@F("Settings.Progress", "Current file {0}% · total {1}%", UpdateSvc.CurrentFilePercentage, UpdateSvc.TotalPercentage)</div>
            </div>
            <div class="upd-actions">
                <button class="mb-btn" @onclick="OnUpdateCancel">@Ui("Settings.CancelUpdate", "Cancel update")</button>
            </div>
        }
        else if (UpdateSvc.VersionState == VersionState.OUTDATED && UpdateSvc.ManualUpdateRequired)
        {
            <div class="set-hint-block">@F("Settings.ManualUpdateRequired", "New version v{0} found; manual download and installation required.", UpdateSvc.ServerGameVersion)</div>
            <div class="upd-actions">
                <button class="mb-btn primary" @onclick="OnManualDownload" disabled="@(string.IsNullOrEmpty(UpdateSvc.ManualDownloadURL))">@Ui("Settings.ManualDownload", "Manual download")</button>
            </div>
        }
        else if (UpdateSvc.VersionState == VersionState.OUTDATED)
        {
            <div class="set-hint-block">@F("Settings.UpdateAvailable", "New version v{0} found · update size {1} KB", UpdateSvc.ServerGameVersion, UpdateSvc.UpdateSizeInKb)</div>
            <div class="upd-actions">
                <button class="mb-btn primary" @onclick="OnUpdateNow">@Ui("Settings.UpdateNow", "Update now")</button>
            </div>
        }
        else if (UpdateSvc.VersionState == VersionState.UPTODATE)
        {
            <div class="set-hint-block">@Ui("Settings.UpToDate", "The client is up to date.")</div>
            <div class="upd-actions">
                <button class="mb-btn" @onclick="OnUpdateCheck">@Ui("Settings.CheckAgain", "Check again")</button>
            </div>
        }
        else if (!UpdateSvc.IsAvailable)
        {
            <div class="set-hint-block">@Ui("Settings.UpdateUnavailable", "Update service unavailable: environment not ready or no update mirror configured.")</div>
        }
        else if (UpdateSvc.LastError.Length > 0)
        {
            <div class="set-hint-block">@F("Settings.CheckFailed", "Update check failed: {0}", UpdateSvc.LastError)</div>
            <div class="upd-actions">
                <button class="mb-btn" @onclick="OnUpdateCheck">@Ui("Settings.Retry", "Retry")</button>
            </div>
        }
        else
        {
            <div class="set-hint-block">@Ui("Settings.NotChecked", "Updates have not been checked yet.")</div>
            <div class="upd-actions">
                <button class="mb-btn primary" @onclick="OnUpdateCheck">@Ui("Settings.CheckNow", "Check now")</button>
            </div>
        }
        @Extras("update")
    };

    private void OnUpdateCheck() => UpdateSvc.CheckForUpdates();

    private void OnUpdateNow() => UpdateSvc.StartUpdate();

    private void OnUpdateCancel() => UpdateSvc.StopUpdate();

    private void OnManualDownload()
    {
        if (!string.IsNullOrEmpty(UpdateSvc.ManualDownloadURL))
            ProcessLauncher.StartShellProcess(UpdateSvc.ManualDownloadURL);
    }

    /// <summary>组件面板（r9-5，原版 ComponentsPanel：UpdaterConfig.ini [CustomComponents] 的组件
    /// 状态列表 + 单独下载；「检查组件更新」复用主更新检查以填充远程标识）。</summary>
    private RenderFragment RenderComponents() => __builder =>
    {
        <div class="set-sec-title">@CurrentSectionTitle()</div>
        <div class="set-hint-block">@Ui("Settings.ComponentsHint", "The custom component list comes from UpdaterConfig.ini [CustomComponents]. Click \"Check component updates\" to read component versions from the server; updatable components can be downloaded individually.")</div>
        <div class="upd-actions">
            <button class="mb-btn primary" @onclick="OnUpdateCheck"
                    disabled="@(UpdateSvc.IsBusy || UpdateSvc.IsComponentDownloadInProgress)">@Ui("Settings.CheckComponents", "Check component updates")</button>
        </div>

        @if (!UpdateSvc.IsAvailable)
        {
            <div class="set-hint-block">@Ui("Settings.ComponentsUnavailable", "Component check unavailable: environment not ready or no update mirror configured.")</div>
        }
        else if (UpdateSvc.CustomComponents.Count == 0)
        {
            <div class="set-hint-block">@Ui("Settings.NoCustomComponents", "No custom components configured.")</div>
        }
        else
        {
            <div class="cc-list">
                @foreach (var cc in UpdateSvc.CustomComponents)
                {
                    (string stateText, string stateCls) = ComponentState(cc);
                    <div class="cc-row">
                        <div class="cc-main">
                            <span class="cc-name">@cc.GUIName</span>
                            <span class="cc-state @stateCls">@stateText</span>
                        </div>
                        @if (cc.IsBeingDownloaded)
                        {
                            var pct = UpdateSvc.GetComponentDownloadPercentage(cc);
                            <div class="cc-prog"><i style="width:@(pct)%"></i><em>@(pct)%</em></div>
                        }
                        else if (cc.Initialized && ComponentDownloadable(cc))
                        {
                            <button class="mb-btn" @onclick="() => OnComponentDownload(cc)">@Ui("Settings.Download", "Download")</button>
                        }
                    </div>
                }
            </div>
        }
        @Extras("components")
    };

    /// <summary>组件是否可下载（未安装或远程标识与本地不一致）。</summary>
    private static bool ComponentDownloadable(CustomComponent cc)
        => string.IsNullOrEmpty(cc.LocalIdentifier) || cc.RemoteIdentifier != cc.LocalIdentifier;

    /// <summary>组件状态文案与样式（原版 ComponentsPanel 的列表状态文本语义）。</summary>
    private static (string Text, string Css) ComponentState(CustomComponent cc)
    {
        if (!cc.Initialized)
            return (Ui("Settings.Component.NotChecked", "Not checked"), "dim");
        if (string.IsNullOrEmpty(cc.LocalIdentifier))
            return (Ui("Settings.Component.NotInstalled", "Not installed"), "err");
        return cc.RemoteIdentifier != cc.LocalIdentifier
            ? (Ui("Settings.Component.Updatable", "Updatable"), "warn")
            : (Ui("Settings.Component.UpToDate", "Up to date"), "ok");
    }

    private void OnComponentDownload(CustomComponent cc)
    {
        if (cc.IsBeingDownloaded)
            return;
        cc.DownloadComponent();
        StateHasChanged();
    }

    private RenderFragment RenderPrivacy() => __builder =>
    {
        <div class="set-sec-title">@CurrentSectionTitle()</div>
        <div class="set-row" data-setting="Options:PrivacyPolicyAccepted">
            <div class="set-info"><span class="set-name">@Ui("Settings.PrivacyAccepted", "Privacy policy accepted")</span><span class="set-hint">PRIVACY POLICY ACCEPTED</span></div>
            <div class="set-ctl">
                <label class="set-toggle">
                    <input type="checkbox" checked="@(GetBool("privacyAccepted", SettingsSvc.Ini.PrivacyPolicyAccepted.Value))"
                           @onchange="@(e => SetDraftBool("privacyAccepted", e))" />
                    <span class="tk"></span>
                </label>
            </div>
        </div>
        <div class="set-row @(IniRowClass("discord"))" data-setting="MultiPlayer:DiscordIntegration">
            <div class="set-info"><span class="set-name">@IniText("discord", Ui("Settings.Discord", "Discord integration"))</span><span class="set-hint">DISCORD INTEGRATION</span></div>
            <div class="set-ctl">
                <label class="set-toggle">
                    <input type="checkbox" checked="@(GetBool("discord", SettingsSvc.Ini.DiscordIntegration.Value))"
                           @onchange="@(e => SetDraftBool("discord", e))" />
                    <span class="tk"></span>
                </label>
            </div>
        </div>
        <div class="set-row @(IniRowClass("steam"))" data-setting="MultiPlayer:SteamIntegration">
            <div class="set-info"><span class="set-name">@IniText("steam", Ui("Settings.Steam", "Steam integration"))</span><span class="set-hint">STEAM INTEGRATION</span></div>
            <div class="set-ctl">
                <label class="set-toggle">
                    <input type="checkbox" checked="@(GetBool("steam", SettingsSvc.Ini.SteamIntegration.Value))"
                           @onchange="@(e => SetDraftBool("steam", e))" />
                    <span class="tk"></span>
                </label>
            </div>
        </div>
    };

    public void Dispose()
    {
        SettingsSvc.SettingsChanged -= OnSettingsChanged;
        ThemeProvider.ThemeChanged -= OnThemeChanged;
        TranslationSvc.LanguageChanged -= OnLanguageChanged;
        UpdateSvc.StateChanged -= OnUpdateStateChanged;
        UpdateSvc.ComponentChanged -= OnComponentChanged;
    }
}
