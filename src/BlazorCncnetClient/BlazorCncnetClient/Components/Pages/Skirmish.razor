        if (_sides.Length == 0)
            _sides = new[] { "GDI", "Nod", "Allies", "Soviet" };

        Svc.Changed += OnChanged;
        ThemeProvider.ThemeChanged += OnThemeChanged;
        MapLoader.MapLoadingComplete += OnMapLoadingComplete;
        // 阵营国旗等游戏目录资源经 GameContentServer 伺服（幂等：已启动则复用）
        ContentServer.Start(ProgramConstants.GamePath);
