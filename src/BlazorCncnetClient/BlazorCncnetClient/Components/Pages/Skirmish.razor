    /// 空槽（null）点击仅取消选中。</summary>
    private void OnPlayerRowClick(PlayerInfo? player)
    {
        // 点击移除按钮时按钮已 stopPropagation，此处兜底：已被移除的 AI 不再选中
        if (player is not null && !Svc.GetPlayerInfos().Contains(player))
            return;
        _selectedPlayer = player;
    }

    private void OnSpawnClick(int index)
    {
        // 强制随机出生地图：禁用地图点击选点（同原版 EnableContextMenu 条件）
        if (Svc.ForceRandomStarts)
            return;
        var sp = SpawnPoints.FirstOrDefault(s => s.Index == index);
        if (sp is null)
            return;

        // 地图点击分配当前选中的玩家（未选中时默认人类玩家）
        var target = _selectedPlayer ?? Svc.HumanPlayer;
        if (target is null)
            return;

        var occupant = Svc.GetPlayerInfos().FirstOrDefault(p => p.StartingLocation == index);
        if (occupant is not null && !ReferenceEquals(occupant, target))
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", $"出生点 {index} 已被 {occupant.Name} 占用");
            return;
        }

        if (target.IsAI)
            Svc.SetAIOption(target, target.SideId, target.ColorId, index);
        else
            Svc.SetHumanOption(target.SideId, target.ColorId, index);
    }

