    /// <summary>重置 AI：移除全部 AI 后重新添加一个默认 Easy AI（同原版 InitDefaultSettings 语义）。</summary>
    private void OnResetAI()
    {
        while (Svc.AIPlayers.Count > 0)
            Svc.RemoveAI(Svc.AIPlayers[0]);
        try
        {
            Svc.AddAI();
        }
        catch
        {
            // 忽略（无 AI 时添加必然成功）
        }
    }

