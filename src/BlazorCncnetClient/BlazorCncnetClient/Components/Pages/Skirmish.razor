@page "/skirmish"
@implements IDisposable
@using CnCNetClient.Core
@using CnCNetClient.Core.Statistics
@using CnCNetClient.Domain.Multiplayer
@using SixLabors.ImageSharp.PixelFormats
@inject SkirmishService Svc
@inject MapLoader MapLoader
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IThemeProvider ThemeProvider
@inject MessageBoxService MessageBox
@inject SkirmishLaunchService GameLauncher
@inject DiscordPresenceService Discord

@if (!Svc.IsActive)
{
    <div class="game-empty page-anim">
        <div class="ge-box pop-in">
            <div class="ge-title">SKIRMISH</div>
            <div class="ge-sub">遭遇战配置初始化中…</div>
            <button class="mb-btn primary" @onclick="BackToMenu">返回主菜单</button>
        </div>
    </div>
}
else
{
    <div class="groom page-anim">
        <header class="groom-top item-in">
            <div class="gt-left">
                <span class="gt-badge host">遭遇战<span class="en">SKIRMISH</span></span>
                <div class="gt-tbox">
                    <span class="gt-title">本地对战配置</span>
                    <span class="gt-en">@(Svc.LocalGame?.UIName ?? "—") · 单机 · 人类 @(1) + AI @(Svc.AIPlayers.Count)</span>
                </div>
            </div>
            <div class="gt-right">
                <span class="gt-player">@ProgramConstants.PLAYERNAME</span>
                <button class="mb-btn" @onclick="BackToMenu">返回主菜单</button>
            </div>
        </header>

        <div class="groom-grid">
            <!-- 左列：地图选择（参考原版 lbMapList） -->
            <section class="gl-panel gl-maplist item-in" style="animation-delay:50ms">
                <header class="gl-ph">
                    <span>地图选择 <em>MAP LIST</em></span>
                </header>
                <div class="gl-body">
                    <select class="gl-select" value="@SelectedMapIndex" @onchange="OnMapChange"
                            @oncontextmenu="OnMapContextMenu" @oncontextmenu:preventDefault="true">
                        <option value="-1">— 选择地图 —</option>
                        @foreach (var group in MapGroups)
                        {
                            <optgroup label="@group.Key">
                                @for (int i = 0; i < group.Items.Count; i++)
                                {
                                    var opt = group.Items[i];
                                    <option value="@opt.Index">@(opt.Value.IsFavorite ? "★ " : "")@opt.Display</option>
                                }
                            </optgroup>
                        }
                    </select>

                    <!-- 地图工具条（原版 tbMapSearch / btnShowFavoriteMaps / btnMapSortAlphabetically / btnPickRandomMap） -->
                    <div class="map-tools">
                        <input class="gl-input map-search" placeholder="搜索地图…" value="@_mapSearch" @oninput="OnMapSearchInput" />
                        <button type="button" class="mt-btn @(_favOnly ? "on" : "")" title="仅显示收藏地图" @onclick="OnToggleFavOnly">
                            ★<span class="en">FAV</span>
                        </button>
                        <button type="button" class="mt-btn @(_sortMode != 0 ? "on" : "")" title="按名称排序" @onclick="OnCycleSort">
                            <span class="en">@SortModeLabel</span>
                        </button>
                        <button type="button" class="mt-btn" title="随机选择地图" @onclick="OnPickRandomMap">
                            <span class="en">RND</span>
                        </button>
                    </div>

                    @if (Svc.SelectedMap is not null)
                    {
                        <div class="map-info">
                            <div class="mi-row"><span>地图</span><b>@Svc.SelectedMap.Map.Name</b></div>
                            <div class="mi-row"><span>作者</span><b>@Svc.SelectedMap.Map.Author</b></div>
                            <div class="mi-row"><span>尺寸</span><b>@Svc.SelectedMap.Map.GetSizeString()</b></div>
                            <div class="mi-row"><span>模式</span><b>@Svc.SelectedMap.GameMode.UIName</b></div>
                            <div class="mi-row"><span>人数</span><b>@(Svc.SelectedMap.MinPlayers)–@(Svc.SelectedMap.MaxPlayers)</b></div>
                            <div class="mi-row"><span>排名</span><b class="mi-rank">@RankStars</b></div>
                            <div class="mi-row">
                                <span>收藏</span>
                                <button type="button" class="mi-star @(Svc.SelectedMap.IsFavorite ? "on" : "")" @onclick="OnToggleFavorite">
                                    ★ <b>@(Svc.SelectedMap.IsFavorite ? "已收藏" : "收藏此图")</b>
                                </button>
                            </div>
                            @if (!string.IsNullOrEmpty(Svc.SelectedMap.Map.Briefing))
                            {
                                <div class="mi-divider"></div>
                                <div class="mi-briefing">@Svc.SelectedMap.Map.Briefing</div>
                            }
                        </div>
                    }
                </div>
            </section>

            <!-- 右上·左：玩家配置（参考原版 PlayerOptionsPanel 紧凑槽位表格：每行=玩家，列=阵营/颜色/队伍） -->
            <section class="gl-panel gl-players item-in" style="animation-delay:100ms">
                <header class="gl-ph">
                    <span>玩家配置 <em>@TotalPlayers/@Svc.MaxPlayers</em></span>
                    <span class="gl-lock">@(Svc.IsCoop ? "合作" : "对战")</span>
                </header>

                <div class="gl-body">
                    <!-- 表头行（参考原版 PLAYER/SIDE/COLOR/TEAM 标题） -->
                    <div class="gl-tr gl-tr-head">
                        <span class="gl-tc-name">玩家 <em>PLAYER</em></span>
                        <span>阵营 <em>SIDE</em></span>
                        <span>颜色 <em>COLOR</em></span>
                        <span>队伍 <em>TEAM</em></span>
                    </div>

                    <!-- 人类玩家行 -->
                    <div class="gl-tr human">
                        <div class="gl-tc-name">
                            <span class="slot-color" style="background:@ToCss(GetColor(HumanColorId))"></span>
                            <span class="nm">@ProgramConstants.PLAYERNAME</span>
                            <em class="slot-host">YOU</em>
                        </div>
                        <select class="gl-select" value="@HumanSideId" @onchange="OnHumanSideChange">
                            @for (int s = 0; s < Sides.Length; s++)
                            {
                                <option value="@s">@Sides[s]</option>
                            }
                            <option value="@Sides.Length">Spectator</option>
                        </select>
                        <select class="gl-select" value="@HumanColorId" @onchange="OnHumanColorChange">
                            @for (int c = 0; c < _colors.Count; c++)
                            {
                                <option value="@_colors[c].Index">@_colors[c].Name</option>
                            }
                        </select>
                        <select class="gl-select" value="@HumanTeamId" disabled="@(!Svc.TeamsEnabled || Svc.UseTeamStartMappings)" @onchange="OnHumanTeamChange">
                            <option value="0">-</option>
                            @for (int t = 0; t < TeamNames.Count; t++)
                            {
                                <option value="@(t + 1)">@TeamNames[t]</option>
                            }
                        </select>
                    </div>

                    <!-- AI 玩家行 -->
                    @for (int i = 0; i < Svc.AIPlayers.Count; i++)
                    {
                        var ai = Svc.AIPlayers[i];
                        <div class="gl-tr">
                            <div class="gl-tc-name">
                                <span class="slot-color" style="background:@ToCss(GetColor(ai.ColorId))"></span>
                                <span class="nm">AI @(i + 1)</span>
                                <select class="gl-select ai-level" value="@ai.AILevel" @onchange="(e) => OnAILevelChange(ai, e)">
                                    <option value="0">简单</option>
                                    <option value="1">中等</option>
                                    <option value="2">困难</option>
                                </select>
                                <button class="ai-remove" title="移除" @onclick="() => OnRemoveAI(ai)">✕</button>
                            </div>
                            <select class="gl-select" value="@ai.SideId" @onchange="(e) => OnAISideChange(ai, e)">
                                @for (int s = 0; s < Sides.Length; s++)
                                {
                                    <option value="@s">@Sides[s]</option>
                                }
                            </select>
                            <select class="gl-select" value="@ai.ColorId" @onchange="(e) => OnAIColorChange(ai, e)">
                                @for (int c = 0; c < _colors.Count; c++)
                                {
                                    <option value="@_colors[c].Index">@_colors[c].Name</option>
                                }
                            </select>
                            <select class="gl-select" value="@ai.TeamId" disabled="@(!Svc.TeamsEnabled || Svc.UseTeamStartMappings)" @onchange="(e) => OnAITeamChange(ai, e)">
                                <option value="0">-</option>
                                @for (int t = 0; t < TeamNames.Count; t++)
                                {
                                    <option value="@(t + 1)">@TeamNames[t]</option>
                                }
                            </select>
                        </div>
                    }

                    @if (Svc.AIPlayers.Count < SkirmishService.MaxAIPlayersConst)
                    {
                        <button class="mb-btn add-ai-btn" @onclick="OnAddAI">
                            + 添加 AI 玩家<span class="en">ADD AI</span>
                        </button>
                    }

                    <!-- 自动结盟出生点映射（启用时显示，随表体滚动） -->
                    @if (Svc.UseTeamStartMappings)
                    {
                        <div class="ally-grid">
                            @for (int st = 1; st <= Svc.MaxPlayers; st++)
                            {
                                var teamValue = GetMappingTeam(st);
                                <div class="ally-cell">
                                    <span class="ally-idx">@st</span>
                                    <select class="gl-select ally-sel" value="@teamValue"
                                            disabled="@(!Svc.AllowedTeamStartMappingLocations.Contains(st))"
                                            @onchange="(e) => OnMappingChange(st, e)">
                                        @foreach (var opt in MappingTeamOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- 自动结盟开关 + 预设（固定条） -->
                <div class="gl-ally">
                    <div class="ally-head">
                        <label class="gl-check">
                            <input type="checkbox" checked="@Svc.UseTeamStartMappings"
                                   disabled="@(!Svc.TeamStartMappingsAllowed)"
                                   @onchange="OnToggleAutoAlly" />
                            <span>自动结盟<span class="en">AUTO ALLY</span></span>
                        </label>
                        <select class="gl-select ally-preset" value="0"
                                disabled="@(!Svc.UseTeamStartMappings || Svc.TeamStartMappingPresets.Count == 0)"
                                @onchange="OnAutoAllyPresetChange">
                            <option value="0">自定义</option>
                            @for (int p = 0; p < Svc.TeamStartMappingPresets.Count; p++)
                            {
                                <option value="@(p + 1)">@Svc.TeamStartMappingPresets[p].Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="cfg-actions">
                    <button class="mb-btn danger" @onclick="OnResetAI">重置 AI<span class="en">RESET AI</span></button>
                    <button class="mb-btn primary start-btn" disabled="@(Svc.SelectedMap is null)" @onclick="OnStartGame">
                        开始游戏<span class="en">START</span>
                    </button>
                </div>
            </section>

            <!-- 右上·右：游戏选项（参考原版 GameOptionsPanel + 预设 LoadOrSaveGameOptionPresetWindow） -->
            <section class="gl-panel gl-options item-in" style="animation-delay:150ms">
                <header class="gl-ph">
                    <span>游戏选项 <em>GAME OPTIONS</em></span>
                    <button type="button" class="mb-btn go-preset-btn" @onclick="OpenPresetDialog">
                        预设<span class="en">PRESET</span>
                    </button>
                </header>
                <div class="gl-body">
                    <div class="go-grid">
                        @foreach (var opt in CheckBoxOptions)
                        {
                            <label class="gl-check go-check">
                                <input type="checkbox" checked="@opt.Checked"
                                       @onchange="(e) => OnCheckBoxOptionChange(opt, e)" />
                                <span>@opt.DisplayName</span>
                            </label>
                        }
                    </div>
                    @foreach (var dd in DropDownOptions)
                    {
                        <div class="go-dd">
                            <label>@dd.DisplayName</label>
                            <select class="gl-select" value="@dd.SelectedIndex" @onchange="(e) => OnDropDownOptionChange(dd, e)">
                                @for (int i = 0; i < dd.Items.Count; i++)
                                {
                                    <option value="@i">@dd.Items[i]</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </section>

            <!-- 右下：地图预览（参考原版 MapPreviewBox） -->
            <section class="gl-panel gl-preview item-in" style="animation-delay:200ms">
                <header class="gl-ph">
                    <span>地图预览 <em>MAP PREVIEW</em></span>
                    <span class="gl-mapname">@(Svc.SelectedMap?.Map.Name ?? "未选择地图")</span>
                </header>
                <div class="gl-body">
                    <div class="cfg-map-preview">
                        <MapThumbnail MapHash="Svc.SelectedMap?.Map.SHA1" MapName="Svc.SelectedMap?.Map.UntranslatedName" CssClass="cfg-thumb" />
                        @if (Svc.SelectedMap is null)
                        {
                            <div class="cfg-map-none">请选择地图</div>
                        }
                        else
                        {
                            <div class="spawn-layer">
                                @foreach (var sp in SpawnPoints)
                                {
                                    var spStyle = $"left:{sp.X * 100:0.##}%;top:{sp.Y * 100:0.##}%";
                                    var spCls = sp.IsSelf ? "self" : sp.OccupantName is null ? "free" : "taken";
                                    <button type="button"
                                            class="spawn-dot @spCls"
                                            style="@spStyle"
                                            title="@(sp.OccupantName is null ? $"出生点 {sp.Index}" : $"出生点 {sp.Index} · {sp.OccupantName}")"
                                            @onclick="() => OnSpawnClick(sp.Index)">
                                        <span class="spawn-num">@sp.Index</span>
                                        @if (sp.OccupantName is not null)
                                        {
                                            <span class="spawn-owner" style="background:@ToCss(GetColor(sp.ColorIndex))"></span>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>

        <!-- 地图右键菜单（原版 mapContextMenu：收藏/复制/删除/定位文件） -->
        @if (_mapCtxVisible && _mapCtxTarget is not null)
        {
            var m = _mapCtxTarget;
            <div class="ctx-backdrop" @onclick="CloseMapContextMenu"
                 @oncontextmenu="CloseMapContextMenu" @oncontextmenu:preventDefault="true"></div>
            <div class="ctx-menu" style="left:@(_mapCtxX)px;top:@(_mapCtxY)px">
                <div class="ctx-title">@m.Map.Name</div>
                <button class="ctx-item" @onclick="() => ToggleMapFavorite(m)">
                    <span>@(m.IsFavorite ? "取消收藏" : "收藏")</span><span class="en">@(m.IsFavorite ? "UNFAVORITE" : "FAVORITE")</span>
                </button>
                <button class="ctx-item" @onclick="() => CopyMapName(m)">
                    <span>复制地图名</span><span class="en">COPY NAME</span>
                </button>
                <button class="ctx-item" @onclick="() => CopyMapName(m, true)">
                    <span>复制原名</span><span class="en">COPY ORIGINAL</span>
                </button>
                @if (!m.Map.Official)
                {
                    <div class="ctx-sep"></div>
                    <button class="ctx-item" @onclick="() => OpenMapFolder(m)">
                        <span>显示在文件夹</span><span class="en">SHOW IN FOLDER</span>
                    </button>
                    <button class="ctx-item warn" @onclick="() => DeleteMap(m)">
                        <span>删除地图</span><span class="en">DELETE</span>
                    </button>
                }
            </div>
        }

        <!-- 游戏选项预设对话框（原版 LoadOrSaveGameOptionPresetWindow） -->
        <GameOptionPresetDialog Options="Svc.GameOptions"
                                Visible="@_presetOpen"
                                OnClose="ClosePresetDialog"
                                OnPresetApplied="OnPresetApplied" />
    </div>
}

@code {
    private List<ColorOption> _colors = new();
    private string[] _sides = Array.Empty<string>();
    private string[] Sides => _sides;

    private List<MapGroup> MapGroups => _mapGroups;
    private List<MapGroup> _mapGroups = new();
    private List<MapOption> _mapOptions = new();

    private int TotalPlayers => 1 + Svc.AIPlayers.Count;

    /// <summary>游戏选项：复选框（G7，按原版 GameLobbyBase.ini 顺序）。</summary>
    private List<GameSessionCheckBoxOption> CheckBoxOptions =>
        Svc.GameOptions.OfType<GameSessionCheckBoxOption>().ToList();

    /// <summary>游戏选项：下拉框（G7，cmbCredits / cmbStartingUnits）。</summary>
    private List<GameSessionDropDownOption> DropDownOptions =>
        Svc.GameOptions.OfType<GameSessionDropDownOption>().ToList();

    private int HumanSideId => Svc.HumanPlayer?.SideId ?? 0;
    private int HumanColorId => Svc.HumanPlayer?.ColorId ?? 0;
    private int HumanStartLocation => Svc.HumanPlayer?.StartingLocation ?? 0;
    private int HumanTeamId => Svc.HumanTeamId;

    /// <summary>队伍下拉显示名（1..4 → A..D）。</summary>
    private static List<string> TeamNames => ProgramConstants.TEAMS;

    /// <summary>自动结盟出生点下拉选项（x=阻挡 / -=无 / A..D=队伍）。</summary>
    private static List<TeamOption> MappingTeamOptions => new()
    {
        new(TeamStartMapping.NO_PLAYER, "阻挡"),
        new(TeamStartMapping.NO_TEAM, "无队伍"),
        new("A", "A"),
        new("B", "B"),
        new("C", "C"),
        new("D", "D"),
    };

    private int SelectedMapIndex
    {
        get
        {
            if (Svc.SelectedMap is null)
                return -1;
            for (int i = 0; i < _mapOptions.Count; i++)
            {
                if (_mapOptions[i].Value == Svc.SelectedMap)
                    return i;
            }
            return -1;
        }
    }

    private List<SpawnPointState> SpawnPoints => Svc.GetSpawnPointStates();

    protected override void OnInitialized()
    {
        _colors = LoadColorsSafe();
        _sides = ClientConfiguration.Instance.Sides.Split(',', StringSplitOptions.RemoveEmptyEntries);
        if (_sides.Length == 0)
            _sides = new[] { "GDI", "Nod", "Allies", "Soviet" };

        Svc.Changed += OnChanged;
        ThemeProvider.ThemeChanged += OnThemeChanged;
        MapLoader.MapLoadingComplete += OnMapLoadingComplete;
        RefreshMaps();
        Svc.Initialize();
    }

    private static List<ColorOption> LoadColorsSafe()
    {
        try
        {
            var colors = MultiplayerColor.LoadColors();
            return colors.Select(c => new ColorOption(c.Name, c.GameColorIndex, c.XnaColor)).ToList();
        }
        catch
        {
            // 回退默认色板
        }
        return new List<ColorOption>
        {
            new("红", 0, new Rgba32(255, 60, 60, 255)),
            new("蓝", 1, new Rgba32(70, 120, 255, 255)),
            new("青", 2, new Rgba32(80, 220, 255, 255)),
            new("绿", 3, new Rgba32(80, 220, 120, 255)),
            new("黄", 4, new Rgba32(255, 220, 80, 255)),
            new("橙", 5, new Rgba32(255, 150, 60, 255)),
            new("紫", 6, new Rgba32(190, 120, 255, 255)),
            new("粉", 7, new Rgba32(255, 130, 200, 255)),
        };
    }

    private void RefreshMaps()
    {
        IEnumerable<MapOption> query = MapLoader.GameModeMaps
            .Select((gmm, i) => new MapOption(gmm, i, gmm.GameMode.UIName, gmm.ToUIString()));

        // 工具条过滤/排序（原版 TbMapSearch_InputReceived / btnShowFavoriteMaps / btnMapSortAlphabetically）
        if (_favOnly)
            query = query.Where(o => o.Value.IsFavorite);
        if (!string.IsNullOrWhiteSpace(_mapSearch))
        {
            var kw = _mapSearch.Trim();
            query = query.Where(o =>
                o.Value.Map.Name.Contains(kw, StringComparison.OrdinalIgnoreCase) ||
                o.Value.Map.UntranslatedName.Contains(kw, StringComparison.OrdinalIgnoreCase));
        }
        if (_sortMode == 1)
            query = query.OrderBy(o => o.Display, StringComparer.OrdinalIgnoreCase);
        else if (_sortMode == 2)
            query = query.OrderByDescending(o => o.Display, StringComparer.OrdinalIgnoreCase);

        // 过滤/排序后重建索引：select 的 option value 与 SelectedMapIndex 均以列表内位置为准
        _mapOptions = query.Select((o, i) => o with { Index = i }).ToList();
        _mapGroups = _mapOptions.GroupBy(o => o.Mode)
            .Select(g => new MapGroup(g.Key, g.ToList()))
            .ToList();
    }

    private void OnMapLoadingComplete(object? sender, EventArgs e) =>
        _ = InvokeAsync(() =>
        {
            RefreshMaps();
            StateHasChanged();
        });

    private void OnChanged()
    {
        // r9-4：Discord 呈现同步（原版 SkirmishLobby 在选择地图/阵营时推送）
        if (Svc.SelectedMap is not null)
        {
            // Spectator 时无阵营小图标（原版 SideIndex 为观察者时传空阵营名）
            string side = HumanSideId < Sides.Length ? Sides[HumanSideId] : string.Empty;
            Discord.Skirmish(
                map: Svc.SelectedMap.Map.UntranslatedName,
                mode: Svc.SelectedMap.GameMode.UIName,
                state: "Skirmish",
                side: side
            );
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged(ThemeInfo theme) => _ = InvokeAsync(StateHasChanged);

    // ── 顶部 / 地图 ──

    private async Task BackToMenu()
    {
        var confirm = await MessageBox.ShowAsync("返回主菜单",
            "返回将丢失当前未开始的遭遇战配置。确认返回？",
            MessageBoxButtons.YesNo, MessageBoxKind.Confirm);
        if (!confirm)
            return;
        Nav.NavigateTo("/menu");
    }

    private void OnMapChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int index) || index < 0 || index >= _mapOptions.Count)
            return;
        try
        {
            Svc.ChangeMap(_mapOptions[index].Value);
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
    }

    /// <summary>当前地图排名星数（原版 GetDefaultMapRankIndex 语义：单机胜场统计，0–3 星）。</summary>
    private string RankStars
    {
        get
        {
            if (Svc.SelectedMap is null)
                return "—";
            int stars = GetMapRank(Svc.SelectedMap);
            return new string('★', stars) + new string('☆', 3 - stars);
        }
    }

    private StatisticsManager? _rankStats;
    private bool _rankStatsLoaded;

    private int GetMapRank(GameModeMap gmm)
    {
        try
        {
            // 懒初始化：统计数据库随游戏目录就绪后读取一次（与统计页共用单例）
            _rankStats ??= StatisticsManager.Instance;
            if (!_rankStatsLoaded)
            {
                _rankStats.ReadStatistics(ProgramConstants.GamePath);
                _rankStatsLoaded = true;
            }

            int rank = _rankStats.GetSkirmishRankForDefaultMap(gmm.Map.UntranslatedName, gmm.MaxPlayers);
            return Math.Clamp(rank + 1, 0, 3); // -1(未胜)→0 星 … 2(最佳)→3 星
        }
        catch
        {
            return 0;
        }
    }

    /// <summary>收藏/取消收藏当前地图（同原版 ToggleFavoriteMap 语义：settings INI FavoriteMaps 持久化）。</summary>
    private void OnToggleFavorite()
    {
        var gmm = Svc.SelectedMap;
        if (gmm is null)
            return;
        ToggleMapFavorite(gmm);
    }

    // ── 地图右键菜单（原版 mapContextMenu：收藏/复制地图名/复制原名/删除/定位文件） ──

    private GameModeMap? _mapCtxTarget;
    private bool _mapCtxVisible;
    private double _mapCtxX, _mapCtxY;

    /// <summary>右键地图下拉框：对当前选中的地图打开菜单（右键列表项时 Chromium 会先选中该项）。</summary>
    private void OnMapContextMenu(MouseEventArgs e)
    {
        var gmm = Svc.SelectedMap;
        if (gmm is null)
            return;
        _mapCtxTarget = gmm;
        _mapCtxX = e.ClientX;
        _mapCtxY = e.ClientY;
        _mapCtxVisible = true;
    }

    private void CloseMapContextMenu()
    {
        _mapCtxVisible = false;
        _mapCtxTarget = null;
    }

    /// <summary>收藏/取消收藏指定地图（settings INI FavoriteMaps 持久化，同原版 ToggleFavoriteMap）。</summary>
    private void ToggleMapFavorite(GameModeMap gmm)
    {
        gmm.IsFavorite = UserINISettings.Instance.ToggleFavoriteMap(
            gmm.Map.SHA1, gmm.GameMode.Name, gmm.IsFavorite);
        _ = JS.InvokeVoidAsync("cncnet.toast", gmm.IsFavorite ? $"已收藏：{gmm.Map.Name}" : $"已取消收藏：{gmm.Map.Name}");
        CloseMapContextMenu();
    }

    /// <summary>复制地图名（原版 CopyMapName：译文名；CopyOriginalMapName：UntranslatedName）。</summary>
    private void CopyMapName(GameModeMap gmm, bool original = false)
    {
        _ = JS.InvokeVoidAsync("cncnet.copyText", original ? gmm.Map.UntranslatedName : gmm.Map.Name);
        _ = JS.InvokeVoidAsync("cncnet.toast", "地图名已复制到剪贴板");
        CloseMapContextMenu();
    }

    /// <summary>删除自定义地图（同原版 DeleteMap：确认后删除文件并从地图列表移除）。</summary>
    private async Task DeleteMap(GameModeMap gmm)
    {
        CloseMapContextMenu();
        var confirm = await MessageBox.ShowAsync("删除地图",
            $"确定删除自定义地图“{gmm.Map.UntranslatedName}”吗？该地图文件将被永久移除。",
            MessageBoxButtons.YesNo, MessageBoxKind.Confirm);
        if (!confirm)
            return;
        try
        {
            if (Svc.SelectedMap == gmm)
                Svc.ClearSelectedMap();
            MapLoader.DeleteCustomMap(gmm);
            RefreshMaps();
            _ = JS.InvokeVoidAsync("cncnet.toast", $"已删除：{gmm.Map.UntranslatedName}");
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
    }

    /// <summary>在文件管理器中定位地图文件（原版 OpenContainingFolder）。</summary>
    private void OpenMapFolder(GameModeMap gmm)
    {
        try
        {
            gmm.Map.OpenContainingFolder();
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
        CloseMapContextMenu();
    }

    // ── 地图工具条（原版 tbMapSearch / btnShowFavoriteMaps / btnMapSortAlphabetically / btnPickRandomMap） ──

    private string _mapSearch = string.Empty;
    private bool _favOnly;
    private int _sortMode; // 0=默认 1=A–Z 2=Z–A

    private static readonly string[] SortModeLabels = { "默认", "A–Z", "Z–A" };
    private string SortModeLabel => SortModeLabels[Math.Clamp(_sortMode, 0, 2)];

    private void OnMapSearchInput(ChangeEventArgs e)
    {
        _mapSearch = e.Value?.ToString() ?? string.Empty;
        RefreshMaps();
    }

    private void OnToggleFavOnly()
    {
        _favOnly = !_favOnly;
        RefreshMaps();
    }

    private void OnCycleSort()
    {
        _sortMode = (_sortMode + 1) % 3;
        RefreshMaps();
    }

    private void OnPickRandomMap()
    {
        if (_mapOptions.Count == 0)
            return;
        try
        {
            Svc.ChangeMap(_mapOptions[Random.Shared.Next(_mapOptions.Count)].Value);
        }
        catch (Exception ex)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
        }
    }

