    private static string ToCss(Rgba32 color) => $"rgb({color.R},{color.G},{color.B})";

    /// <summary>阵营图标 URL（原版 {side}icon.png 位于游戏根目录 Resources 下，
    /// 经 GameContentServer 伺服；图标缺失时浏览器触发 onerror 隐藏）。</summary>
    private string SideIconUrl(int index)
    {
        string side = index >= 0 && index < Sides.Length ? Sides[index] : "Spectator";
        try
        {
            return ContentServer.IsRunning
                ? ContentServer.MapUrl("Resources/" + Uri.EscapeDataString(side) + "icon.png")
                : string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }

    /// <summary>根据背景色感知亮度选文字色（深底白字 / 浅底深字，保证颜色块上文字可读）。</summary>
    private static string GetContrastColor(Rgba32 color)
    {
        double luma = (0.299 * color.R + 0.587 * color.G + 0.114 * color.B) / 255.0;
        return luma > 0.55 ? "#0a1520" : "#ffffff";
    }

