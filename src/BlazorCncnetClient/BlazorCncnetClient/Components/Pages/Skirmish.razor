    private void OnToggleAutoAlly(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool use))
            Svc.SetUseTeamStartMappings(use);
    }

    /// <summary>应用选中的预设：下拉第 0 项为 Custom（自定义），其后依次为地图预设；应用后回到 Custom。</summary>
    private void OnAutoAllyPresetChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int v) || v <= 0)
            return;
        Svc.ApplyTeamStartMappingPreset(v - 1);
    }

    /// <summary>读取指定出生点的自动结盟队伍（未配置回退“无队伍”）。</summary>
    private string GetMappingTeam(int start)
    {
        var mapping = Svc.ExtraOptions.TeamStartMappings.FirstOrDefault(m => m.Start == start);
        return mapping?.Team ?? TeamStartMapping.NO_TEAM;
    }

    private void OnMappingChange(int start, ChangeEventArgs e)
    {
        Svc.SetTeamStartMapping(start, e.Value?.ToString() ?? TeamStartMapping.NO_TEAM);
    }

