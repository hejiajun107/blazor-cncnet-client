    private void OnHumanSideChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
            SetHuman(v, HumanColorId, HumanStartLocation);
    }

    private void OnHumanTeamChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
            Svc.SetHumanTeam(v);
    }

    private void OnHumanColorChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
            SetHuman(HumanSideId, v, HumanStartLocation);
    }

    private void OnSpawnClick(int index)
    {
        // 强制随机出生地图：禁用地图点击选点（同原版 EnableContextMenu 条件）
        if (Svc.ForceRandomStarts)
            return;
        var sp = SpawnPoints.FirstOrDefault(s => s.Index == index);
        if (sp is null)
            return;
        if (sp.OccupantName is not null && !sp.IsSelf)
        {
            _ = JS.InvokeVoidAsync("cncnet.toast", $"出生点 {index} 已被 {sp.OccupantName} 占用");
            return;
        }
        SetHuman(HumanSideId, HumanColorId, index);
    }

    private void SetHuman(int side, int color, int start) => Svc.SetHumanOption(side, color, start);

