    private void OnChanged()
    {
        // r9-4：Discord 呈现同步（原版 SkirmishLobby 在选择地图/阵营时推送）
        if (Svc.SelectedMap is not null)
        {
            // Spectator 时无阵营小图标（原版 SideIndex 为观察者时传空阵营名）
            string side = HumanSideId < Sides.Length ? Sides[HumanSideId] : string.Empty;
            Discord.Skirmish(
                map: Svc.SelectedMap.Map.UntranslatedName,
                mode: Svc.SelectedMap.GameMode.UIName,
                state: "Skirmish",
                side: side
            );

            // 排名星数后台加载（换图时旧结果作废，未就绪显示省略号）
            if (!ReferenceEquals(_rankMap, Svc.SelectedMap))
            {
                _rankMap = Svc.SelectedMap;
                _ = LoadRankAsync(Svc.SelectedMap);
            }
        }

        _ = InvokeAsync(StateHasChanged);
    }

