            if (Svc.SelectedMap == gmm)
                Svc.ClearSelectedMap();
            MapLoader.DeleteCustomMap(gmm);
            RefreshMaps();
            _ = JS.InvokeVoidAsync("cncnet.toast", $"已删除：{gmm.Map.UntranslatedName}");
        }
        catch (Exception ex)
