    /// <summary>当前地图排名星数（原版 GetDefaultMapRankIndex 语义：单机胜场统计，0–3 星）。
    /// 统计数据库读取为后台任务，未就绪前显示省略号，避免 UI 线程被 dscore.dat 文件 I/O 阻塞。</summary>
    private string RankStars
    {
        get
        {
            if (Svc.SelectedMap is null)
                return "—";
            if (_rankLoading || _rankStars < 0)
                return "…";
            return new string('★', _rankStars) + new string('☆', 3 - _rankStars);
        }
    }

    private StatisticsManager? _rankStats;
    private bool _rankStatsLoaded;
    private int _rankStars = -1; // -1 = 尚未加载
    private bool _rankLoading;
    private GameModeMap? _rankMap; // 星数所属地图（防止旧结果覆盖新图）

    /// <summary>后台读取统计数据库并计算当前地图星数（Task.Run 避免阻塞 UI 线程）。</summary>
    private async Task LoadRankAsync(GameModeMap gmm)
    {
        if (_rankLoading)
            return;
        _rankLoading = true;
        _rankStars = -1;
        await InvokeAsync(StateHasChanged);
        try
        {
            int stars = await Task.Run(() =>
            {
                // 懒初始化：统计数据库随游戏目录就绪后读取一次（与统计页共用单例）
                _rankStats ??= StatisticsManager.Instance;
                if (!_rankStatsLoaded)
                {
                    _rankStats.ReadStatistics(ProgramConstants.GamePath);
                    _rankStatsLoaded = true;
                }

                int rank = _rankStats.GetSkirmishRankForDefaultMap(gmm.Map.UntranslatedName, gmm.MaxPlayers);
                return Math.Clamp(rank + 1, 0, 3); // -1(未胜)→0 星 … 2(最佳)→3 星
            });
            _rankStars = stars;
        }
        catch
        {
            _rankStars = 0;
        }
        finally
        {
            _rankLoading = false;
            // 加载期间地图已切换 → 为新图重新加载
            if (Svc.SelectedMap is not null && Svc.SelectedMap != gmm)
                _ = LoadRankAsync(Svc.SelectedMap);
            else
                await InvokeAsync(StateHasChanged);
        }
    }

