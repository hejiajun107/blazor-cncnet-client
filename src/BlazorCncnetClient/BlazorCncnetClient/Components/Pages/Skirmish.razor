@page "/skirmish"
@implements IDisposable
@using CnCNetClient.Core
@using CnCNetClient.Core.Statistics
@using CnCNetClient.Domain.Multiplayer
@using SixLabors.ImageSharp.PixelFormats
@inject SkirmishService Svc
@inject MapLoader MapLoader
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IThemeProvider ThemeProvider
@inject MessageBoxService MessageBox
@inject SkirmishLaunchService GameLauncher
@inject DiscordPresenceService Discord
@inject GameContentServer ContentServer

@if (!Svc.IsActive)
{
    <div class="game-empty page-anim">
        <div class="ge-box pop-in">
            <div class="ge-title">SKIRMISH</div>
            <div class="ge-sub">遭遇战配置初始化中…</div>
            <button class="mb-btn primary" @onclick="BackToMenu">返回主菜单</button>
        </div>
    </div>
}
else
{
    <div class="groom page-anim">
        <header class="groom-top item-in">
            <div class="gt-left">
                <span class="gt-badge host">遭遇战<span class="en">SKIRMISH</span></span>
                <div class="gt-tbox">
                    <span class="gt-title">本地对战配置</span>
                    <span class="gt-en">@(Svc.LocalGame?.UIName ?? "—") · 单机 · 人类 @(1) + AI @(Svc.AIPlayers.Count)</span>
                </div>
            </div>
            <div class="gt-right">
                <span class="gt-player">@ProgramConstants.PLAYERNAME</span>
            </div>
        </header>

        <div class="groom-grid">
            <!-- 左列：地图选择（参考原版 lbMapList） -->
            <section class="gl-panel gl-maplist item-in" style="animation-delay:50ms">
                <header class="gl-ph">
                    <span>地图选择 <em>MAP LIST</em></span>
                </header>
                <div class="gl-body">
                    <!-- 游戏模式选择（原版 cmbGameMode：切换模式过滤地图列表） -->
                    <div class="map-mode">
                        <span class="mm-label">游戏模式</span>
                        <select class="gl-select" value="@_selectedMode" @onchange="OnModeChange">
                            @if (ModeOptions.Count == 0)
                            {
                                <option value="">— 加载中 —</option>
                            }
                            else
                            {
                                @foreach (var m in ModeOptions)
                                {
                                    <option value="@m">@m</option>
                                }
                            }
                        </select>
                    </div>
                    <!-- 地图列表（原版 lbMapList：当前模式的地图直接呈现为可点选列表，右键收藏等） -->
                    <div class="map-list">
                        @if (_mapOptions.Count == 0)
                        {
                            <div class="map-list-empty">@(ModeOptions.Count == 0 ? "— 地图加载中 —" : "— 无匹配地图 —")</div>
                        }
                        else
                        {
                            @for (int i = 0; i < _mapOptions.Count; i++)
                            {
                                var opt = _mapOptions[i];
                                var idx = i; // for 循环变量为共享变量，须拷贝为局部变量供闭包捕获，否则点击时索引恒为 Count（越界）
                                var isSel = idx == SelectedMapIndex;
                                <div class="map-list-item @(isSel ? "sel" : "") @(opt.Value.IsFavorite ? "fav" : "")"
                                     @onclick="() => SelectMap(idx)"
                                     @oncontextmenu="(e) => OnMapListItemContextMenu(idx, e)" @oncontextmenu:preventDefault="true"
                                     title="@opt.Display">
                                    <span class="ml-star">★</span>
                                    <span class="ml-name">@opt.Display</span>
                                    <span class="ml-meta">@(opt.Value.MinPlayers)–@(opt.Value.MaxPlayers)</span>
                                </div>
                            }
                        }
                    </div>

                    <!-- 地图工具条（原版 tbMapSearch / btnShowFavoriteMaps / btnMapSortAlphabetically / btnPickRandomMap） -->
                    <div class="map-tools">
                        <input class="gl-input map-search" placeholder="搜索地图…" value="@_mapSearch" @oninput="OnMapSearchInput" />
                        <button type="button" class="mt-btn @(_favOnly ? "on" : "")" title="仅显示收藏地图" @onclick="OnToggleFavOnly">
                            ★<span class="en">FAV</span>
                        </button>
                        <button type="button" class="mt-btn @(_sortMode != 0 ? "on" : "")" title="按名称排序" @onclick="OnCycleSort">
                            <span class="en">@SortModeLabel</span>
                        </button>
                        <button type="button" class="mt-btn" title="随机选择地图" @onclick="OnPickRandomMap">
                            <span class="en">RND</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- 右上·左：玩家配置（参考原版 PlayerOptionsPanel：固定 8 行槽位表格，列=阵营/颜色/队伍） -->
            <section class="gl-panel gl-players item-in" style="animation-delay:100ms">
                <header class="gl-ph">
                    <span>玩家配置 <em>@TotalPlayers/@Svc.MaxPlayers</em></span>
                    <span class="gl-ph-right">
                        <span class="gl-lock">@(Svc.IsCoop ? "合作" : "对战")</span>
                        <button type="button" class="mb-btn gl-reset" @onclick="OnResetAI">
                            重置<span class="en">RESET</span>
                        </button>
                    </span>
                </header>

                <div class="gl-body">
                    <!-- 表头行（参考原版 PLAYER/SIDE/COLOR/TEAM 标题） -->
                    <div class="gl-tr gl-tr-head">
                        <span class="gl-tc-name">玩家 <em>PLAYER</em></span>
                        <span>阵营 <em>SIDE</em></span>
                        <span>颜色 <em>COLOR</em></span>
                        <span>出生点 <em>START</em></span>
                        <span>队伍 <em>TEAM</em></span>
                    </div>

                    <!-- 人类玩家行 -->
                    <div class="gl-tr human @(ReferenceEquals(_selectedPlayer, Svc.HumanPlayer) ? "sel" : "")"
                         @onclick="() => OnPlayerRowClick(Svc.HumanPlayer)">
                        <div class="gl-tc-name">
                            <span class="slot-color" style="background:@ToCss(GetColor(HumanColorId))"></span>
                            <span class="nm">@ProgramConstants.PLAYERNAME</span>
                            <em class="slot-host">YOU</em>
                        </div>
                        <div class="gl-side">
                            <img class="side-ic" src="@SideIconUrl(HumanSideId)" alt="" onerror="this.style.display='none'" />
                            <select class="gl-select" value="@HumanSideId" @onchange="OnHumanSideChange">
                                @for (int s = 0; s < Sides.Length; s++)
                                {
                                    <option value="@s">@Sides[s]</option>
                                }
                                <option value="@Sides.Length">Spectator</option>
                            </select>
                        </div>
                        <select class="gl-select color-select" value="@HumanColorId" @onchange="OnHumanColorChange">
                            @for (int c = 0; c < _colors.Count; c++)
                            {
                                <option value="@_colors[c].Index" style="background:@ToCss(_colors[c].Color);color:@GetContrastColor(_colors[c].Color)">@_colors[c].Name</option>
                            }
                        </select>
                        <select class="gl-select gl-start" disabled="@(Svc.ForceRandomStarts || Svc.IsHumanSpectator)" value="@HumanStartLocation" @onchange="OnHumanStartChange">
                            <option value="0">随机</option>
                            @foreach (var st in StartLocationOptions)
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                        <select class="gl-select" value="@HumanTeamId" disabled="@(!Svc.TeamsEnabled || Svc.UseTeamStartMappings)" @onchange="OnHumanTeamChange">
                            <option value="0">-</option>
                            @for (int t = 0; t < TeamNames.Count; t++)
                            {
                                <option value="@(t + 1)">@TeamNames[t]</option>
                            }
                        </select>
                    </div>

                    <!-- AI 槽位（固定 7 行：占用行显示配置，空槽下拉直接选难度添加，同原版 ddPlayerName） -->
                    @for (int i = 0; i < SkirmishService.MaxAIPlayersConst; i++)
                    {
                        var slotIndex = i; // for 循环变量为共享变量，须拷贝为局部变量供闭包捕获，否则点击空槽时索引恒为 7 导致 AddAI 越界失败
                        var ai = i < Svc.AIPlayers.Count ? Svc.AIPlayers[i] : null;
                        <div class="gl-tr @(ai is null ? "empty-slot" : "") @(ai is not null && ReferenceEquals(_selectedPlayer, ai) ? "sel" : "")"
                             @onclick="() => OnPlayerRowClick(ai)">
                            <div class="gl-tc-name">
                                @if (ai is not null)
                                {
                                    <span class="slot-color" style="background:@ToCss(GetColor(ai.ColorId))"></span>
                                    <span class="nm">@ai.Name</span>
                                    <select class="gl-select ai-level" value="@ai.AILevel" @onchange="(e) => OnAILevelChange(ai, e)">
                                        <option value="0">简单</option>
                                        <option value="1">中等</option>
                                        <option value="2">困难</option>
                                    </select>
                                    <button class="ai-remove" title="移除" @onclick="() => OnRemoveAI(ai)" @onclick:stopPropagation="true">✕</button>
                                }
                                else
                                {
                                    <select class="gl-select ai-add-sel" value="0" @onchange="(e) => OnEmptySlotAdd(slotIndex, e)">
                                        <option value="0">— 空位 —</option>
                                        <option value="1">简单 AI</option>
                                        <option value="2">中等 AI</option>
                                        <option value="3">困难 AI</option>
                                    </select>
                                }
                            </div>
                            <div class="gl-side">
                                @if (ai is not null)
                                {
                                    <img class="side-ic" src="@SideIconUrl(ai.SideId)" alt="" onerror="this.style.display='none'" />
                                }
                                <select class="gl-select" disabled="@(ai is null)" value="@(ai?.SideId ?? 0)" @onchange="(e) => { if (ai is not null) OnAISideChange(ai, e); }">
                                    @for (int s = 0; s < Sides.Length; s++)
                                    {
                                        <option value="@s">@Sides[s]</option>
                                    }
                                </select>
                            </div>
                            <select class="gl-select color-select" disabled="@(ai is null)" value="@(ai?.ColorId ?? 0)" @onchange="(e) => { if (ai is not null) OnAIColorChange(ai, e); }">
                                @for (int c = 0; c < _colors.Count; c++)
                                {
                                    <option value="@_colors[c].Index" style="background:@ToCss(_colors[c].Color);color:@GetContrastColor(_colors[c].Color)">@_colors[c].Name</option>
                                }
                            </select>
                            <select class="gl-select gl-start" disabled="@(ai is null || Svc.ForceRandomStarts)" value="@(ai?.StartingLocation ?? 0)" @onchange="(e) => { if (ai is not null) OnAIStartChange(ai, e); }">
                                <option value="0">随机</option>
                                @foreach (var st in StartLocationOptions)
                                {
                                    <option value="@st">@st</option>
                                }
                            </select>
                            <select class="gl-select" disabled="@(ai is null || !Svc.TeamsEnabled || Svc.UseTeamStartMappings)" value="@(ai?.TeamId ?? 0)" @onchange="(e) => { if (ai is not null) OnAITeamChange(ai, e); }">
                                <option value="0">-</option>
                                @for (int t = 0; t < TeamNames.Count; t++)
                                {
                                    <option value="@(t + 1)">@TeamNames[t]</option>
                                }
                            </select>
                        </div>
                    }

                    <!-- 自动结盟出生点映射（启用时显示，随表体滚动） -->
                    @if (Svc.UseTeamStartMappings)
                    {
                        <div class="ally-grid">
                            @for (int st = 1; st <= Svc.MaxPlayers; st++)
                            {
                                var slot = st; // for 循环变量为共享变量，须拷贝为局部变量供闭包捕获，否则 onchange 时索引恒为 MaxPlayers+1
                                var teamValue = GetMappingTeam(slot);
                                <div class="ally-cell">
                                    <span class="ally-idx">@slot</span>
                                    <select class="gl-select ally-sel" value="@teamValue"
                                            disabled="@(!Svc.AllowedTeamStartMappingLocations.Contains(slot))"
                                            @onchange="(e) => OnMappingChange(slot, e)">
                                        @foreach (var opt in MappingTeamOptions)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- 自动结盟开关 + 预设（固定条） -->
                <div class="gl-ally">
                    <div class="ally-head">
                        <label class="gl-check">
                            <input type="checkbox" checked="@Svc.UseTeamStartMappings"
                                   disabled="@(!Svc.TeamStartMappingsAllowed)"
                                   @onchange="OnToggleAutoAlly" />
                            <span>自动结盟<span class="en">AUTO ALLY</span></span>
                        </label>
                        <select class="gl-select ally-preset" value="0"
                                disabled="@(!Svc.UseTeamStartMappings || Svc.TeamStartMappingPresets.Count == 0)"
                                @onchange="OnAutoAllyPresetChange">
                            <option value="0">自定义</option>
                            @for (int p = 0; p < Svc.TeamStartMappingPresets.Count; p++)
                            {
                                <option value="@(p + 1)">@Svc.TeamStartMappingPresets[p].Name</option>
                            }
                        </select>
                    </div>
                </div>
            </section>

            <!-- 右上·右：游戏选项（参考原版 GameOptionsPanel + 预设 LoadOrSaveGameOptionPresetWindow） -->
            <section class="gl-panel gl-options item-in" style="animation-delay:150ms">
                <header class="gl-ph">
                    <span>游戏选项 <em>GAME OPTIONS</em></span>
                    <button type="button" class="mb-btn go-preset-btn" @onclick="OpenPresetDialog">
                        预设<span class="en">PRESET</span>
                    </button>
                </header>
                <div class="gl-body">
                    <div class="go-grid">
                        @foreach (var opt in CheckBoxOptions)
                        {
                            <label class="gl-check go-check" title="@opt.ToolTip" data-option="@opt.Name">
                                <input type="checkbox" checked="@opt.Checked"
                                       @onchange="(e) => OnCheckBoxOptionChange(opt, e)" />
                                <span>@opt.DisplayName</span>
                            </label>
                        }
                    </div>
                    @foreach (var dd in DropDownOptions)
                    {
                        <div class="go-dd" title="@dd.ToolTip" data-option="@dd.Name">
                            <label>@dd.DisplayName</label>
                            <select class="gl-select" value="@dd.SelectedIndex" @onchange="(e) => OnDropDownOptionChange(dd, e)">
                                @for (int i = 0; i < dd.Items.Count; i++)
                                {
                                    <option value="@i">@dd.Items[i]</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </section>

            <!-- 右下：地图预览（参考原版 MapPreviewBox，固定宽高比 + 下方出生点文字信息） -->
            <section class="gl-panel gl-preview item-in" style="animation-delay:200ms">
                <header class="gl-ph">
                    <span>地图预览 <em>MAP PREVIEW</em></span>
                    <span class="gl-mapname">@(Svc.SelectedMap?.Map.Name ?? "未选择地图")</span>
                </header>
                <div class="gl-body">
                    <div class="map-preview-wrap">
                        <div class="cfg-map-preview">
                            <MapThumbnail MapHash="@Svc.SelectedMap?.Map.SHA1" MapName="@Svc.SelectedMap?.Map.UntranslatedName" CssClass="cfg-thumb" />
                            @if (Svc.SelectedMap is null)
                            {
                                <div class="cfg-map-none">请选择地图</div>
                            }
                            else
                            {
                                <div class="spawn-layer">
                                    @foreach (var sp in SpawnPoints)
                                    {
                                        var spStyle = $"left:{sp.X * 100:0.##}%;top:{sp.Y * 100:0.##}%";
                                        var spCls = sp.IsSelf ? "self" : sp.OccupantName is null ? "free" : "taken";
                                        <button type="button"
                                                class="spawn-dot @spCls"
                                                style="@spStyle"
                                                title="@(sp.OccupantName is null ? $"出生点 {sp.Index}" : $"出生点 {sp.Index} · {sp.OccupantName}")"
                                                @onclick="() => OnSpawnClick(sp.Index)">
                                            <span class="spawn-num">@sp.Index</span>
                                            @if (sp.OccupantName is not null)
                                            {
                                                <span class="spawn-owner"></span>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 出生点位置文字信息（参考原版地图下方位置列表） -->
                    @if (Svc.SelectedMap is not null)
                    {
                        <div class="map-pos-list">
                            @foreach (var sp in SpawnPoints)
                            {
                                var spCoord = $"({sp.X * 100:0.##}%, {sp.Y * 100:0.##}%)";
                                <div class="pos-item" title="出生点 @sp.Index · @spCoord">
                                    <span class="pos-idx">@sp.Index</span>
                                    @if (sp.OccupantName is not null)
                                    {
                                        <span class="pos-swatch" style="background:@ToCss(GetColor(sp.ColorIndex))"></span>
                                    }
                                    <span class="pos-owner @(sp.OccupantName is null ? "free" : "")">@(sp.OccupantName ?? "空位")</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- 地图信息（紧凑条：原 map-info 从左侧列表区移入预览面板下方，横向排布） -->
                @if (Svc.SelectedMap is not null)
                {
                    <div class="map-info compact">
                        <div class="mi-row"><span>地图</span><b>@Svc.SelectedMap.Map.Name</b></div>
                        <div class="mi-row"><span>作者</span><b>@Svc.SelectedMap.Map.Author</b></div>
                        <div class="mi-row"><span>尺寸</span><b>@Svc.SelectedMap.Map.GetSizeString()</b></div>
                        <div class="mi-row"><span>模式</span><b>@Svc.SelectedMap.GameMode.UIName</b></div>
                        <div class="mi-row"><span>人数</span><b>@(Svc.SelectedMap.MinPlayers)–@(Svc.SelectedMap.MaxPlayers)</b></div>
                        <div class="mi-row"><span>排名</span><b class="mi-rank">@RankStars</b></div>
                        <div class="mi-row">
                            <span>收藏</span>
                            <button type="button" class="mi-star @(Svc.SelectedMap.IsFavorite ? "on" : "")" @onclick="OnToggleFavorite">
                                ★ <b>@(Svc.SelectedMap.IsFavorite ? "已收藏" : "收藏此图")</b>
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(Svc.SelectedMap.Map.Briefing))
                        {
                            <div class="mi-briefing">@Svc.SelectedMap.Map.Briefing</div>
                        }
                    </div>
                }
            </section>
        </div>

        <!-- 底部操作条（原版 btnLaunchGame/btnLeaveGame：开始游戏在地图/地区选择区下方，返回主菜单在右） -->
        <div class="groom-actions item-in" style="animation-delay:250ms">
            <button class="mb-btn primary start-btn" disabled="@(Svc.SelectedMap is null)" @onclick="OnStartGame">
                开始游戏<span class="en">START</span>
            </button>
            <button class="mb-btn" @onclick="BackToMenu">
                返回主菜单<span class="en">MAIN MENU</span>
            </button>
        </div>

        <!-- 地图右键菜单（原版 mapContextMenu：收藏/复制/删除/定位文件） -->
        @if (_mapCtxVisible && _mapCtxTarget is not null)
        {
            var m = _mapCtxTarget;
            <div class="ctx-backdrop" @onclick="CloseMapContextMenu"
                 @oncontextmenu="CloseMapContextMenu" @oncontextmenu:preventDefault="true"></div>
            <div class="ctx-menu" style="left:@(_mapCtxX)px;top:@(_mapCtxY)px">
                <div class="ctx-title">@m.Map.Name</div>
                <button class="ctx-item" @onclick="() => ToggleMapFavorite(m)">
                    <span>@(m.IsFavorite ? "取消收藏" : "收藏")</span><span class="en">@(m.IsFavorite ? "UNFAVORITE" : "FAVORITE")</span>
                </button>
                <button class="ctx-item" @onclick="() => CopyMapName(m)">
                    <span>复制地图名</span><span class="en">COPY NAME</span>
                </button>
                <button class="ctx-item" @onclick="() => CopyMapName(m, true)">
                    <span>复制原名</span><span class="en">COPY ORIGINAL</span>
                </button>
                @if (!m.Map.Official)
                {
                    <div class="ctx-sep"></div>
                    <button class="ctx-item" @onclick="() => OpenMapFolder(m)">
                        <span>显示在文件夹</span><span class="en">SHOW IN FOLDER</span>
                    </button>
                    <button class="ctx-item warn" @onclick="() => DeleteMap(m)">
                        <span>删除地图</span><span class="en">DELETE</span>
                    </button>
                }
            </div>
        }

        <!-- 游戏选项预设对话框（原版 LoadOrSaveGameOptionPresetWindow） -->
        <GameOptionPresetDialog Options="Svc.GameOptions"
                                Visible="@_presetOpen"
                                OnClose="ClosePresetDialog"
                                OnPresetApplied="OnPresetApplied" />
    </div>
}

@code {
    private List<ColorOption> _colors = new();
    private string[] _sides = Array.Empty<string>();
    private string[] Sides => _sides;

    /// <summary>当前选中玩家（点击玩家行选中；在地图上点出生点即分配给它，同原版 SelectedPlayer 交互）。
    /// null = 未选中（地图点击默认分配人类玩家）。</summary>
    private PlayerInfo? _selectedPlayer;

    private List<MapOption> _mapOptions = new();

    /// <summary>当前选择的游戏模式（原版 cmbGameMode，按 MapLoader.GameModes 的 INI 顺序）。</summary>
    private string _selectedMode = string.Empty;

    /// <summary>模式下拉选项（只列出有地图的模式）。</summary>
    private List<string> ModeOptions => MapLoader.GameModes
        .Where(gm => MapLoader.GameModeMaps.Any(gmm => gmm.GameMode.UIName == gm.UIName))
        .Select(gm => gm.UIName)
        .ToList();

    /// <summary>地图加载完成前模式为空；加载后默认选中第一个模式。</summary>
    private void EnsureSelectedMode()
    {
        if (_selectedMode.Length > 0 || ModeOptions.Count == 0)
            return;
        _selectedMode = ModeOptions[0];
    }

    private void OnModeChange(ChangeEventArgs e)
    {
        _selectedMode = e.Value?.ToString() ?? string.Empty;
        RefreshMaps();

        // 当前选中地图不属于新模式时，自动选新模式第一张图（原版 cmbGameMode 切换语义）
        if (Svc.SelectedMap is not null
            && _selectedMode.Length > 0
            && Svc.SelectedMap.GameMode.UIName != _selectedMode
            && _mapOptions.Count > 0)
        {
            try
            {
                Svc.ChangeMap(_mapOptions[0].Value);
            }
            catch (Exception ex)
            {
                _ = JS.InvokeVoidAsync("cncnet.toast", ex.Message);
            }
        }
    }

    private int TotalPlayers => 1 + Svc.AIPlayers.Count;

    /// <summary>游戏选项：复选框（G7，按原版 GameLobbyBase.ini 顺序）。</summary>
    private List<GameSessionCheckBoxOption> CheckBoxOptions =>
        Svc.GameOptions.OfType<GameSessionCheckBoxOption>().ToList();

    /// <summary>游戏选项：下拉框（G7，cmbCredits / cmbStartingUnits）。</summary>
    private List<GameSessionDropDownOption> DropDownOptions =>
        Svc.GameOptions.OfType<GameSessionDropDownOption>().ToList();

    private int HumanSideId => Svc.HumanPlayer?.SideId ?? 0;
    private int HumanColorId => Svc.HumanPlayer?.ColorId ?? 0;
    private int HumanStartLocation => Svc.HumanPlayer?.StartingLocation ?? 0;
    private int HumanTeamId => Svc.HumanTeamId;

    /// <summary>队伍下拉显示名（1..4 → A..D）。</summary>
