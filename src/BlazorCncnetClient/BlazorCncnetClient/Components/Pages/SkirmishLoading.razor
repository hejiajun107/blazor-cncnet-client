@page "/skirmish/loading"
@implements IDisposable
@using System.Threading
@using CnCNetClient.Core
@inject SkirmishService Svc
@inject NavigationManager Nav
@inject MessageBoxService MessageBox

@if (!Svc.IsActive)
{
    <div class="game-empty page-anim">
        <div class="ge-box pop-in">
            <div class="ge-title">SKIRMISH LOADING</div>
            <div class="ge-sub">当前没有正在进行的对局</div>
            <button class="mb-btn primary" @onclick="BackToSkirmish">返回遭遇战</button>
        </div>
    </div>
}
else
{
    <div class="gload page-anim">
        <div class="gload-center pop-in">
            <!-- 雷达式加载环（与在线/局域网加载页同款） -->
            <div class="gload-radar">
                <div class="radar-ring r1"></div>
                <div class="radar-ring r2"></div>
                <div class="radar-ring r3"></div>
                <div class="radar-sweep"></div>
                <div class="radar-core">
                    <span class="rc-en">SKIRMISH</span>
                    <span class="rc-cn">遭遇战</span>
                </div>
            </div>

            <div class="gload-title">SKIRMISH LOADING</div>
            <div class="gload-sub">遭遇战加载中 · 请稍候</div>

            <div class="gload-info">
                <div class="gi-row"><span>模式</span><b>@(Svc.SelectedMap?.GameMode.UIName ?? "—")</b></div>
                <div class="gi-row"><span>地图</span><b>@(Svc.SelectedMap?.Map.UntranslatedName ?? "—")</b></div>
                <div class="gi-row"><span>玩家</span><b>@TotalPlayers 人（人类 @(1) + AI @(Svc.AIPlayers.Count)）</b></div>
                <div class="gi-row"><span>GameID</span><b>#@Svc.UniqueGameId</b></div>
            </div>

            <div class="gload-status">
                <span class="gs-dot"></span>
                游戏进程已启动，窗口已最小化 · 对局结束后将自动返回遭遇战页（已运行 <b>@ElapsedSeconds</b>s）
            </div>

            <div class="gload-actions">
                <button class="mb-btn" @onclick="BackToSkirmish">返回遭遇战</button>
            </div>
        </div>
    </div>
}

@code {
    private Timer? _timer;
    private int _elapsedSeconds;

    private int ElapsedSeconds => _elapsedSeconds;

    private int TotalPlayers => 1 + Svc.AIPlayers.Count;

    protected override void OnInitialized()
    {
        // 对局进行中计时显示；每秒刷新一次
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            _elapsedSeconds++;
            StateHasChanged();
        }), null, 1000, 1000);
    }

    private async Task BackToSkirmish()
    {
        var confirm = await MessageBox.ShowAsync("返回遭遇战",
            "对局仍在进行中，返回将中断当前流程。确认继续？",
            MessageBoxButtons.YesNo, MessageBoxKind.Confirm);
        if (!confirm)
            return;
        Nav.NavigateTo("/skirmish");
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}
