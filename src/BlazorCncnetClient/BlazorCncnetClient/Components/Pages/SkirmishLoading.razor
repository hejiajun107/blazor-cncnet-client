@page "/skirmish/loading"
@implements IDisposable
@using System.Threading
@using CnCNetClient.Core
@inject SkirmishService Svc
@inject NavigationManager Nav
@inject MessageBoxService MessageBox
@inject ITranslationService TranslationSvc

@if (!Svc.IsActive)
{
    <div class="game-empty page-anim">
        <div class="ge-box pop-in">
            <div class="ge-title">SKIRMISH LOADING</div>
            <div class="ge-sub">@T("Loading.NoActiveGame", "No match in progress")</div>
            <button class="mb-btn primary" @onclick="BackToSkirmish">@T("Loading.BackToSkirmish", "Back to Skirmish")</button>
        </div>
    </div>
}
else
{
    <div class="gload page-anim">
        <div class="gload-center pop-in">
            <!-- 雷达式加载环（与在线/局域网加载页同款） -->
            <div class="gload-radar">
                <div class="radar-ring r1"></div>
                <div class="radar-ring r2"></div>
                <div class="radar-ring r3"></div>
                <div class="radar-sweep"></div>
                <div class="radar-core">
                    <span class="rc-en">SKIRMISH</span>
                    <span class="rc-cn">@T("Loading.RadarSkirmish", "Skirmish")</span>
                </div>
            </div>

            <div class="gload-title">SKIRMISH LOADING</div>
            <div class="gload-sub">@T("Loading.SubSkirmish", "Skirmish loading · Please wait")</div>

            <div class="gload-info">
                <div class="gi-row"><span>@T("Lobby.Mode", "Mode")</span><b>@(Svc.SelectedMap?.GameMode.UIName ?? "—")</b></div>
                <div class="gi-row"><span>@T("Lobby.Map", "Map")</span><b>@(Svc.SelectedMap?.Map.Name ?? "—")</b></div>
                <div class="gi-row"><span>@T("Lobby.Player", "Player")</span><b>@F("Loading.PlayersDetail", "{0} players (human {1} + AI {2})", TotalPlayers, 1, Svc.AIPlayers.Count)</b></div>
                <div class="gi-row"><span>GameID</span><b>#@Svc.UniqueGameId</b></div>
            </div>

            <div class="gload-status">
                <span class="gs-dot"></span>
                @T("Loading.ProcessStarted", "Game process started, window minimized · ")@T("Loading.ReturnSkirmish", "You will return to the Skirmish page after the match (running ")<b>@ElapsedSeconds</b>@T("Loading.SecondsSuffix", "s)")
            </div>

            <div class="gload-actions">
                <button class="mb-btn" @onclick="BackToSkirmish">@T("Loading.BackToSkirmish", "Back to Skirmish")</button>
            </div>
        </div>
    </div>
}

@code {
    private Timer? _timer;
    private int _elapsedSeconds;

    private int ElapsedSeconds => _elapsedSeconds;

    private int TotalPlayers => 1 + Svc.AIPlayers.Count;

    private static string T(string key, string fallback) => UiText.T(key, fallback);
    private static string F(string key, string fallback, params object[] args) => string.Format(UiText.T(key, fallback), args);

    protected override void OnInitialized()
    {
        // 对局进行中计时显示；每秒刷新一次
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            _elapsedSeconds++;
            StateHasChanged();
        }), null, 1000, 1000);

        TranslationSvc.LanguageChanged += OnLanguageChanged;
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task BackToSkirmish()
    {
        var confirm = await MessageBox.ShowAsync(T("Loading.BackToSkirmish", "Back to Skirmish"),
            T("Loading.LeaveSkirmishBody", "A match is still in progress. Returning will interrupt the current flow. Continue?"),
            MessageBoxButtons.YesNo, MessageBoxKind.Confirm);
        if (!confirm)
            return;
        Nav.NavigateTo("/skirmish");
    }

    public void Dispose()
    {
        TranslationSvc.LanguageChanged -= OnLanguageChanged;
        _timer?.Dispose();
        _timer = null;
    }
}
