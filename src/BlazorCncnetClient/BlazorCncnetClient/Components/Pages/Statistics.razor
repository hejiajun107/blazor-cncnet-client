@page "/stats"
@implements IDisposable
@using CnCNetClient.Core
@inject StatisticsService Svc
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IThemeProvider ThemeProvider
@inject MessageBoxService MessageBox
@inject ITranslationService TranslationSvc

<div class="groom stats page-anim">
    <header class="groom-top item-in">
        <div class="gt-left">
            <span class="gt-badge host">@T("MainMenu.stats", "Statistics")<span class="en">STATISTICS</span></span>
            <div class="gt-tbox">
                <span class="gt-title">@T("Statistics.Title", "Match statistics")</span>
                <span class="gt-en">@F("Statistics.Subtitle", "SCORE DATABASE · {0} matches", Svc.Matches.Count)</span>
            </div>
        </div>
        <div class="gt-right">
            <span class="gt-player">@ProgramConstants.PLAYERNAME</span>
            <button class="mb-btn" @onclick="BackToMenu">@T("Common.BackToMenu", "Back to main menu")</button>
        </div>
    </header>

    <!-- 选项卡（参考原版 XNAClientTabControl：Game Statistics / Total Statistics） -->
    <div class="stats-tabs item-in" role="tablist" aria-label="@T("Statistics.TabsLabel", "Statistics views")">
        <button type="button" class="stats-tab @(_tabIndex == 0 ? "on" : "")" @onclick="() => SwitchTab(0)">
            @T("Statistics.GamesTab", "Game statistics")<span class="en">GAMES</span>
        </button>
        <button type="button" class="stats-tab @(_tabIndex == 1 ? "on" : "")" @onclick="() => SwitchTab(1)">
            @T("Statistics.TotalTab", "Total statistics")<span class="en">TOTAL</span>
        </button>
    </div>

    <!-- 筛选工具栏（窗口级：两个 Tab 共用，参考原版 cmbGameClassFilter / cmbGameModeFilter / chkIncludeSpectatedGames） -->
    <div class="stats-toolbar item-in" style="animation-delay:50ms">
        <label>@T("Statistics.Class", "Class") <em class="en-tag">CLASS</em></label>
        <select class="gl-select" value="@((int)Svc.Filter)" @onchange="OnClassFilterChange">
            @for (int i = 0; i < ClassFilterLabels.Length; i++)
            {
                <option value="@i">@ClassFilterLabels[i]</option>
            }
        </select>
        <label>@T("Statistics.Mode", "Mode") <em class="en-tag">MODE</em></label>
        <select class="gl-select" value="@SelectedGameModeIndex" @onchange="OnGameModeChange">
            <option value="0">@T("Statistics.AllModes", "All modes")</option>
            @for (int i = 0; i < Svc.GameModes.Count; i++)
            {
                <option value="@(i + 1)">@Svc.GameModes[i]</option>
            }
        </select>
        <label class="gl-check" style="margin-left:8px">
            <input type="checkbox" checked="@Svc.IncludeSpectated" @onchange="OnSpectatedChange" />
            <span>@T("Statistics.IncludeSpectated", "Include spectated games")<span class="en">SPECTATED</span></span>
        </label>
    </div>

    @if (_tabIndex == 0)
    {
        <div class="stats-grid">
            <!-- 对局列表（参考原版 lbGameList：日期时间/地图/模式/FPS/时长/完成） -->
            <section class="gl-panel stats-matches item-in" style="animation-delay:100ms">
                <header class="gl-ph">
                    <span>@T("Statistics.Games", "Games") <em>GAMES</em></span>
                    <span class="gl-mapname">@F("Statistics.MatchCount", "{0} matches", Svc.Matches.Count)</span>
                </header>
                <div class="stats-tr head">
                    <span>@T("Statistics.Date", "Time")</span>
                    <span>@T("Statistics.Map", "Map")</span>
                    <span>@T("Statistics.Mode", "Mode")</span>
                    <span>FPS</span>
                    <span>@T("Statistics.Duration", "Duration")</span>
                    <span>@T("Statistics.Completed", "Completed")</span>
                </div>
                <div class="stats-tbl">
                    @if (Svc.Matches.Count == 0)
                    {
                        <div class="stats-empty">@T("Statistics.NoMatches", "No match records (dscore.dat is empty or missing)")</div>
                    }
                    else
                    {
                        @for (int i = 0; i < Svc.Matches.Count; i++)
                        {
                            var m = Svc.Matches[i];
                            var idx = i; // for 循环变量为共享变量，须拷贝为局部变量供闭包捕获，否则点击时索引恒为 Count（越界）
                            <button type="button" class="stats-tr stats-row @(idx == _selectedRow ? "on" : "")"
                                    @onclick="() => OnSelectRow(idx)">
                                <span>@m.DateText</span>
                                <span title="@m.MapName">@m.MapName</span>
                                <span>@m.GameMode</span>
                                <span>@m.Fps</span>
                                <span>@m.Duration</span>
                                <span>@m.Completed</span>
                            </button>
                        }
                    }
                </div>
            </section>

            <!-- 玩家明细（参考原版 lbGameStatistics：名称/击杀/损失/经济/得分/获胜/阵营/队伍） -->
            <section class="gl-panel stats-players item-in" style="animation-delay:150ms">
                <header class="gl-ph">
                    <span>@T("Statistics.PlayerDetails", "Player statistics") <em>PLAYER STATISTICS</em></span>
                    <span class="gl-mapname">@T("Statistics.SortedByScore", "Sorted by score")</span>
                </header>
                <div class="stats-tr p head">
                    <span>@T("Lobby.Player", "Player")</span>
                    <span>@T("Statistics.Kills", "Kills")</span>
                    <span>@T("Statistics.Losses", "Losses")</span>
                    <span>@T("Statistics.Economy", "Economy")</span>
                    <span>@T("Statistics.Score", "Score")</span>
                    <span>@T("Statistics.Won", "Won")</span>
                    <span>@T("Skirmish.Side", "Side")</span>
                    <span>@T("Skirmish.Team", "Team")</span>
                </div>
                <div class="stats-tbl">
                    @if (_selectedRow < 0)
                    {
                        <div class="stats-empty">@T("Statistics.SelectMatchHint", "Select a match from the list above to view player data")</div>
                    }
                    else
                    {
                        @foreach (var p in Svc.Players)
                        {
                            <div class="stats-tr p @(p.IsLocal ? "sp-local" : "")">
                                <span class="sp-name">
                                    <i class="sp-dot" style="background:@p.Color"></i>
                                    <span class="nm">@p.Name</span>
                                </span>
                                <span>@p.Kills</span>
                                <span>@p.Losses</span>
                                <span>@p.Economy</span>
                                <span>@p.Score</span>
                                <span>@p.Won</span>
                                <span>@p.Side</span>
                                <span>@p.Team</span>
                            </div>
                        }
                    }
                </div>
            </section>
        </div>
    }
    else
    {
        <!-- 总统计（参考原版 SetTotalStatistics：两列 18 项数值） -->
        <div class="stats-total item-in" style="animation-delay:100ms">
            <div class="st-col">
                @foreach (var (label, value) in TotalCol1)
                {
                    <div class="st-item"><span>@label</span><b>@value</b></div>
                }
            </div>
            <div class="st-col">
                @foreach (var (label, value) in TotalCol2)
                {
                    <div class="st-item"><span>@label</span><b>@value</b></div>
                }
            </div>
        </div>
    }

    <!-- 底部操作（参考原版 btnClearStatistics / btnReturnToMenu） -->
    <div class="stats-actions item-in" style="animation-delay:200ms">
        <button class="mb-btn danger" @onclick="OnClearStatistics">@T("Statistics.ClearAll", "Clear statistics")<span class="en">CLEAR ALL</span></button>
        <button class="mb-btn primary" @onclick="BackToMenu">@T("Common.BackToMenu", "Back to main menu")<span class="en">MAIN MENU</span></button>
    </div>
</div>

@code {
    /// <summary>UI 文案查表（键省略 <c>Client:UI:</c> 前缀，缺失回退英文默认值）。</summary>
    private static string T(string key, string fallback) => UiText.T(key, fallback);

    /// <summary>带参数的文案（占位符 {0}…）。</summary>
    private static string F(string key, string fallback, params object[] args)
        => string.Format(UiText.T(key, fallback), args);

    /// <summary>类别筛选下拉文案（计算属性：语言切换后随重渲染刷新）。</summary>
    private static string[] ClassFilterLabels =>
    [
        T("Statistics.Filter.All", "All games"),
        T("Statistics.Filter.Online", "Online games"),
        T("Statistics.Filter.OnlinePvp", "Online PvP"),
        T("Statistics.Filter.OnlineCoop", "Online Co-op"),
        T("Statistics.Filter.Skirmish", "Skirmish"),
    ];

    private int _tabIndex;
    private int _selectedRow = -1;

    /// <summary>模式下拉当前索引：0 = 全部（null），其后依次对应 Svc.GameModes。</summary>
    private int SelectedGameModeIndex
    {
        get
        {
            if (Svc.SelectedGameMode is null)
                return 0;
            int idx = Svc.GameModes.IndexOf(Svc.SelectedGameMode);
            return idx < 0 ? 0 : idx + 1;
        }
    }

    private IEnumerable<(string Label, string Value)> TotalCol1 => new (string, string)[]
    {
        (T("Statistics.Total.GamesStarted", "Games started"), Svc.Total.GamesStarted.ToString()),
        (T("Statistics.Total.GamesFinished", "Games finished"), Svc.Total.GamesFinished.ToString()),
        (T("Statistics.Total.Wins", "Wins"), Svc.Total.Wins.ToString()),
        (T("Statistics.Total.Losses", "Losses"), Svc.Total.Losses.ToString()),
        (T("Statistics.Total.WinLossRatio", "Win / loss ratio"), Svc.Total.WinLossRatio),
        (T("Statistics.Total.AverageGameLength", "Average match length"), Svc.Total.AverageGameLength),
        (T("Statistics.Total.TotalTimePlayed", "Total time played"), Svc.Total.TotalTimePlayed),
        (T("Statistics.Total.AverageEnemyCount", "Average enemy count"), Svc.Total.AverageEnemyCount),
        (T("Statistics.Total.AverageAllyCount", "Average ally count"), Svc.Total.AverageAllyCount),
    };

    private IEnumerable<(string Label, string Value)> TotalCol2 => new (string, string)[]
    {
        (T("Statistics.Total.TotalKills", "Total kills"), Svc.Total.TotalKills),
        (T("Statistics.Total.KillsPerGame", "Kills per game"), Svc.Total.KillsPerGame),
        (T("Statistics.Total.TotalLosses", "Total losses"), Svc.Total.TotalLosses),
        (T("Statistics.Total.LossesPerGame", "Losses per game"), Svc.Total.LossesPerGame),
        (T("Statistics.Total.KillLossRatio", "Kill / loss ratio"), Svc.Total.KillLossRatio),
        (T("Statistics.Total.TotalScore", "Total score"), Svc.Total.TotalScore),
        (T("Statistics.Total.AverageEconomy", "Average economy"), Svc.Total.AverageEconomy),
        (T("Statistics.Total.FavouriteSide", "Favourite side"), Svc.Total.FavouriteSide),
        (T("Statistics.Total.AverageAILevel", "Average AI difficulty"), Svc.Total.AverageAILevel),
    };

    protected override void OnInitialized()
    {
        if (!Svc.IsLoaded)
            Svc.Load();
        ThemeProvider.ThemeChanged += OnThemeChanged;
        TranslationSvc.LanguageChanged += OnLanguageChanged;
    }

    private void OnThemeChanged(ThemeInfo theme) => InvokeAsync(StateHasChanged);

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    private void SwitchTab(int tab)
    {
        if (_tabIndex == tab)
            return;
        _tabIndex = tab;
    }

    private void OnClassFilterChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int v) || v < 0 || v > (int)GameClassFilter.Skirmish)
            return;
        Svc.Filter = (GameClassFilter)v;
        RefreshList();
    }

    private void OnGameModeChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int v) || v < 0 || v > Svc.GameModes.Count)
            return;
        Svc.SelectedGameMode = v == 0 ? null : Svc.GameModes[v - 1];
        RefreshList();
    }

    private void OnSpectatedChange(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool v))
        {
            Svc.IncludeSpectated = v;
            RefreshList();
        }
    }

    private void OnSelectRow(int rowIndex)
    {
        if (rowIndex < 0 || rowIndex >= Svc.Matches.Count)
            return;
        _selectedRow = rowIndex;
        Svc.SelectMatch(Svc.Matches[rowIndex].Index);
    }

    /// <summary>筛选条件变化：重建对局列表并清除选中/明细（原版 ListGames 语义）。</summary>
    private void RefreshList()
    {
        _selectedRow = -1;
        Svc.Refresh();
    }

    private async Task OnClearStatistics()
    {
        var confirm = await MessageBox.ShowAsync(
            T("Statistics.ClearAll", "Clear statistics"),
            T("Statistics.ClearConfirm", "This will delete all statistics from the database. This action cannot be undone.\n\nContinue?"),
            MessageBoxButtons.YesNo, MessageBoxKind.Warn);
        if (!confirm)
            return;
        Svc.ClearAll();
        _selectedRow = -1;
        await JS.InvokeVoidAsync("cncnet.toast", T("Statistics.Cleared", "Statistics cleared"));
    }

    private void BackToMenu() => Nav.NavigateTo("/menu");

    public void Dispose()
    {
        ThemeProvider.ThemeChanged -= OnThemeChanged;
        TranslationSvc.LanguageChanged -= OnLanguageChanged;
    }
}
