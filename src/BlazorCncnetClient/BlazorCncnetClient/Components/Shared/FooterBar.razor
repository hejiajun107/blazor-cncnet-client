@inject ConnectionMonitor Mon
@implements IDisposable

<!-- 底栏（全局；SYSTEM STATUS 反映连接状态，M3.10）——F2 可替换槽位 layout.footer 默认实现 -->
<footer class="foot">
    <div>SYSTEM STATUS: <b class="foot-status @Mon.StatusClass">@Mon.StateText</b> <span>· 渲染引擎 ACTIVE</span></div>
    <div class="r"><span>分辨率自适应</span><span>60 FPS</span><span>WEBGL OK</span></div>
</footer>

@code {
    protected override void OnInitialized()
    {
        // 顶栏/底栏独立订阅连接状态，避免进入页面后停留在旧状态文本
        Mon.StateChanged += OnMonStateChanged;
    }

    private void OnMonStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Mon.StateChanged -= OnMonStateChanged;
}
