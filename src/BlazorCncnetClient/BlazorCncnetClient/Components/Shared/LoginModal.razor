@namespace BlazorCncnetClient.Components.Shared
@implements IDisposable
@using CnCNetClient.Core
@using CnCNetClient.Domain.Multiplayer.CnCNet
@using CnCNetClient.Online
@inject LoginService Service
@inject SettingsService Settings
@inject IJSRuntime JS
@inject IServiceProvider Services
@inject ITranslationService TranslationSvc

@if (Service.IsOpen || Service.IsClosing)
{
    <div class="msgbox-overlay login-overlay @(Service.IsClosing ? "closing" : "")" @onclick="OnOverlayClick">
        <div class="msgbox login @(Service.IsClosing ? "pop-out" : "pop-in")" role="dialog" aria-modal="true"
             aria-label="@T("Login.Title", "Connect to CnCNet")" @onclick:stopPropagation="true">
            <div class="mb-head kind-info">
                <span class="mb-ic">⬡</span>
                <span class="mb-title">@T("Login.Title", "Connect to CnCNet")</span>
                <span class="mb-en">CONNECT TO CNCNET</span>
            </div>
            <div class="lg-body">
                <label class="lg-field" for="lg-name">
                    <span class="lg-k">@T("Login.PlayerName", "Player name") <em>PLAYER NAME</em></span>
                    <input id="lg-name" class="lg-input @(Service.Error is not null ? "err" : "")"
                           maxlength="30" spellcheck="false" autocomplete="off"
                           value="@Service.PlayerName" disabled="@Service.IsConnecting"
                           placeholder="@T("Login.NamePlaceholder", "Nickname (letters/digits/-_, must not start with a digit)")"
                           @oninput="OnNameInput" @onkeydown="OnNameKeyDown" />
                </label>

                <label class="lg-check">
                    <input type="checkbox" checked="@Service.RememberMe" disabled="@Service.IsConnecting"
                           @onchange="e => SetPref(x => x.RememberMe = e.Value is bool b && b)" />
                    <span class="c"><span class="cn">@T("Login.RememberMe", "Remember me")</span><em>@T("Login.RememberMeHint", "REMEMBER ME · Skip this screen next time")</em></span>
                </label>
                <label class="lg-check">
                    <input type="checkbox" checked="@Service.PersistentMode" disabled="@Service.IsConnecting"
                           @onchange="e => SetPref(x => x.PersistentMode = e.Value is bool b && b)" />
                    <span class="c"><span class="cn">@T("Login.PersistentMode", "Stay connected when leaving the lobby")</span><em>STAY CONNECTED</em></span>
                </label>
                <label class="lg-check">
                    <input type="checkbox" checked="@Service.AutoConnect"
                           disabled="@(Service.IsConnecting || !(Service.RememberMe && Service.PersistentMode))"
                           @onchange="e => SetPref(x => x.AutoConnect = e.Value is bool b && b)" />
                    <span class="c"><span class="cn">@T("Login.AutoConnect", "Connect automatically on startup")</span><em>AUTO CONNECT</em></span>
                </label>

                @if (!string.IsNullOrEmpty(Service.Error))
                {
                    <div class="lg-err shake">@Service.Error</div>
                }
            </div>
            <div class="mb-actions">
                <button class="mb-btn item-in" @onclick="OnCancel" disabled="@Service.IsConnecting">@T("Common.Cancel", "Cancel")</button>
                <button class="mb-btn primary item-in" @onclick="OnConnect" disabled="@Service.IsConnecting">
                    @(Service.IsConnecting ? T("Login.Connecting", "Connecting…") : T("Login.Connect", "Connect"))
                </button>
            </div>
        </div>
    </div>
}

@code {
    private CnCNetManager? _manager;
    private bool _wired;

    private static string T(string key, string fallback) => UiText.T(key, fallback);

    protected override void OnInitialized()
    {
        Service.Changed += OnChanged;
        TranslationSvc.LanguageChanged += OnLanguageChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    /* ── 输入 ── */
    private void OnNameInput(ChangeEventArgs e) => Service.PlayerName = e.Value?.ToString() ?? string.Empty;

    private void OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _ = OnConnect();
    }

    private void SetPref(Action<LoginService> mutate)
    {
        if (Service.IsConnecting)
            return;
        mutate(Service);
        // 启动自动连接依赖「记住我 + 持久连接」同勾选（与原版 CnCNetLoginWindow 一致）
        if (!Service.RememberMe || !Service.PersistentMode)
            Service.AutoConnect = false;
        Service.NotifyChanged();
    }

    /* ── 连接（spec §5.3.1：校验 → PLAYERNAME → CnCNetManager.Connect） ── */
    private async Task OnConnect()
    {
        if (Service.IsConnecting || Service.IsClosing)
            return;

        var error = NameValidator.IsNameValid(Service.PlayerName, out var msg);
        if (error != NameValidationError.None)
        {
            Service.Error = msg ?? T("Login.NameInvalid", "Invalid nickname.");
            Service.NotifyChanged();
            return;
        }

        // 昵称即身份（CnCNet 无密码认证）：写入进程级 PLAYERNAME 后发起 IRC 连接。
        ProgramConstants.PLAYERNAME = Service.PlayerName.Trim();
        PersistPrefs();
        EnsureManager();

        Service.Error = null;
        Service.IsConnecting = true;
        Service.NotifyChanged();

        try
        {
            _manager!.Connect();
        }
        catch (Exception ex)
        {
            // 连接初始化异常不得让浮窗无限停留在「连接中」：复位并展示原因。
            Service.IsConnecting = false;
            Service.Error = T("Login.InitFailed", "Connection initialization failed: ") + ex.Message;
            Service.NotifyChanged();
        }
    }

    /// <summary>
    /// 懒解析 CnCNetManager：其构造依赖 ClientConfiguration（环境检测后才就绪），
    /// 首次发起登录时才实例化（Program.cs 以工厂注册，Random 显式提供）。
    /// </summary>
    private void EnsureManager()
    {
        if (_wired)
            return;
        _wired = true;
        _manager = (CnCNetManager)Services.GetService(typeof(CnCNetManager))!;
        // Connected / ConnectAttemptFailed 经 IDispatcher 回调至 UI 线程，可直接操作。
        _manager.Connected += OnConnected;
        _manager.ConnectAttemptFailed += OnConnectAttemptFailed;
    }

    private void OnConnected(object? sender, EventArgs e)
    {
        if (!Service.IsOpen || Service.IsClosing)
            return;
        Service.IsConnecting = false;
        Service.Error = null;
        _ = JS.InvokeVoidAsync("cncnet.toast", T("Login.Connected", "Connected to CnCNet: ") + ProgramConstants.PLAYERNAME);
        _ = CloseAsync(LoginResult.Connected);
    }

    private void OnConnectAttemptFailed(object? sender, EventArgs e)
    {
        if (!Service.IsOpen)
            return;
        Service.IsConnecting = false;
        Service.Error = T("Login.ServerUnreachable", "Unable to connect to the CnCNet server. Check your network and try again.");
        Service.NotifyChanged();
    }

    /* ── 关闭（复用 MessageBox 的 fade-out 120ms 流程） ── */
    private async Task OnCancel()
    {
        if (Service.IsConnecting || Service.IsClosing)
            return;
        await CloseAsync(LoginResult.Cancelled);
    }

    private async Task OnOverlayClick()
    {
        if (Service.IsConnecting || Service.IsClosing)
            return;
        await CloseAsync(LoginResult.Cancelled);
    }

    private async Task CloseAsync(LoginResult result)
    {
        if (!Service.IsOpen || Service.IsClosing)
            return;
        Service.Resolve(result);            // 进入 fade-out 120ms
        await Task.Delay(120);
        Service.CompleteClose();
        StateHasChanged();
    }

    /* ── M4 4.1.1 持久化（spec §6.10）：登录偏好写 settings INI，变更即存 ── */
    private void PersistPrefs()
    {
        Settings.SetAndSave(ini =>
        {
            ini.PlayerName.Value = Service.PlayerName.Trim();
            ini.SkipConnectDialog.Value = Service.RememberMe;
            ini.PersistentMode.Value = Service.PersistentMode;
            ini.AutomaticCnCNetLogin.Value = Service.AutoConnect;
        });
    }

    public void Dispose()
    {
        Service.Changed -= OnChanged;
        TranslationSvc.LanguageChanged -= OnLanguageChanged;
        if (_wired && _manager is not null)
        {
            _manager.Connected -= OnConnected;
            _manager.ConnectAttemptFailed -= OnConnectAttemptFailed;
        }
    }
}
