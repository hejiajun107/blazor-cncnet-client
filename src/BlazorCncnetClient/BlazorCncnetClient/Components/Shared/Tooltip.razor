@namespace BlazorCncnetClient.Components.Shared

<span class="tip-wrap @Position" tabindex="0">
    @ChildContent
    @if (!string.IsNullOrEmpty(Text))
    {
        <span class="tip" role="tooltip">@Text</span>
    }
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>提示文案（为空则不渲染浮层）。</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>浮层方位：top / bottom / left / right（默认 top，HUD 顶栏场景用 bottom）。</summary>
    [Parameter] public string Position { get; set; } = "top";
}
